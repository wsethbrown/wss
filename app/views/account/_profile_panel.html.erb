<%# Account tab panel: profile. %>
<div id="profile-content" class="tab-content">
  <div class="space-y-6">
    <div>
      <h2 class="font-display text-2xl font-semibold text-ink">Profile</h2>
      <p class="mt-1 text-mute">Manage your public profile and whiskey preferences</p>
    </div>

    <!-- Profile Photo Section -->
    <div class="card p-6">
      <h3 class="mb-4 text-xl font-semibold text-ink">Profile Photo</h3>
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
        <%= avatar current_user, size: 96 %>

        <div class="flex flex-wrap gap-3">
          <%= form_with url: account_avatar_path, method: :patch, multipart: true, class: "inline-block" do |f| %>
            <%= f.file_field :profile_image, accept: "image/*", class: "hidden", id: "profile-image-upload", onchange: "this.form.submit();" %>
            <label for="profile-image-upload" class="btn btn-secondary min-h-11 cursor-pointer">
              Upload Photo
            </label>
          <% end %>

          <% if current_user.profile_image.attached? %>
            <%= button_to "Remove", account_remove_avatar_path, method: :delete, class: "btn btn-secondary min-h-11 cursor-pointer" %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Basic Info Section -->
    <div class="card p-6">
      <h3 class="mb-4 text-xl font-semibold text-ink">Basic Information</h3>
      <%= form_with model: current_user, url: account_profile_path, method: :patch, class: "space-y-4", id: "profile-form" do |f| %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <%= f.label :first_name, class: "mb-1.5 block text-sm font-medium text-ink" %>
            <%= f.text_field :first_name, class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 focus:outline-none focus:ring-2 focus:ring-ink/30" %>
          </div>
          <div>
            <%= f.label :last_name, class: "mb-1.5 block text-sm font-medium text-ink" %>
            <%= f.text_field :last_name, class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 focus:outline-none focus:ring-2 focus:ring-ink/30" %>
          </div>
        </div>

        <div>
          <%= f.label :bio, "About Me", class: "mb-1.5 block text-sm font-medium text-ink" %>
          <%= f.text_area :bio, rows: 4, class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 focus:outline-none focus:ring-2 focus:ring-ink/30", placeholder: "Tell others about your whiskey journey..." %>
        </div>

        <div class="flex items-start gap-3">
          <%= f.check_box :event_emails, class: "mt-1 h-4 w-4 rounded border-hairline text-ink focus:ring-ink/30" %>
          <%= f.label :event_emails, "Email me about society events (new events, changes, reminders)", class: "text-sm text-gray-900" %>
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
          <%= f.submit "Save Profile", class: "btn btn-primary min-h-11 cursor-pointer" %>
          <%= link_to "See my Profile", profile_path(current_user), class: "btn btn-secondary min-h-11", target: "_blank" %>
        </div>
      <% end %>
    </div>

    <%= render "account/shelf_editor" %>
  </div>
</div>
