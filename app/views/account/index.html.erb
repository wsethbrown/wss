<% content_for :title, "Account - Whiskey Share Society" %>

<%= render "shared/page_header", title: "Account" %>

<div class="grid gap-6 md:grid-cols-[14rem_minmax(0,1fr)] md:gap-10" data-controller="account-tabs">
  <!-- Section navigation: a row of chips on phones, a left column from md up -->
  <nav aria-label="Account sections" class="flex flex-wrap gap-2 md:sticky md:top-24 md:h-fit md:flex-col">
            <a href="#profile" class="inline-flex min-h-11 items-center gap-2.5 rounded-xl border border-ink bg-ink px-3.5 text-sm font-medium text-white md:w-full group" data-tab="profile">
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              Profile
            </a>
            <a href="#account-details" class="inline-flex min-h-11 items-center gap-2.5 rounded-xl border border-hairline bg-white px-3.5 text-sm font-medium text-ink transition hover:border-whiskey-300 md:w-full group" data-tab="account-details">
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Account details
            </a>
            <a href="#presentations" class="inline-flex min-h-11 items-center gap-2.5 rounded-xl border border-hairline bg-white px-3.5 text-sm font-medium text-ink transition hover:border-whiskey-300 md:w-full group" data-tab="presentations">
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              My presentations
            </a>
            <a href="#societies" class="inline-flex min-h-11 items-center gap-2.5 rounded-xl border border-hairline bg-white px-3.5 text-sm font-medium text-ink transition hover:border-whiskey-300 md:w-full group" data-tab="societies">
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-3-3.87M9 20H4v-2a3 3 0 013-3.87m6 0A4 4 0 005 16m6-4a4 4 0 100-8 4 4 0 000 8zm6 4a3 3 0 00-3-3.87"></path>
              </svg>
              My societies
            </a>
            <a href="#followed" class="inline-flex min-h-11 items-center gap-2.5 rounded-xl border border-hairline bg-white px-3.5 text-sm font-medium text-ink transition hover:border-whiskey-300 md:w-full group" data-tab="followed">
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
              </svg>
              Followed
            </a>
            <a href="#subscription" class="inline-flex min-h-11 items-center gap-2.5 rounded-xl border border-hairline bg-white px-3.5 text-sm font-medium text-ink transition hover:border-whiskey-300 md:w-full group" data-tab="subscription">
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
              Subscription
            </a>
            <a href="#billing" class="inline-flex min-h-11 items-center gap-2.5 rounded-xl border border-hairline bg-white px-3.5 text-sm font-medium text-ink transition hover:border-whiskey-300 md:w-full group" data-tab="billing">
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
              </svg>
              Billing
            </a>
  </nav>

  <!-- Main content area -->
  <div class="min-w-0">
    <%= render 'account/profile_panel' %>
    <%= render 'account/account_details_panel' %>
    <%= render 'account/societies_panel' %>
    <%= render 'account/followed_panel' %>
    <%= render 'account/presentations_panel' %>
    <%= render 'account/billing_panel' %>
    <%= render 'account/subscription_panel' %>
  </div>
</div>
