<%# My decks, same cards as the library, with access-state notes. %>
<div id="presentations-content" class="tab-content hidden">
  <div class="space-y-6">
    <div>
      <h2 class="font-display text-2xl font-semibold text-ink">My Presentations</h2>
      <p class="mt-1 text-mute">Every deck in your library</p>
    </div>

    <% my_purchases = current_user.user_presentations.includes(presentation: :author).order(purchased_at: :desc) %>
    <% if my_purchases.any? %>
      <div class="grid gap-6 sm:grid-cols-2">
        <% my_purchases.each do |purchase| %>
          <% deck = purchase.presentation %>
          <% next unless deck %>
          <div>
            <%= render 'presentations/deck_card', deck: deck, owned: true %>
            <p class="mt-2 px-1 text-sm text-mute">
              <% if purchase.purchase_type == 'direct' %>
                Bought outright, yours for good
              <% elsif current_user.subscription_active? %>
                Unlocked with a credit · active with your membership
              <% else %>
                <span class="font-semibold text-ink">Membership paused, <%= link_to 'reactivate to read', root_path(anchor: 'pricing'), class: 'underline' %></span>
              <% end %>
            </p>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card p-8">
        <p class="text-xl font-semibold text-ink">No decks yet.</p>
        <p class="mt-1 text-mute">Your library starts with your first deck, browse the collection.</p>
        <%= link_to 'Browse the decks', presentations_path, class: 'btn btn-primary mt-5 min-h-11' %>
      </div>
    <% end %>
  </div>
</div>
