<%# Account tab panel: followed. The one place to manage
    favorites: unfollow in place, or click through to the society/profile.
    Favorites are private to the owner; society rows re-check visibility so a
    society you can no longer see drops out rather than leaking its name. %>
<div id="followed-content" class="tab-content hidden">
  <div class="space-y-6">
    <div>
      <h2 class="font-display text-2xl font-semibold text-ink">Followed</h2>
      <p class="mt-1 text-mute">Societies and tasters whose pours land in your circle</p>
    </div>

    <% favorites = current_user.favorites.includes(:favoritable).order(created_at: :desc) %>
    <% visible = favorites.select { |f| !f.favoritable.is_a?(Society) || Pundit.policy(current_user, f.favoritable).show? } %>
    <% if visible.any? %>
      <div class="card divide-y divide-hairline">
        <% visible.each do |favorite| %>
          <%= turbo_frame_tag dom_id(favorite) do %>
            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <% if favorite.favoritable.is_a?(Society) %>
                <%= link_to society_path(favorite.favoritable), class: "min-w-0 flex-1", data: { turbo_frame: "_top" } do %>
                  <p class="truncate font-semibold text-ink"><%= favorite.favoritable.name %></p>
                  <p class="text-sm text-mute">Society</p>
                <% end %>
              <% else %>
                <%= link_to profile_path(favorite.favoritable), class: "min-w-0 flex-1", data: { turbo_frame: "_top" } do %>
                  <p class="truncate font-semibold text-ink"><%= favorite.favoritable.first_name %> <%= favorite.favoritable.last_name %></p>
                  <p class="text-sm text-mute">Taster</p>
                <% end %>
              <% end %>
              <%= button_to "Unfollow", favorite_path(favorite), method: :delete,
                  class: "btn btn-secondary min-h-11 shrink-0 cursor-pointer" %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card p-8">
        <p class="font-semibold text-ink">You're not following anyone yet.</p>
        <p class="mt-1 text-sm text-mute">Favorite a society or a fellow taster and their pours will show up in your circle on the tasting record.</p>
        <%= link_to "Browse societies", societies_path, class: "btn btn-primary mt-5 min-h-11" %>
      </div>
    <% end %>
  </div>
</div>
