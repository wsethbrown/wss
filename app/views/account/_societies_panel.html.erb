<%# Account tab panel: societies. %>
<div id="societies-content" class="tab-content hidden">
  <div class="space-y-6">
    <div>
      <h2 class="font-display text-2xl font-semibold text-ink">My Societies</h2>
      <p class="mt-1 text-mute">Manage your whiskey societies and memberships</p>
    </div>

    <% user_societies = current_user.member_societies.includes(:creator) %>
    <% if user_societies.any? %>
      <% memberships_by_society = current_user.society_memberships.index_by(&:society_id) %>
      <div class="card divide-y divide-hairline">
        <% user_societies.each do |society| %>
          <% membership = memberships_by_society[society.id] %>
          <a href="<%= society_path(society) %>" class="group block px-5 py-4 transition hover:bg-paper first:rounded-t-[26px] last:rounded-b-[26px]">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-base font-semibold text-ink"><%= society.name %></h3>
                  <% if membership&.admin? %>
                    <span class="inline-flex items-center rounded-xl bg-whiskey-100 px-2.5 py-0.5 text-xs font-medium text-ink">Creator</span>
                  <% elsif membership&.officer? %>
                    <span class="inline-flex items-center rounded-xl bg-whiskey-100 px-2.5 py-0.5 text-xs font-medium text-ink">Officer</span>
                  <% end %>
                </div>
                <% if society.description.present? %>
                  <p class="mt-1 line-clamp-2 text-sm text-mute"><%= truncate(society.description, length: 80) %></p>
                <% end %>
              </div>
              <div class="flex shrink-0 items-center gap-4 text-sm text-mute tabular-nums">
                <span class="flex items-center" title="Members">
                  <%= render 'shared/user_group_icon', size: 'small' %>
                  <%= society.society_memberships.active.count %>
                </span>
                <span class="flex items-center" title="Events">
                  <svg class="mr-1 h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <%= society.events.count %>
                </span>
              </div>
            </div>
          </a>
        <% end %>
      </div>
    <% else %>
      <div class="card p-8">
        <h3 class="text-xl font-semibold text-ink">No societies yet</h3>
        <p class="mt-1 text-mute">You haven't joined any whiskey societies yet.</p>
        <a href="<%= societies_path %>" class="btn btn-primary mt-5 min-h-11">Discover Societies</a>
      </div>
    <% end %>
  </div>
</div>
