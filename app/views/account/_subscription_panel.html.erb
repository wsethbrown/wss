<%# Account tab panel: subscription. Everything shown here is REAL,
    payment method and invoices live in the Stripe Customer Portal (one
    button), never mocked up here. Checkout banners are flash-driven
    (one-shot), set by AccountController#index's redirect. %>
<div id="subscription-content" class="tab-content hidden">
  <div class="space-y-6">
    <div>
      <h2 class="font-display text-2xl font-semibold text-ink">Subscription</h2>
      <p class="mt-1 text-mute">Manage your subscription and billing preferences</p>
    </div>

    <% if flash[:checkout_result] == "success" %>
      <div class="rounded-2xl bg-whiskey-100 p-4">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-sm font-medium text-ink">
            You're in, one deck credit added. <%= link_to "Browse the decks", presentations_path, class: "underline" %> and spend it well.
          </p>
        </div>
      </div>
    <% elsif flash[:checkout_result] == "cancelled" %>
      <div class="rounded-2xl border border-hairline bg-paper p-4">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <p class="text-sm font-medium text-ink">
            Subscription checkout was cancelled. You can try again when you're ready.
          </p>
        </div>
      </div>
    <% end %>

    <% if current_user.has_active_subscription? || current_user.subscription_paused? || (current_user.cancel_at_period_end? && current_user.subscription_ends_at&.future?) %>
      <% renewal = current_user.subscription_ends_at %>

      <!-- Your membership: plan + credits, one card -->
      <div class="card p-6">
        <% if current_user.subscription_paused? %>
          <div class="mb-5 rounded-2xl border border-hairline bg-paper p-4 text-sm text-ink">
            <span class="font-semibold">Paused</span> since <%= current_user.subscription_paused_at.strftime('%B %-d, %Y') %>,
            billing resumes automatically on <%= (current_user.subscription_paused_at + 1.month).strftime('%B %-d, %Y') %>.
            You keep access to everything you've unlocked.
          </div>
        <% elsif current_user.cancel_at_period_end? && renewal&.future? %>
          <div class="mb-5 rounded-2xl border border-hairline bg-paper p-4 text-sm text-ink">
            <span class="font-semibold">Ending</span>, your membership runs until <%= renewal.strftime('%B %-d, %Y') %>.
            You keep full access until then.
          </div>
        <% end %>

        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-medium text-mute">Your membership</p>
            <h3 class="mt-1 font-display text-2xl font-semibold text-ink">
              <%= current_user.subscription_plan&.titleize || 'Monthly' %>
              <% if current_user.founding_member? %>
                <span class="ml-1 inline-flex items-center rounded-xl bg-whiskey-100 px-2.5 py-0.5 align-middle text-xs font-semibold text-ink">Founding Member</span>
              <% end %>
              <% if current_user.subscription_paused? %>
                <span class="ml-1 inline-flex items-center rounded-xl bg-whiskey-100 px-2.5 py-0.5 align-middle text-xs font-semibold text-ink">Paused</span>
              <% elsif current_user.cancel_at_period_end? %>
                <span class="ml-1 inline-flex items-center rounded-xl bg-whiskey-100 px-2.5 py-0.5 align-middle text-xs font-semibold text-ink">Ending</span>
              <% end %>
            </h3>
            <p class="mt-1 text-sm text-mute">
              <% if current_user.cancel_at_period_end? && renewal %>
                Access ends <%= renewal.strftime('%B %-d, %Y') %>
              <% elsif renewal %>
                Renews <%= renewal.strftime('%B %-d, %Y') %>
              <% end %>
            </p>
          </div>

          <div class="rounded-[18px] bg-paper px-6 py-4 text-center sm:text-right">
            <p class="font-display text-4xl font-semibold tabular-nums text-ink"><%= current_user.credits || 0 %></p>
            <p class="text-sm font-medium text-mute">deck credit<%= 's' if current_user.credits != 1 %></p>
            <% if renewal && !current_user.cancel_at_period_end? %>
              <p class="mt-1 text-xs text-mute">next credit <%= renewal.strftime('%b %-d, %Y') %></p>
            <% end %>
          </div>
        </div>

        <p class="mt-4 text-sm text-mute">
          Credits unlock any deck while your membership is active, you receive one with each renewal.
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-hairline pt-5">
          <%= link_to "Adjust plan", subscriptions_plans_path,
              class: "btn btn-primary min-h-11" %>
          <%= button_to "Payment method & invoices", subscriptions_portal_path, method: :post,
              class: "btn btn-secondary min-h-11 cursor-pointer" %>
        </div>
      </div>

      <!-- Pause / cancel -->
      <div class="card p-6">
        <p class="text-sm font-medium text-mute">Need a break?</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <% if current_user.subscription_can_be_paused? %>
            <%= button_to "Pause subscription", subscriptions_pause_path, method: :post,
                data: { turbo_confirm: "Pause your subscription? Billing stops for a month and resumes automatically. You keep access to everything you've unlocked." },
                class: "btn btn-secondary min-h-11 cursor-pointer" %>
          <% elsif current_user.subscription_can_be_resumed? %>
            <%= button_to "Resume subscription", subscriptions_resume_path, method: :post,
                data: { turbo_confirm: "Resume your subscription? Billing restarts immediately." },
                class: "btn btn-primary min-h-11 cursor-pointer" %>
          <% end %>
          <% unless current_user.cancel_at_period_end? %>
            <%= button_to "Cancel subscription", subscriptions_cancel_path, method: :post,
                data: { turbo_confirm: "Cancel your subscription? You'll keep access until the end of your current billing period." },
                class: "btn min-h-11 cursor-pointer border border-red-200 bg-white text-red-700 hover:bg-red-50" %>
          <% end %>
        </div>
      </div>
    <% else %>
      <%# Non-subscriber chooser, matches the homepage pricing design:
          honest copy, slim price-only cards, one shared benefits list. %>
      <div class="mb-8">
        <div class="mb-6">
          <h4 class="font-display text-2xl font-semibold text-ink">Start your membership</h4>
          <p class="mt-1 text-mute">Every plan unlocks the same thing, pick the commitment that suits you.</p>
        </div>

        <div id="plan-cards" class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <% @stripe_products.each do |product| %>
            <% popular = product[:popular] %>
            <div class="flex flex-col p-6 <%= popular ? 'panel-ink' : 'card' %>">
              <% if popular %>
                <div class="mb-3">
                  <span class="inline-flex items-center rounded-xl bg-white px-2.5 py-0.5 text-xs font-semibold text-ink">Best Value</span>
                </div>
              <% end %>
              <div>
                <h3 class="font-display text-2xl font-semibold <%= popular ? 'text-white' : 'text-ink' %>"><%= product[:name].gsub(' Membership', '') %></h3>
                <p class="mt-1 text-sm <%= popular ? 'text-cream/80' : 'text-mute' %>"><%=
                  case product[:id]
                  when 'monthly' then 'Pay as you go, cancel anytime'
                  when 'quarterly' then 'Billed every three months'
                  when 'yearly' then 'Billed once a year'
                  else 'For committed members'
                  end
                %></p>
                <div class="mt-5">
                  <div class="flex items-end">
                    <span class="font-display text-4xl font-semibold tabular-nums <%= popular ? 'text-white' : 'text-ink' %>">$<%= sprintf('%.2f', product[:price] / 100.0) %></span>
                    <span class="ml-1 pb-1 text-base <%= popular ? 'text-cream/80' : 'text-mute' %>">/mo</span>
                  </div>
                  <% if product[:id] == 'quarterly' || product[:id] == 'yearly' %>
                    <div class="mt-1 text-sm <%= popular ? 'text-cream/80' : 'text-mute' %>">billed <%= product[:id] == 'quarterly' ? 'quarterly' : 'annually' %></div>
                  <% end %>
                  <% if product[:savings] %>
                    <div class="mt-3 inline-flex items-center rounded-xl px-3 py-1 text-sm font-semibold <%= popular ? 'bg-white text-ink' : 'bg-whiskey-100 text-ink' %>">Save <%= product[:savings] %></div>
                  <% end %>
                </div>
              </div>
              <div class="mt-auto pt-6">
                <%= form_with url: subscriptions_checkout_path, method: :post, local: true, data: { turbo: false } do |f| %>
                  <%= f.hidden_field :price_id, value: product[:id] %>
                  <%= f.submit "Get Started", class: "btn min-h-11 w-full cursor-pointer #{popular ? 'bg-white text-ink hover:bg-whiskey-100' : 'btn-primary'}" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="card mt-4 p-6">
          <h4 class="text-xl font-semibold text-ink">Every membership includes</h4>
          <ul class="mt-4 grid gap-x-8 gap-y-3 text-gray-900 sm:grid-cols-2">
            <% Membership::BENEFITS.each do |benefit| %>
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-4 w-4 shrink-0 text-ink" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span><%= benefit %></span>
              </li>
            <% end %>
          </ul>
        </div>

        <p class="mt-4 text-sm text-mute">
          Cancel anytime. Credits unlock any deck while your membership is active; decks bought outright are yours for good.
        </p>
      </div>
    <% end %>

    <!-- Credits history, real transactions only -->
    <% if current_user.credit_transactions.exists? %>
      <div class="card p-6">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-mute">Credits history</p>
          <span class="inline-flex items-center rounded-xl bg-whiskey-100 px-3 py-1 text-sm font-semibold tabular-nums text-ink">
            <%= current_user.credits %> available
          </span>
        </div>
        <div class="mt-2">
          <% current_user.credit_transactions.order(created_at: :desc).limit(5).each do |transaction| %>
            <div class="flex items-center justify-between gap-4 border-b border-hairline py-3 last:border-0">
              <div>
                <p class="text-sm font-medium text-ink">
                  <%= case transaction.transaction_type
                      when 'granted' then (transaction.description.presence || 'Credit granted')
                      when 'used' then (transaction.presentation&.title || 'Deck unlocked')
                      when 'expired' then 'Credits expired'
                      when 'refunded' then 'Credit refunded'
                      else transaction.transaction_type.to_s.titleize
                      end %>
                </p>
                <p class="text-xs text-mute"><%= transaction.created_at.strftime('%B %-d, %Y') %></p>
              </div>
              <p class="text-sm font-semibold tabular-nums <%= %w[granted refunded].include?(transaction.transaction_type) ? 'text-ink' : 'text-red-700' %>">
                <%= %w[granted refunded].include?(transaction.transaction_type) ? '+' : '-' %><%= transaction.amount.abs %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
