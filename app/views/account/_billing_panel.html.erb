<%# Account tab panel: billing. %>
<div id="billing-content" class="tab-content hidden">
  <div class="space-y-6">
    <div>
      <h2 class="font-display text-2xl font-semibold text-ink">Billing</h2>
      <p class="mt-1 text-mute">Manage your payment method, invoices, and billing details</p>
    </div>

    <div class="card p-6">
      <h3 class="mb-2 text-xl font-semibold text-ink">Payment &amp; invoices</h3>
      <% if current_user.stripe_customer_id.present? %>
        <p class="mb-4 text-sm text-mute">
          Update your card, download invoices, and review your billing history
          in the secure Stripe billing portal.
        </p>
        <%= button_to "Manage billing in Stripe", subscriptions_portal_path, method: :post,
              class: "btn btn-primary min-h-11 cursor-pointer" %>
      <% else %>
        <p class="text-sm text-mute">
          You don't have any billing history yet. Start a subscription to manage
          billing here.
          <%= link_to "View plans", "#subscription", class: "font-medium text-ink underline", data: { tab_link: "subscription" } %>
        </p>
      <% end %>
    </div>

    <div class="card p-6">
      <h3 class="mb-2 text-xl font-semibold text-ink">Current status</h3>
      <dl class="divide-y divide-hairline text-sm text-gray-900">
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-mute">Plan</dt>
          <dd class="font-medium"><%= current_user.subscription_plan&.titleize || "None" %></dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-mute">Status</dt>
          <dd class="font-medium"><%= current_user.subscription_status_display %></dd>
        </div>
        <% if current_user.subscription_ends_at.present? %>
          <div class="flex justify-between gap-4 py-2.5">
            <dt class="text-mute"><%= current_user.cancel_at_period_end? ? "Access ends" : "Renews" %></dt>
            <dd class="font-medium tabular-nums"><%= current_user.subscription_ends_at.strftime("%B %d, %Y") %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</div>
