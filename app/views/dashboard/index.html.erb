<%# The signed-in dashboard (DashboardController#index). Paper ground, white
    hairline cards, ruled rows. Times are in the viewer's zone (the request
    runs in the browser zone, ApplicationController#set_timezone) with its
    abbreviation. Every list here was loaded by the controller; no queries
    from this view. %>
<% content_for :title, "Dashboard - Whiskey Share Society" %>
<% first_name = current_user.first_name.presence %>

<%= render "shared/page_header",
      title: (first_name ? "Welcome back, #{first_name}" : "Welcome back"),
      actions: link_to("Account", account_path, class: "btn btn-secondary") %>

<div class="grid grid-cols-1 gap-8 pb-16 lg:grid-cols-12">
  <%# Your next tastings %>
  <section class="min-w-0 lg:col-span-7" aria-labelledby="next-tastings-heading">
    <h2 id="next-tastings-heading" class="mb-4 font-display text-2xl font-semibold text-ink sm:text-3xl">Your next tastings</h2>

    <% if @upcoming.any? %>
      <div class="card overflow-hidden">
        <ul class="divide-y divide-hairline">
          <% @upcoming.each do |event| %>
            <% answer = @answers[event.id] %>
            <% local = event.start_time.in_time_zone %>
            <li class="flex flex-col gap-3 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
              <div class="min-w-0">
                <%= link_to event.title, society_event_path(event.society, event),
                      class: "text-lg font-semibold text-ink [overflow-wrap:anywhere] hover:underline hover:decoration-hairline hover:underline-offset-4" %>
                <p class="mt-1 text-sm text-gray-900 tabular-nums">
                  <time datetime="<%= event.start_time.iso8601 %>"><%= local.strftime("%A, %B %-d") %> · <%= local.strftime("%-l:%M %p %Z") %></time>
                </p>
                <p class="mt-0.5 text-sm text-mute [overflow-wrap:anywhere]">
                  <%= event.society.name %><% if event.location.present? %> · <%= event.location %><% end %>
                </p>
              </div>
              <div class="shrink-0">
                <% if answer %>
                  <span class="chip">You said <%= answer %></span>
                <% else %>
                  <%= link_to society_event_path(event.society, event),
                        class: "inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-ink hover:underline" do %>
                    Coming along? <span class="arrow" aria-hidden="true">→</span>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% elsif @societies.any? %>
      <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-mute">No tastings are scheduled in your societies yet.</p>
        <%= link_to "Your societies", societies_path, class: "btn btn-secondary shrink-0" %>
      </div>
    <% else %>
      <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-mute">Join a society to see its tastings here.</p>
        <%= link_to "Discover societies", societies_path, class: "btn btn-primary shrink-0" %>
      </div>
    <% end %>
  </section>

  <div class="flex min-w-0 flex-col gap-8 lg:col-span-5">
    <%# Waiting on you: unanswered nights, then revealed pours to review. %>
    <section aria-labelledby="waiting-heading">
      <h2 id="waiting-heading" class="mb-4 font-display text-2xl font-semibold text-ink sm:text-3xl">Waiting on you</h2>

      <% if @unanswered.any? || @pours_to_review.any? %>
        <div class="card overflow-hidden">
          <ul class="divide-y divide-hairline">
            <% @unanswered.each do |event| %>
              <li>
                <%= link_to society_event_path(event.society, event),
                      class: "flex min-h-11 items-center justify-between gap-4 px-5 py-4 transition-colors hover:bg-whiskey-50 sm:px-6" do %>
                  <span class="min-w-0">
                    <span class="block font-semibold text-ink [overflow-wrap:anywhere]"><%= event.title %></span>
                    <span class="block text-sm text-mute tabular-nums"><%= event.start_time.in_time_zone.strftime("%a, %b %-d · %-l:%M %p %Z") %></span>
                  </span>
                  <span class="shrink-0 text-sm font-semibold text-ink">Coming along? <span class="arrow" aria-hidden="true">→</span></span>
                <% end %>
              </li>
            <% end %>
            <% @pours_to_review.each do |pour| %>
              <li class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                <span class="min-w-0">
                  <span class="block font-semibold text-ink [overflow-wrap:anywhere]"><%= pour.bottle.display_name %></span>
                  <span class="block text-sm text-mute [overflow-wrap:anywhere]"><%= pour.event.title %></span>
                </span>
                <%= link_to "Review this pour", new_event_review_path(pour.event, bottle_id: pour.bottle.to_param),
                      class: "btn btn-secondary shrink-0 px-4 py-2" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-mute">Nothing is waiting on you.</p>
          <%= link_to "Reviews", reviews_path, class: "btn btn-secondary shrink-0" %>
        </div>
      <% end %>
    </section>

    <%# Your societies, short. The full list with search is /societies. %>
    <section aria-labelledby="dashboard-societies-heading">
      <h2 id="dashboard-societies-heading" class="mb-4 font-display text-2xl font-semibold text-ink sm:text-3xl">Your societies</h2>
      <% if @societies.any? %>
        <div class="card overflow-hidden">
          <ul class="divide-y divide-hairline">
            <% @societies.each do |society| %>
              <li>
                <%= link_to society_path(society),
                      class: "flex min-h-11 items-center justify-between gap-4 px-5 py-4 transition-colors hover:bg-whiskey-50 sm:px-6" do %>
                  <span class="min-w-0 font-semibold text-ink [overflow-wrap:anywhere]"><%= society.name %></span>
                  <span class="shrink-0 text-sm text-mute"><%= @society_roles[society.id] %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-mute">You don't belong to any societies yet.</p>
          <%= link_to "Discover societies", societies_path, class: "btn btn-secondary shrink-0" %>
        </div>
      <% end %>
    </section>
  </div>
</div>
