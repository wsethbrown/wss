<% content_for :title, "Contact" %>

<%= render "shared/page_header", title: "Reach <em>the Society.</em>".html_safe %>

<div class="card divide-y divide-hairline">
  <% [
    ["Say hello", "General questions, ideas, and everything else.", "hello@whiskeysharesociety.com"],
    ["Get help", "Trouble with your account, a deck, or an order.", "support@whiskeysharesociety.com"],
    ["Work with us", "Distillers, distributors, and collaborations.", "partners@whiskeysharesociety.com"]
  ].each do |title, blurb, email| %>
    <div class="flex flex-col gap-2 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-semibold text-ink"><%= title %></h2>
        <p class="mt-1 text-mute"><%= blurb %></p>
      </div>
      <a href="mailto:<%= email %>" class="break-all font-semibold text-ink hover:underline"><%= email %> →</a>
    </div>
  <% end %>
</div>
