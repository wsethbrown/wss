<%# The glass glyph: a flat, line-drawn tasting glass (the logo's glass) with a
    flat orange level. It is the numeral for a pour.

    locals:
      level:   0..1, how full (a real quantity: a score out of 5, an RSVP).
               0 draws an empty glass.
      numeral: optional text set in the bowl (the pour number).
      size:    rendered height in px (width follows, 40:56).
      tone:    :ink (on paper, default) or :cream (on the green panel).
      label:   accessible name; without it the glyph is decorative.

    Flat on purpose: no shading, no meniscus, no pour animation (owner
    ruling against skeuomorphism). %>
<%
  level   = local_assigns.fetch(:level, 0).to_f.clamp(0, 1)
  numeral = local_assigns[:numeral]
  size    = local_assigns.fetch(:size, 56).to_i
  tone    = local_assigns.fetch(:tone, :ink)
  label   = local_assigns[:label]
  stroke  = tone == :cream ? "#f6f4ee" : "#16332a"
  # The bowl holds liquid between y=44 (empty) and y=14 (to the chimney).
  top     = (44 - level * 30).round(2)
  uid     = "g#{SecureRandom.hex(4)}"
  bowl    = "M13 4v12c0 6-7 10-7 17c0 7 6 11 14 11s14-4 14-11c0-7-7-11-7-17V4z"
%>
<svg viewBox="0 0 40 56" width="<%= (size * 40 / 56.0).round %>" height="<%= size %>" class="n4-glass"
     <% if label %>role="img" aria-label="<%= label %>"<% else %>aria-hidden="true"<% end %>>
  <defs><clipPath id="<%= uid %>"><path d="<%= bowl %>"/></clipPath></defs>
  <% if level.positive? %>
    <rect x="0" y="<%= top %>" width="40" height="<%= 56 - top %>" fill="#ff6d00" clip-path="url(#<%= uid %>)"/>
  <% end %>
  <path d="<%= bowl %>" fill="none" stroke="<%= stroke %>" stroke-width="1.8" stroke-linejoin="round"/>
  <path d="M17.5 44v5M22.5 44v5M12 51.5h16" fill="none" stroke="<%= stroke %>" stroke-width="1.8" stroke-linecap="round"/>
  <% if numeral.present? %>
    <text x="20" y="37.5" text-anchor="middle" font-family="Instrument Sans, system-ui, sans-serif" font-weight="700" font-size="11"
          fill="<%= tone == :cream && level < 0.3 ? '#f6f4ee' : '#16332a' %>"><%= numeral %></text>
  <% end %>
</svg>
