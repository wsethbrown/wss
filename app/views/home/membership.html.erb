<%# Membership page: a header on paper, then the shared pricing section.
    Full-bleed page (see the layout), so it sets its own width and clears the nav. %>

<% content_for :title, "Membership" %>

<div class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
  <%= render "shared/page_header",
        title: "Start your own <em>whiskey club.</em>".html_safe,
        lede: "Membership lets you create a society, invite your friends, schedule tasting nights, run the pours, and keep every bottle on the record. Plus a deck credit every month.",
        clear_nav: true,
        actions: safe_join([
          # data-turbo=false: let the browser handle the in-page anchor natively so
          # CSS scroll-behavior: smooth applies. Turbo's own anchor scroll overshoots.
          link_to("See the plans", "#pricing", data: { turbo: false }, class: "btn btn-primary"),
          link_to("Browse societies", societies_path, class: "btn btn-secondary")
        ]) %>

  <p class="-mt-4 mb-10 text-sm text-mute">
    Joining a society is free &middot; Membership required to run a society
  </p>

  <%= render "shared/membership_pricing" %>
</div>
