<%# PREVIEW homepage — rendered only with ?design=next (see DesignPreview).

    One idea governs the page: the site is laid out the way the decks are.
    Each section is a "slide" — a flat colour field with one heading, one block
    of content, and a slide number — using the deck template's own rules:
      * three colours with jobs (green = title and turning points, cream =
        narrative, mustard = things you act on), never decoration
      * sans headings, serif body, a 5/7 column split on every slide
      * sharp rectangles and ruled lists; no cards, shadows or rounded corners
    The three "how it works" steps are the spine of the page, so each step
    carries the content it describes. Copy is reused from the live homepage
    apart from the "Step n of 3" kickers. Styles are scoped to .hn. %>
<%
  showcase_slides =
    if @showcase_deck
      @showcase_deck.slide_images.order(:id).first(@showcase_deck.effective_preview_slide_count)
    else
      []
    end
  rules = [
    "One presenter a month, everyone takes a turn.",
    "Research your topic like you mean it.",
    "Choose the bottles that belong to the story.",
    "No dry fact sheets. Follow the narrative threads."
  ]
  faqs = [
    [ "What if I'm a complete whiskey beginner?", "Perfect. The decks are written for every experience level. Start with something like Bourbon Basics: the script covers the fundamentals and makes you sound like you've done this before, because the research already has." ],
    [ "How long is a deck?", "Most run 15–20 minutes, built for a relaxed evening. The structure bends: linger on a tasting when the room is into it, or trim sections for a casual night." ],
    [ "What equipment do I need?", "Glasses, water for rinsing, and the bottles from the deck's list. Tasting mats and notes come as downloadable PDFs. Nothing fancy required." ],
    [ "Can I customize a deck?", "Yes. Swap bottles for budget or availability, skip sections, add your own chapter. Decks are guides with a spine, not scripts you owe obedience to." ],
    [ "How much do the whiskeys cost?", "Every deck recommends bottles across price ranges. You can host a full tasting for $60–80 total, or go deep with bottles north of $200, there's a version of the night for both." ],
    [ "What's the Century badge?", "The amber star beside certain tasters and societies. It marks anyone followed by 100 or more members, a signal that the room trusts their palate. There's no fee and no application: reach a hundred followers and it appears." ]
  ]
  total = 7
%>

<% content_for :head do %>
  <style>
    /* Preview-only: bring the shared nav and footer into the same system. */
    nav.fixed, nav.fixed details > div, footer { background-color: #16332a !important; border-color: rgba(245, 241, 230, .18) !important; }
    nav.fixed .font-display { font-family: "Instrument Sans", system-ui, sans-serif !important; letter-spacing: -.03em; }
    nav.fixed a.bg-whiskey-500 { background-color: #e8b33a !important; color: #16332a !important; border-radius: 0 !important; }
    footer .text-whiskey-400, footer .text-whiskey-300 { color: #e8b33a !important; }

    .hn { --green: #16332a; --cream: #f5f1e6; --must: #e8b33a; --pad: 24px;
          font-family: "Source Serif 4", Georgia, serif; }
    .hn *, .hn *::before { box-sizing: border-box; }

    /* A slide: one colour field. */
    .hn .sl { background: var(--bg); color: var(--fg); padding: 88px 0 28px; }
    .hn .s-green { --bg: var(--green); --fg: var(--cream); --soft: rgba(245, 241, 230, .78); --rule: rgba(245, 241, 230, .28); --btn-bg: var(--must); --btn-fg: var(--green); --num: var(--must); }
    .hn .s-cream { --bg: var(--cream); --fg: var(--green); --soft: #3d5247; --rule: rgba(22, 51, 42, .2); --btn-bg: var(--green); --btn-fg: var(--cream); --num: #b07a10; }
    .hn .s-must  { --bg: var(--must); --fg: var(--green); --soft: #2a4337; --rule: rgba(22, 51, 42, .32); --btn-bg: var(--green); --btn-fg: var(--cream); --num: var(--green); }

    .hn .wrap { max-width: 1240px; margin: 0 auto; padding: 0 var(--pad); }
    .hn .cols { display: grid; gap: 40px; }
    .hn .no { margin-top: 72px; text-align: right; font: 500 14px "Instrument Sans", sans-serif; opacity: .6; font-variant-numeric: tabular-nums; }

    /* Type: sans headings, serif body — the same pairing as the slides. */
    .hn h1, .hn h2, .hn h3, .hn .kick, .hn .act, .hn .go, .hn .meta, .hn summary, .hn .price {
      font-family: "Instrument Sans", system-ui, sans-serif; }
    .hn h1 { font-weight: 600; font-size: clamp(3.25rem, 10.4vw, 9.75rem); line-height: .9; letter-spacing: -.055em; text-wrap: balance; }
    .hn h2 { font-weight: 600; font-size: clamp(2.5rem, 5.6vw, 4.75rem); line-height: .96; letter-spacing: -.045em; text-wrap: balance; }
    .hn .kick { font-weight: 600; font-size: clamp(1.125rem, 1.6vw, 1.5rem); letter-spacing: -.02em; color: var(--num); margin-bottom: 16px; }
    .hn p { font-size: 20px; line-height: 1.5; color: var(--soft); text-wrap: pretty; max-width: 33em; }
    .hn p.lead { font-size: clamp(1.375rem, 2.1vw, 1.875rem); line-height: 1.34; color: var(--fg); max-width: 26em; }
    .hn h2 + p { margin-top: 24px; }

    /* Actions: solid rectangles and plain arrow links. */
    .hn .act { display: inline-flex; align-items: center; min-height: 54px; padding: 0 28px; background: var(--btn-bg); color: var(--btn-fg); font-weight: 600; font-size: 17px; letter-spacing: -.01em; transition: transform .12s; }
    .hn .act:hover { transform: translateY(-2px); }
    .hn .go { display: inline-flex; align-items: center; gap: 10px; min-height: 54px; font-weight: 600; font-size: 17px; }
    .hn .go::after { content: "→"; transition: transform .12s; }
    .hn .go:hover::after { transform: translateX(4px); }
    .hn .acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 32px; }
    .hn a:focus-visible, .hn summary:focus-visible { outline: 3px solid var(--fg); outline-offset: 3px; }

    /* Ruled lists: a heavy top rule, hairlines between rows. */
    .hn .rows { border-top: 4px solid var(--fg); list-style: none; margin: 0; padding: 0; }
    .hn .rows > .row, .hn .rows > li { display: grid; grid-template-columns: 1fr auto; gap: 4px 24px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--rule); }
    .hn .rows h3 { font-weight: 600; font-size: clamp(1.375rem, 2.2vw, 1.875rem); letter-spacing: -.035em; line-height: 1.1; }
    .hn .meta { grid-column: 1; font-size: 14px; color: var(--soft); }
    .hn .price { font-weight: 600; font-size: 18px; font-variant-numeric: tabular-nums; }
    .hn .price small { font-weight: 400; font-size: 14px; }
    .hn a.row:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
    .hn ol.rows { counter-reset: r; }
    .hn ol.rows > li { counter-increment: r; grid-template-columns: 44px 1fr; font-size: clamp(1.25rem, 1.9vw, 1.625rem); line-height: 1.25; }
    .hn ol.rows > li::before { content: counter(r); font: 600 1em "Instrument Sans", sans-serif; color: var(--num); }

    /* Slide 1: the title slide. */
    .hn .title { min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding-top: 120px; }
    .hn .title p.lead { margin-top: 28px; color: var(--soft); }
    .hn .title .foot { display: flex; justify-content: space-between; gap: 16px; margin-top: 64px; padding-top: 18px; border-top: 1px solid var(--rule); font: 500 14px "Instrument Sans", sans-serif; opacity: .75; }
    .hn .title .foot span:last-child { font-variant-numeric: tabular-nums; }

    /* Real slides from a deck: the same object as the page, at thumbnail size. */
    .hn .deck { margin: 0 0 40px; }
    .hn .deck .frames { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .hn .deck .frames > :first-child { grid-column: 1 / -1; }
    .hn .deck img { display: block; width: 100%; height: 100%; aspect-ratio: 16 / 9; object-fit: cover; border: 2px solid var(--fg); }
    .hn .deck figcaption { display: flex; justify-content: space-between; gap: 16px; margin-top: 12px; font: 500 14px "Instrument Sans", sans-serif; color: var(--soft); }
    .hn .deck figcaption a { color: var(--fg); font-weight: 600; }
    .hn .listhead { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 14px; }
    .hn .listhead h3 { font-weight: 600; font-size: 20px; letter-spacing: -.02em; }
    .hn .listhead .go { min-height: 0; }

    .hn details { border-bottom: 1px solid var(--rule); }
    .hn summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 24px; padding: 20px 0; font-size: 20px; font-weight: 600; letter-spacing: -.02em; }
    .hn summary::-webkit-details-marker { display: none; }
    .hn summary::after { content: "+"; font-weight: 400; }
    .hn details[open] summary::after { content: "–"; }
    .hn details p { padding: 0 0 24px; font-size: 18px; }

    @media (min-width: 900px) {
      .hn { --pad: 40px; }
      .hn .sl { padding: 128px 0 32px; }
      .hn .title { padding-top: 140px; }
      .hn .cols { grid-template-columns: 5fr 7fr; gap: 72px; }
      .hn .no { margin-top: 104px; }
      .hn .deck .frames { grid-template-columns: 2fr 1fr; gap: 10px; }
      .hn .deck .frames > :first-child { grid-column: 1; grid-row: 1 / span 2; }
      .hn .rows > .row { grid-template-columns: 1fr 230px auto; }
      .hn .rows .meta { grid-column: auto; }
      .hn ol.rows > li { grid-template-columns: 56px 1fr; }
      .hn .rows.plans > .row { grid-template-columns: 1fr auto; }
    }
    @media (prefers-reduced-motion: reduce) { .hn * { transition: none !important; } }
  </style>
<% end %>

<div class="hn">
  <!-- 1 · Title -->
  <section class="sl s-green title">
    <div class="wrap">
      <h1>Every pour has a story.</h1>
      <p class="lead">Narrative tasting decks for whiskey nights that hold together, the research done, the script written, the bottles picked.</p>
      <div class="acts">
        <%= link_to "Browse the decks", presentations_path, class: "act" %>
        <a href="#step-1" class="go">See how it works</a>
      </div>
      <div class="foot">
        <span>The Whiskey Share Society · Est. 2019</span>
        <span>1 / <%= total %></span>
      </div>
    </div>
  </section>

  <!-- 2 · Step 1 -->
  <section id="step-1" class="sl s-cream">
    <div class="wrap">
      <div class="cols">
        <div>
          <div class="kick">Step 1 of 3</div>
          <h2>Pick a deck</h2>
          <p>Browse the library and choose the story you want to tell, bourbon, scotch, rye, or something stranger. Filter by difficulty and budget.</p>
        </div>
        <div>
          <% if showcase_slides.any? %>
            <%# Real slides, limited to the deck's free-preview slides. %>
            <figure class="deck">
              <%= link_to presentation_path(@showcase_deck), class: "frames", aria: { label: "#{@showcase_deck.title}, opening slides" } do %>
                <% showcase_slides.first(3).each_with_index do |slide, i| %>
                  <span><%= image_tag slide, alt: "Slide #{i + 1} of #{@showcase_deck.title}", loading: (i.zero? ? "eager" : "lazy") %></span>
                <% end %>
              <% end %>
              <figcaption>
                <%= link_to @showcase_deck.title, presentation_path(@showcase_deck) %>
                <span><%= [ "#{@showcase_deck.slide_images.count} slides", @showcase_deck.duration.presence ].compact.join(" · ") %></span>
              </figcaption>
            </figure>
          <% end %>
          <% if @featured_presentations.any? %>
            <div class="listhead">
              <h3>Latest decks</h3>
              <%= link_to "See the full library", presentations_path, class: "go" %>
            </div>
            <div class="rows">
              <% @featured_presentations.each do |deck| %>
                <%= link_to presentation_path(deck), class: "row" do %>
                  <h3><%= deck.title %></h3>
                  <span class="meta"><%= [ deck.category.presence, deck.difficulty.presence, deck.duration.presence ].compact.join(" · ") %></span>
                  <span class="price"><%= deck.price.to_f.zero? ? "Free" : number_to_currency(deck.price) %></span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="no">2 / <%= total %></div>
    </div>
  </section>

  <!-- 3 · Step 2 -->
  <section class="sl s-must">
    <div class="wrap">
      <div class="cols">
        <div>
          <div class="kick">Step 2 of 3</div>
          <h2>Gather your society</h2>
        </div>
        <div>
          <p class="lead">Start a private society for your friends or join a public one near you. Schedule the night, share the link, and RSVPs take care of themselves.</p>
          <p style="margin-top:24px">Societies are how those spaces organize: public ones open to new members, private ones that run on invitations, each with its own calendar of tasting nights and its own record of every pour the room has judged.</p>
          <div class="acts"><%= link_to "Browse societies", societies_path, class: "act" %></div>
        </div>
      </div>
      <div class="no">3 / <%= total %></div>
    </div>
  </section>

  <!-- 4 · Step 3 -->
  <section class="sl s-green">
    <div class="wrap">
      <div class="cols">
        <div>
          <div class="kick">Step 3 of 3</div>
          <h2>Pour and present</h2>
        </div>
        <div>
          <p class="lead">Follow the thread from first nose to final pour. The script keeps the room moving; the tasting notes keep it honest.</p>
          <p style="margin-top:24px">Every bottle the society tastes gets written down, nose, palate, finish, price, and personal thoughts, in a record you can search by bottle, distillery, or the flavor you're chasing.</p>
          <div class="acts"><%= link_to "Read the record", reviews_path, class: "act" %></div>
        </div>
      </div>
      <div class="no">4 / <%= total %></div>
    </div>
  </section>

  <!-- 5 · Origin -->
  <section class="sl s-cream">
    <div class="wrap">
      <div class="cols">
        <div>
          <h2>Born from a monthly ritual.</h2>
          <p>The first Whiskey Share Society started as a circle of friends in 2019. Each month one of us drew a topic, did the research, bought the bottles, and told its story over a deck of slides.</p>
          <div class="acts"><%= link_to "Find your society", societies_path, class: "go" %></div>
        </div>
        <div>
          <div class="listhead"><h3>House rules</h3></div>
          <ol class="rows">
            <% rules.each do |rule| %><li><span><%= rule %></span></li><% end %>
          </ol>
        </div>
      </div>
      <div class="no">5 / <%= total %></div>
    </div>
  </section>

  <!-- 6 · Membership -->
  <section id="pricing" class="sl s-must">
    <div class="wrap">
      <div class="cols">
        <div>
          <h2>Choose your pour.</h2>
          <p>One membership, three ways to pay it. Every plan unlocks the same thing, a deck credit every month and a society of your own.</p>
        </div>
        <div>
          <div class="rows plans">
            <% @stripe_products.each do |product| %>
              <div class="row">
                <h3><%= product[:name].to_s.gsub(" Membership", "") %></h3>
                <span class="price">$<%= sprintf("%.2f", product[:price] / 100.0) %> <small>/mo</small></span>
              </div>
            <% end %>
          </div>
          <div class="acts"><%= link_to "See the plans", membership_path, class: "act" %></div>
        </div>
      </div>
      <div class="no">6 / <%= total %></div>
    </div>
  </section>

  <!-- 7 · Questions -->
  <section id="faq" class="sl s-cream">
    <div class="wrap">
      <div class="cols">
        <div>
          <h2>Questions, answered.</h2>
        </div>
        <div class="rows">
          <% faqs.each do |q, a| %>
            <details>
              <summary><%= q %></summary>
              <p><%= a %></p>
            </details>
          <% end %>
        </div>
      </div>
      <div class="no">7 / <%= total %></div>
    </div>
  </section>
</div>
