<%# The top of the deck page: title, subtitle, the line of details and the description
    beside the cover. A deck with no slides and no featured image has no
    cover, so the text takes the full width. Also rendered by the admin's
    "What the customer sees" preview, so the two can never differ.
    Locals: presentation, cover_image (an attachment or nil), slides_count %>
<header class="grid gap-8 md:grid-cols-12 md:items-center">
  <div class="min-w-0 <%= cover_image ? 'md:col-span-5' : 'md:col-span-8' %>">
    <h1 class="font-display text-4xl font-semibold text-ink sm:text-5xl"><%= presentation.title %></h1>
    <% if presentation.subtitle.present? %>
      <p class="mt-3 font-reading text-xl leading-snug text-mute sm:text-2xl" data-deck-subtitle><%= presentation.subtitle %></p>
    <% end %>
    <% meta = [presentation.category.presence, presentation.difficulty.presence, presentation.duration_label.presence,
               (slides_count.positive? ? "#{slides_count} slides" : nil)].compact %>
    <% if meta.any? %>
      <p class="mt-3 text-sm text-mute"><%= meta.join(' · ') %></p>
    <% end %>
    <% if presentation.description.present? %>
      <p class="mt-5 whitespace-pre-line text-[17px] leading-relaxed text-gray-900"><%= presentation.description %></p>
    <% end %>
  </div>
  <% if cover_image %>
    <div class="md:col-span-7" style="view-transition-name: deck-cover-<%= presentation.id %>">
      <%= deck_cover presentation, preloaded: cover_image, alt: "#{presentation.title}, first slide" %>
    </div>
  <% end %>
</header>
