<%# Checkout for one deck: one card. Free decks claim in one click; paid decks
    pick credit or card here, then Stripe takes over. Field names and values are
    what Presentations::PurchasesController#create reads. %>
<div class="mx-auto max-w-2xl">
  <%= link_to "← Back to the deck", presentation_path(@presentation),
      class: "mb-4 inline-flex min-h-11 items-center text-sm font-medium text-mute hover:text-ink" %>

  <div class="card p-6 sm:p-8">
    <div class="flex items-start gap-5">
      <div class="hidden w-40 shrink-0 sm:block">
        <%= deck_cover @presentation, alt: "" %>
      </div>
      <div class="min-w-0">
        <h1 class="font-display text-2xl font-semibold text-ink sm:text-3xl"><%= @presentation.title %></h1>
        <% meta = ["#{@presentation.reading_time} min read", @presentation.difficulty.presence, @presentation.category.presence].compact %>
        <p class="mt-2 text-sm text-mute"><%= meta.join(' · ') %></p>
      </div>
    </div>
    <% if @presentation.description.present? %>
      <p class="mt-5 text-gray-900"><%= @presentation.excerpt(140) %></p>
    <% end %>

    <div class="mt-6 border-t border-hairline pt-6">
      <% if @presentation.free? %>
        <%# ------------------------------------------------ Free deck %>
        <p class="text-gray-900">
          This deck is free for everyone. Add it to your library and it's yours for good,
          slides, script, and downloads included.
        </p>
        <%= form_with url: presentation_purchases_path(@presentation), local: true, data: { turbo: false } do |f| %>
          <%= f.submit "Add to my library", class: "btn btn-primary mt-6 min-h-12 w-full cursor-pointer text-base" %>
        <% end %>
      <% else %>
        <%# --------------------------------------- Paid deck: pick a method %>
        <%= form_with url: presentation_purchases_path(@presentation), local: true, data: { turbo: false } do |f| %>
          <fieldset class="space-y-3">
            <legend class="sr-only">Purchase method</legend>

            <% prefer_direct = params[:method] == 'direct' %>
            <% option_class = "rounded-2xl border border-hairline bg-white p-5 transition hover:border-whiskey-300 peer-checked:border-ink peer-checked:bg-paper peer-checked:ring-1 peer-checked:ring-ink peer-focus-visible:ring-2 peer-focus-visible:ring-ink/30" %>
            <% if @can_use_credit %>
              <label class="block cursor-pointer">
                <input type="radio" name="purchase_method" value="credit" class="peer sr-only" <%= 'checked' unless prefer_direct %>>
                <div class="<%= option_class %>">
                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                      <h2 class="font-semibold text-ink">Use a credit</h2>
                      <p class="mt-1 text-sm text-mute">You have <%= current_user.credits %> credit<%= 's' if current_user.credits != 1 %>. Access lasts as long as your membership.</p>
                    </div>
                    <div class="shrink-0 text-right">
                      <span class="text-xl font-semibold tabular-nums text-ink">1 credit</span>
                      <p class="text-sm text-mute">No charge</p>
                    </div>
                  </div>
                </div>
              </label>
            <% end %>

            <label class="block cursor-pointer">
              <input type="radio" name="purchase_method" value="direct" class="peer sr-only" <%= 'checked' if !@can_use_credit || prefer_direct %>>
              <div class="<%= option_class %>">
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <h2 class="font-semibold text-ink">Buy it outright</h2>
                    <p class="mt-1 text-sm text-mute">One-time payment. Yours for good, membership or not.</p>
                  </div>
                  <div class="shrink-0 text-right">
                    <span class="text-xl font-semibold tabular-nums text-ink"><%= @presentation.formatted_price %></span>
                    <p class="text-sm text-mute">One-time</p>
                  </div>
                </div>
              </div>
            </label>
          </fieldset>

          <% unless current_user.subscription_active? %>
            <div class="inset mt-5 p-5">
              <p class="text-sm text-gray-900">
                <strong class="font-semibold text-ink">Members get one deck a month</strong> with their membership.
                <%= link_to "See membership plans", membership_path(anchor: "pricing"), class: "font-semibold text-ink underline underline-offset-2" %>
              </p>
            </div>
          <% end %>

          <%= f.submit "Continue", class: "btn btn-primary mt-6 min-h-12 w-full cursor-pointer text-base" %>
        <% end %>

        <p class="mt-4 flex items-center justify-center gap-2 text-sm text-mute">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          <%# Keep the trust line factual and short: which methods appear is a
              Stripe dashboard setting, so don't promise specific ones here. %>
          Secure checkout powered by Stripe
        </p>
      <% end %>
    </div>
  </div>
</div>
