<%# A deck as a card: cover, title, one line of meta, price or ownership.
    Used on the homepage, the library, the deck page and the account library.
    Locals: deck (Presentation), owned (Boolean, optional) %>
<% owned = local_assigns.fetch(:owned, false) %>
<% meta = [ deck.category.presence, deck.difficulty.presence, deck.duration_label ].compact.join(" · ") %>
<%= link_to presentation_path(deck), class: 'group block h-full' do %>
  <article class="card-hover flex h-full flex-col p-3">
    <div class="relative" style="view-transition-name: deck-cover-<%= deck.id %>">
      <%= deck_cover deck %>
      <% if deck.featured? %>
        <span class="absolute left-2.5 top-2.5 inline-flex min-h-7 items-center rounded-xl bg-white px-2.5 text-xs font-semibold text-ink">Featured</span>
      <% end %>
    </div>
    <div class="flex flex-1 flex-col px-2 pb-2 pt-4">
      <h3 class="font-display text-xl font-semibold text-ink"><%= deck.title %></h3>
      <% if meta.present? %>
        <p class="mt-1 text-sm text-mute"><%= meta %></p>
      <% end %>
      <div class="mt-auto flex items-center justify-between gap-3 pt-4">
        <span class="font-semibold tabular-nums text-ink"><%= owned ? 'In your library' : deck.formatted_price %></span>
        <%# A rating only when there are real reviews. %>
        <% if deck.reviewed? %>
          <span class="flex shrink-0 items-baseline gap-1 whitespace-nowrap"
                title="<%= "#{number_with_precision(deck.average_review_rating, precision: 1)} out of 5 from #{pluralize(deck.reviews_count, 'review')}" %>">
            <%= render "shared/score", value: deck.average_review_rating, precision: 1 %>
            <span class="text-xs font-medium text-mute tabular-nums"><%= deck.reviews_count %></span>
          </span>
        <% end %>
      </div>
    </div>
  </article>
<% end %>
