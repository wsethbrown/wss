<%# "Back to site" and "Sign out", at the foot of the admin sidebar and the phone
    menu. Rendered by layouts/admin.html.erb only. Locals: none. %>
<%= link_to root_path, class: "flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-cream/70 transition hover:bg-oak/60 hover:text-cream" do %>
  <svg class="h-5 w-5 text-cream/50" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
  </svg>
  Back to site
<% end %>
<%= button_to destroy_user_session_path, method: :delete, class: "flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-xl px-3 text-sm font-medium text-cream/70 transition hover:bg-oak/60 hover:text-cream" do %>
  <svg class="h-5 w-5 text-cream/50" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
  </svg>
  Sign out
<% end %>
