<%# Form card: one card per form (or per group of fields in a long form).
    Labels above inputs; use the helpers so every admin form matches:
      f.label :email, class: admin_label_class
      f.email_field :email, class: admin_field_class   (selects and textareas too)
    Put the submit at the end of the block in a row:
      div class "flex flex-wrap gap-3 border-t border-hairline pt-5" holding
      f.submit "Save", class: "btn btn-primary" and a btn-secondary cancel link.
    Locals:
      title (String, optional) card heading, e.g. "Profile"
      lede  (String, optional) one line under the heading
      block (required) the form fields; the caller owns the form_with tag, so
            one form may span several cards
    Example:
      render "admin/shared/form_card", title: "Profile" do ... fields ... end %>
<% title = local_assigns[:title] %>
<% lede = local_assigns[:lede] %>
<section class="card p-5 sm:p-7">
  <% if title.present? %>
    <div class="mb-5">
      <h2 class="text-xl font-semibold text-ink"><%= title %></h2>
      <% if lede.present? %>
        <p class="mt-1 text-sm text-mute"><%= lede %></p>
      <% end %>
    </div>
  <% end %>
  <div class="space-y-5"><%= yield %></div>
</section>
