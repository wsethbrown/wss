<% content_for :title, "Subscriptions - Admin" %>

<%= render "admin/shared/page_header", title: "Subscriptions", lede: "Manage user subscriptions and billing" %>

<%= render "admin/shared/stats", stats: [
  { label: "Active", value: @total_active },
  { label: "Paused", value: @total_paused },
  { label: "Canceled", value: @total_canceled },
  { label: "Monthly recurring revenue", value: "$#{number_with_precision(@total_revenue, precision: 2)}" },
  { label: "Avg credits/user", value: User.where(subscription_status: "active").average(:credits).to_f.round(1) }
] %>

<%= render "admin/shared/filter_bar", url: admin_subscriptions_path, clear: admin_subscriptions_path, submit: "Apply filters" do |form| %>
  <div class="sm:col-span-2">
    <%= form.label :search, "Search users", class: admin_label_class %>
    <%= form.text_field :search, value: params[:search], placeholder: "Search by name or email...", class: admin_field_class %>
  </div>
  <div>
    <%= form.label :status, "Status", class: admin_label_class %>
    <%= form.select :status,
        options_for_select([ [ "All statuses", "" ], [ "Active", "active" ], [ "Paused", "paused" ], [ "Canceled", "canceled" ], [ "Past due", "past_due" ] ], params[:status]),
        {}, { class: admin_field_class } %>
  </div>
  <div>
    <%= form.label :sort, "Sort by", class: admin_label_class %>
    <%= form.select :sort,
        options_for_select([ [ "Newest first", "newest" ], [ "Ending soon", "ending_soon" ], [ "Customer name", "customer" ] ], params[:sort]),
        {}, { class: admin_field_class } %>
  </div>
<% end %>

<%= render "admin/shared/table", rows: @subscriptions, paginate: true,
      columns: [ "Customer", "Plan", "Status", [ "Credits", :right ], "Next billing", [ "", :right ] ],
      empty: ((params[:search].present? || params[:status].present?) ? "No subscriptions match your filters." : "No users have subscriptions yet.") do |user| %>
  <%= admin_td do %>
    <div class="flex items-center gap-3">
      <%= avatar(user, size: 40) %>
      <%# Capped like the other admin tables: one private-relay address in a
          name field must not widen the panel. %>
      <div class="min-w-0">
        <div class="max-w-[14rem] truncate font-medium text-gray-900" title="<%= user.full_name %>"><%= user.full_name %></div>
        <div class="max-w-[14rem] truncate text-xs text-mute" title="<%= user.email %>"><%= user.email %></div>
      </div>
    </div>
  <% end %>
  <%= admin_td(user.subscription_plan || "N/A", class: "capitalize") %>
  <%= admin_td do %>
    <% if user.subscription_paused? %>
      <%= render "admin/shared/status_chip", label: "Paused", tone: :attention %>
    <% else %>
      <% case user.subscription_status %>
      <% when "active" %>
        <%= render "admin/shared/status_chip", label: "Active", tone: :ok %>
      <% when "canceled" %>
        <%= render "admin/shared/status_chip", label: "Canceled", tone: :problem %>
      <% when "past_due" %>
        <%= render "admin/shared/status_chip", label: "Past due", tone: :problem %>
      <% else %>
        <%= render "admin/shared/status_chip", label: "Unknown", tone: :attention %>
      <% end %>
    <% end %>
  <% end %>
  <%= admin_td(user.credits, align: :right) %>
  <%= admin_td(user.subscription_ends_at&.strftime("%b %d, %Y") || "N/A", class: "whitespace-nowrap text-mute") %>
  <%= admin_td(align: :right) do %>
    <div class="flex items-center justify-end gap-3">
      <%= link_to "View", admin_user_path(user), class: admin_link_class %>
      <%= link_to "Edit", edit_admin_subscription_path(user), class: admin_link_class %>
      <% if user.subscription_can_be_paused? %>
        <%= render "admin/shared/confirm_button", label: "Pause", url: pause_admin_subscription_path(user),
                   method: :post, confirm: "Pause this subscription?" %>
      <% elsif user.subscription_can_be_resumed? %>
        <%= button_to "Resume", resume_admin_subscription_path(user), method: :post,
            data: { turbo_confirm: "Resume this subscription?" },
            class: "cursor-pointer text-sm #{admin_link_class}", form: { class: "inline" } %>
      <% end %>
      <% if user.subscription_status == "active" && !user.subscription_paused? %>
        <%= render "admin/shared/confirm_button", label: "Cancel", url: cancel_admin_subscription_path(user),
                   method: :post, confirm: "Are you sure you want to cancel this subscription?" %>
      <% end %>
    </div>
  <% end %>
<% end %>
