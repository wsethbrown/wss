<% content_for :title, "Edit Subscription - #{@user.full_name}" %>

<div class="max-w-4xl">
  <%= render "admin/shared/page_header", title: "Edit subscription", lede: "Manage subscription and credits for #{@user.full_name}",
             back: [ "Subscriptions", admin_subscriptions_path ] %>

  <%= form_with model: @user, url: admin_subscription_path(@user), local: true do |form| %>
    <div class="space-y-6">
      <%= render "admin/shared/detail_panel", title: "Current status", rows: [
        [ "Customer", capture { %>
          <span class="inline-flex items-center gap-3 sm:justify-end">
            <%= avatar(@user, size: 40) %>
            <span class="text-left"><span class="block font-medium text-gray-900"><%= @user.full_name %></span><span class="block text-xs text-mute"><%= @user.email %></span></span>
          </span>
        <% } ],
        [ "Stripe customer ID", content_tag(:span, @user.stripe_customer_id || "Not connected", class: "font-mono") ]
      ] %>

      <%= render "admin/shared/form_card", title: "Subscription details" do %>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          <div>
            <%= form.label :subscription_status, class: admin_label_class %>
            <%= form.select :subscription_status,
                options_for_select([ [ "No Subscription", "" ], [ "Active", "active" ], [ "Canceled", "canceled" ], [ "Past Due", "past_due" ] ], @user.subscription_status),
                {}, { class: admin_field_class } %>
          </div>
          <div>
            <%= form.label :subscription_plan, class: admin_label_class %>
            <%= form.select :subscription_plan,
                options_for_select([ [ "Monthly - $9.99/mo", "monthly" ], [ "Annual - $99.99/yr", "annual" ] ], @user.subscription_plan),
                { include_blank: "Select a plan" }, { class: admin_field_class } %>
          </div>
          <div>
            <%= form.label :subscription_ends_at, "Billing Date", class: admin_label_class %>
            <%= form.date_field :subscription_ends_at, class: admin_field_class %>
            <p class="mt-1 text-sm text-mute">Next billing or end date</p>
          </div>
        </div>
      <% end %>

      <%# Credits are added through the ledger (CreditTransaction), never by
          writing the balance: there is deliberately no "set balance" field. %>
      <%= render "admin/shared/form_card", title: "Credit management" do %>
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-sm text-mute">Current credits</p>
            <p class="font-display text-3xl font-semibold tabular-nums text-ink"><%= @user.credits %></p>
          </div>
          <div class="text-right">
            <p class="text-sm text-mute">Next credit</p>
            <p class="text-sm font-medium text-gray-900"><%= @user.next_credit_date&.strftime("%b %d, %Y") || "N/A" %></p>
          </div>
        </div>
        <div class="border-t border-hairline pt-5">
          <%= label_tag :add_credits, "Add Credits", class: admin_label_class %>
          <div class="flex flex-wrap gap-3">
            <%= number_field_tag :add_credits, nil, placeholder: "Number of credits to add", min: 0,
                class: "#{admin_field_class} min-w-0 flex-1 basis-48" %>
            <% [ 1, 5, 10 ].each do |n| %>
              <button type="button" onclick="document.getElementById('add_credits').value = <%= n %>" class="btn btn-secondary min-h-11 py-2.5">+<%= n %></button>
            <% end %>
          </div>
          <p class="mt-2 text-sm text-mute">Credits will be added immediately upon saving</p>
        </div>
      <% end %>

      <div class="flex flex-wrap items-center gap-3">
        <%= form.submit "Save Changes", class: "btn btn-primary cursor-pointer" %>
        <%= link_to "Cancel", admin_subscriptions_path, class: "btn btn-secondary" %>
      </div>
    </div>
  <% end %>

  <%# Quick actions post to their own endpoints, so they sit outside the form above
      (nested forms are invalid). Previously link_to with method: :post, which
      Turbo does not honour; button_to actually sends the POST. %>
  <% if @user.subscription_status == "active" || @user.subscription_paused_at.present? %>
    <section class="card mt-6 p-5 sm:p-7">
      <h2 class="mb-4 text-xl font-semibold text-ink">Quick actions</h2>
      <div class="flex flex-wrap gap-3">
        <% if @user.subscription_status == "active" %>
          <%= button_to "Pause Subscription", pause_admin_subscription_path(@user), method: :post,
              data: { turbo_confirm: "Pause subscription for #{@user.full_name}?" }, class: "btn btn-secondary cursor-pointer" %>
          <%= render "admin/shared/confirm_button", label: "Cancel Subscription", url: cancel_admin_subscription_path(@user),
                     method: :post, variant: :button,
                     confirm: "Cancel subscription for #{@user.full_name}? This will cancel immediately." %>
        <% else %>
          <%= button_to "Resume Subscription", resume_admin_subscription_path(@user), method: :post,
              data: { turbo_confirm: "Resume subscription for #{@user.full_name}?" }, class: "btn btn-primary cursor-pointer" %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
