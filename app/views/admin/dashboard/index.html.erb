<% content_for :title, "Dashboard - Admin" %>
<%# Admin dashboard, built from the admin/shared pattern partials. Every figure
    comes from Admin::DashboardController; nothing here computes new numbers
    beyond percentages and bar heights for display. %>

<%= render "admin/shared/page_header",
           title: "Dashboard",
           lede: "Welcome to the Whiskey Share Society admin panel" do %>
  <%= link_to "Add new presentation", new_admin_presentation_path, class: "btn btn-primary min-h-11" %>
<% end %>

<%= render "admin/shared/stats", stats: [
      { label: "Total users", value: @total_users, path: admin_users_path,
        note: "+#{@new_users_this_week} this week" },
      { label: "Active subscriptions", value: @active_subscriptions, path: admin_subscriptions_path,
        note: "#{@total_users.positive? ? number_to_percentage(@active_subscriptions.to_f / @total_users * 100, precision: 0) : '0%'} of users" },
      { label: "Monthly recurring revenue", value: "$#{number_with_precision(@subscription_mrr, precision: 2)}",
        note: "$#{number_with_precision(@deck_sales_this_month, precision: 2)} in deck sales this month" },
      { label: "Presentations", value: @published_presentations, path: admin_presentations_path,
        note: "#{@total_presentations} total, #{@total_purchases} purchases" },
      { label: "Downloads", value: @total_downloads_today, path: admin_downloads_analytics_path,
        note: "Today · #{@total_downloads_week} this week" }
    ] %>

<div class="mb-6 grid gap-6 lg:grid-cols-12">
  <%# Recent signups: plain CSS bars, one per day for the last seven days. %>
  <section class="card p-5 sm:p-6 lg:col-span-7">
    <h2 class="text-lg font-semibold text-ink">Recent signups</h2>
    <% max_count = [ @signup_chart_data.map { |d| d[:count] }.max.to_i, 1 ].max %>
    <ol class="mt-5 flex h-48 items-end gap-2 sm:gap-3" aria-label="Signups per day, last seven days">
      <% @signup_chart_data.each do |data| %>
        <li class="flex h-full min-w-0 flex-1 flex-col items-center justify-end">
          <span class="mb-1.5 text-sm font-semibold tabular-nums text-ink"><%= data[:count] %></span>
          <span class="block w-full rounded-t-lg <%= data[:count].positive? ? 'bg-ink' : 'bg-hairline' %>"
                style="height: <%= data[:count].positive? ? [ (data[:count].to_f / max_count * 100).round, 6 ].max : 2 %>%"
                aria-hidden="true"></span>
          <span class="mt-2 whitespace-nowrap text-xs text-mute"><%= data[:date] %></span>
        </li>
      <% end %>
    </ol>
  </section>

  <div class="lg:col-span-5">
    <%= render "admin/shared/detail_panel", title: "Revenue breakdown", rows: [
          [ "Deck sales, one-time purchases, all time", "$#{number_with_precision(@deck_sales_total, precision: 2)}" ],
          [ "Subscriptions, estimated monthly recurring", "$#{number_with_precision(@subscription_mrr, precision: 2)}" ],
          [ "Deck sales this month", "$#{number_with_precision(@deck_sales_this_month, precision: 2)}" ]
        ] %>
  </div>
</div>

<div class="mb-6 grid gap-6 lg:grid-cols-3">
  <%= render "admin/shared/table", title: "Recent purchases", link: [ "All", admin_presentations_path ],
             rows: @recent_purchases.first(6), empty: "No recent purchases.",
             columns: [ "Deck", [ "Price", :right ] ] do |purchase| %>
    <%= admin_td(class: "max-w-0 w-full") do %>
      <span class="block truncate font-medium text-ink"><%= purchase.presentation.title %></span>
      <span class="block truncate text-xs text-mute"><%= purchase.user.full_name %></span>
    <% end %>
    <%= admin_td(align: :right) do %>
      <% if purchase.purchase_type == "direct" %>
        <span class="font-semibold tabular-nums"><%= number_to_currency(purchase.purchase_price) %></span>
      <% else %>
        <%= render "admin/shared/status_chip", label: "Credit", tone: :attention %>
      <% end %>
    <% end %>
  <% end %>

  <%= render "admin/shared/table", title: "Top presentations", link: [ "All", admin_presentations_path ],
             rows: @popular_presentations, empty: "No presentations yet.",
             columns: [ "Deck", [ "Sales", :right ] ] do |presentation| %>
    <%= admin_td(class: "max-w-0 w-full") do %>
      <span class="flex items-center gap-3">
        <span class="step-marker"><%= @popular_presentations.to_a.index(presentation) + 1 %></span>
        <span class="min-w-0">
          <%= link_to presentation.title, admin_presentation_path(presentation), class: "block truncate font-medium text-ink hover:underline underline-offset-4" %>
          <span class="block text-xs text-mute tabular-nums"><%= number_to_currency(presentation.user_presentations.where(purchase_type: "direct").sum(:purchase_price)) %></span>
        </span>
      </span>
    <% end %>
    <%= admin_td(presentation.user_presentations.count, align: :right) %>
  <% end %>

  <%# Plan distribution: one ruled row per plan with a proportional bar. %>
  <section class="card p-5 sm:p-6">
    <h2 class="text-lg font-semibold text-ink">Plan distribution</h2>
    <% if @plan_breakdown.any? %>
      <% total_subs = @plan_breakdown.values.sum %>
      <p class="mt-1 text-sm text-mute"><span class="font-semibold tabular-nums text-ink"><%= total_subs %></span> total</p>
      <ul class="mt-4 divide-y divide-hairline">
        <% @plan_breakdown.each do |plan, count| %>
          <% share = count.to_f / total_subs * 100 %>
          <li class="py-3">
            <div class="flex items-baseline justify-between gap-4 text-sm">
              <span class="font-medium text-ink"><%= plan.humanize %></span>
              <span class="tabular-nums text-gray-900"><%= count %> (<%= number_to_percentage(share, precision: 0) %>)</span>
            </div>
            <div class="mt-2 h-1.5 rounded-full bg-paper" aria-hidden="true">
              <div class="h-1.5 rounded-full bg-ink" style="width: <%= share.round(1) %>%"></div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-base text-mute">No active subscriptions.</p>
    <% end %>
  </section>
</div>

<%= render "admin/shared/table", title: "Recent users", link: [ "View all", admin_users_path ],
           rows: @recent_users, empty: "No recent users.",
           columns: [ "Member", "Email", [ "Joined", :right ] ] do |user| %>
  <%= admin_td do %>
    <%= link_to admin_user_path(user), class: "flex items-center gap-3 font-medium text-ink hover:underline underline-offset-4" do %>
      <%= avatar(user, size: 32) %>
      <span class="max-w-[14rem] truncate"><%= user.full_name %></span>
    <% end %>
  <% end %>
  <%= admin_td(class: "text-mute") do %>
    <span class="block max-w-[16rem] truncate"><%= user.email %></span>
  <% end %>
  <%= admin_td(user.created_at.strftime("%b %d, %Y"), align: :right, class: "text-mute") %>
<% end %>
