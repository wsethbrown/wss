<div class="mx-auto max-w-2xl">
  <%= render "admin/shared/page_header", title: "Invite a member",
             lede: "Creates their account and emails a claim link. Once they accept, they sign in like anyone else with a magic link or Google.",
             back: [ "Users", admin_users_path ] %>

  <%= form_with url: admin_invitations_path, scope: :invitation, local: true do |form| %>
    <%= render "admin/shared/form_card" do %>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :first_name, "First name", class: admin_label_class %>
          <%= form.text_field :first_name, value: (@invitation || {})[:first_name], required: true, class: admin_field_class %>
        </div>
        <div>
          <%= form.label :last_name, "Last name", class: admin_label_class %>
          <%= form.text_field :last_name, value: (@invitation || {})[:last_name], required: true, class: admin_field_class %>
        </div>
      </div>
      <div>
        <%= form.label :email, "Email", class: admin_label_class %>
        <%= form.email_field :email, value: (@invitation || {})[:email], required: true, class: admin_field_class %>
      </div>
      <div class="flex flex-wrap gap-3 border-t border-hairline pt-5">
        <%= form.submit "Send invitation", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_users_path, class: "btn btn-secondary" %>
      </div>
      <p class="text-sm text-mute">
        The claim link works for 14 days. You can re-send it from the member's page if it lapses.
      </p>
    <% end %>
  <% end %>
</div>
