<% content_for :title, "Activity Details - Admin" %>

<div class="max-w-4xl">
  <%= render "admin/shared/page_header", title: "Activity details", lede: "Activity ##{@activity.id}",
             back: [ "Activities", admin_activities_path ] do %>
    <%= link_to "View user profile", admin_user_path(@activity.user), class: "btn btn-primary" %>
  <% end %>

  <% rows = [
       [ "Activity type", render("admin/shared/status_chip", label: @activity.activity_description, tone: :attention) ],
       [ "Timestamp", @activity.created_at.strftime("%B %d, %Y at %I:%M %p %Z") ],
       [ "User", capture { %>
         <span class="inline-flex items-center gap-3 sm:justify-end">
           <%= avatar(@activity.user, size: 40) %>
           <span class="text-left"><%= link_to @activity.user.full_name, admin_user_path(@activity.user), class: admin_link_class %><span class="block text-xs font-normal text-mute"><%= @activity.user.email %></span></span>
         </span>
       <% } ] ] %>
  <% if @activity.trackable_name %>
    <% related = if @activity.trackable
                   case @activity.trackable_type
                   when "Presentation" then link_to(@activity.trackable_name, admin_presentation_path(@activity.trackable), class: admin_link_class)
                   when "Society" then link_to(@activity.trackable_name, society_path(@activity.trackable), class: admin_link_class)
                   else @activity.trackable_name
                   end
                 else
                   safe_join([ @activity.trackable_name, " ", content_tag(:span, "(deleted)", class: "text-mute") ])
                 end %>
    <% rows << [ "Related #{@activity.trackable_type}", related ] %>
  <% end %>
  <div class="space-y-6">
    <%= render "admin/shared/detail_panel", title: "Overview", rows: rows %>

    <%= render "admin/shared/detail_panel", title: "Technical details", rows: [
      [ "IP address", content_tag(:span, @activity.ip_address || "Not recorded", class: "font-mono") ],
      [ "User agent", content_tag(:span, @activity.user_agent || "Not recorded", class: "break-all font-mono text-xs") ],
      [ "Activity ID", content_tag(:span, "##{@activity.id}", class: "font-mono") ]
    ] %>

    <% if @activity.metadata.present? && @activity.metadata.any? %>
      <%= render "admin/shared/detail_panel", title: "Additional data", rows: @activity.metadata.map { |key, value|
        [ key.humanize, (value.is_a?(Array) ? value.join(", ") : value.is_a?(Hash) ? value.to_json : value.to_s) ]
      } %>
    <% end %>

    <section class="card p-5 sm:p-6">
      <h2 class="mb-3 text-lg font-semibold text-ink">Related activities</h2>
      <p class="mb-2 text-sm text-mute">Recent activities by this user</p>
      <% recent_activities = @activity.user.activity_logs.where.not(id: @activity.id).recent.limit(5) %>
      <% if recent_activities.any? %>
        <ul class="divide-y divide-hairline">
          <% recent_activities.each do |activity| %>
            <li class="flex flex-wrap items-center justify-between gap-2 py-3">
              <div class="text-sm">
                <span class="font-medium text-gray-900"><%= activity.activity_description %></span>
                <% if activity.trackable_name %>- <span class="text-mute"><%= activity.trackable_name %></span><% end %>
              </div>
              <div class="flex items-center gap-4 text-sm text-mute">
                <span><%= activity.created_at.strftime("%b %d at %I:%M %p") %></span>
                <%= link_to "View", admin_activity_path(activity), class: admin_link_class %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-mute">No other recent activities</p>
      <% end %>
    </section>
  </div>
</div>
