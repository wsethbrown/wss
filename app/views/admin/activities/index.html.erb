<% content_for :title, "Activity - Admin" %>

<%= render "admin/shared/page_header", title: "User activity", lede: "Monitor user actions and system events" %>

<%= render "admin/shared/stats", stats: [
  { label: "Activities today", value: @total_activities_today },
  { label: "Active users today", value: @active_users_today },
  { label: "Most common activity",
    value: (@most_common_activity ? (ActivityLog::ACTIVITY_TYPES[@most_common_activity[0].to_sym] || @most_common_activity[0].humanize) : "No activities yet") }
] %>

<%= render "admin/shared/filter_bar", url: admin_activities_path, clear: admin_activities_path, submit: "Apply filters" do |form| %>
  <div>
    <%= form.label :search, "Search", class: admin_label_class %>
    <%= form.text_field :search, value: params[:search], placeholder: "Search activities...", class: admin_field_class %>
  </div>
  <div>
    <%= form.label :activity_type, "Activity type", class: admin_label_class %>
    <%= form.select :activity_type,
        options_for_select([ [ "All activities", "" ] ] + ActivityLog::ACTIVITY_TYPES.map { |k, v| [ v, k ] }, params[:activity_type]),
        {}, { class: admin_field_class } %>
  </div>
  <div>
    <%= form.label :date_range, "Date range", class: admin_label_class %>
    <%= form.select :date_range,
        options_for_select([ [ "All time", "" ], [ "Today", "today" ], [ "This week", "week" ], [ "This month", "month" ] ], params[:date_range]),
        {}, { class: admin_field_class } %>
  </div>
  <div>
    <p class="<%= admin_label_class %>">Specific user</p>
    <% if @selected_user %>
      <%= form.hidden_field :user_id, value: @selected_user.id %>
      <div class="flex min-h-11 items-center gap-3">
        <span class="text-sm text-gray-900"><%= @selected_user.full_name %></span>
        <%= link_to "Clear", admin_activities_path, class: "text-sm #{admin_link_class}" %>
      </div>
    <% else %>
      <p class="flex min-h-11 items-center text-sm text-mute">All users</p>
    <% end %>
  </div>
<% end %>

<%= render "admin/shared/table", rows: @activities, paginate: true,
      columns: [ "When", "User", "Activity", "IP", [ "", :right ] ],
      empty: ((params[:search].present? || params[:activity_type].present? || params[:date_range].present?) ? "No activities match your filters." : "No activities have been logged yet.") do |activity| %>
  <%= admin_td(activity.created_at.strftime("%b %d, %Y at %I:%M %p"), class: "whitespace-nowrap text-mute") %>
  <%= admin_td do %>
    <div class="flex items-center gap-3">
      <%= avatar(activity.user, size: 32) %>
      <%= link_to activity.user.full_name, admin_user_path(activity.user), class: "max-w-[12rem] truncate #{admin_link_class}" %>
    </div>
  <% end %>
  <%= admin_td do %>
    <span class="text-gray-900"><%= activity.activity_description %></span>
    <% if activity.trackable_name %>
      <span class="font-medium text-ink">"<%= activity.trackable_name %>"</span>
    <% end %>
    <% if activity.metadata.present? && activity.metadata.any? %>
      <div class="mt-1.5 flex flex-wrap gap-1.5">
        <% activity.metadata.except("ip_address", "user_agent").each do |key, value| %>
          <span class="inline-block rounded-lg bg-paper px-2 py-1 text-xs text-mute"><%= key.humanize %>: <%= value %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <%= admin_td(activity.ip_address.presence || "—", class: "whitespace-nowrap text-mute") %>
  <%= admin_td(align: :right) do %>
    <%= link_to "View details →", admin_activity_path(activity), class: admin_link_class %>
  <% end %>
<% end %>
