<% content_for :title, "Users - Admin" %>

<%= render "admin/shared/page_header", title: "Users", lede: "Search and manage all users in the system" do %>
  <%= link_to "Invite a member", new_admin_invitation_path, class: "btn btn-primary" %>
<% end %>

<%= render "admin/shared/stats", stats: [
  { label: "Total users", value: @total_users },
  { label: "Active subscriptions", value: @active_subscriptions },
  { label: "Total credits", value: @total_credits }
] %>

<%= render "admin/shared/filter_bar", url: admin_users_path, clear: admin_users_path do |form| %>
  <div class="sm:col-span-2">
    <%= form.label :search, "Search users", class: admin_label_class %>
    <%= form.text_field :search, value: params[:search], placeholder: "Search by name, email, or ID...", class: admin_field_class %>
  </div>
  <div>
    <%= form.label :subscription_status, "Subscription status", class: admin_label_class %>
    <%= form.select :subscription_status,
        options_for_select([ [ "All statuses", "" ], [ "Active", "active" ], [ "Inactive", "inactive" ], [ "Canceled", "canceled" ] ], params[:subscription_status]),
        {}, { class: admin_field_class } %>
  </div>
  <div>
    <%= form.label :sort, "Sort by", class: admin_label_class %>
    <%= form.select :sort,
        options_for_select([ [ "Newest first", "newest" ], [ "Oldest first", "oldest" ], [ "Name", "name" ], [ "Most credits", "credits" ] ], params[:sort]),
        {}, { class: admin_field_class } %>
  </div>
<% end %>

<%= render "admin/shared/table", rows: @users, paginate: true,
      columns: [ "User", "Contact", "Subscription", [ "Credits", :right ], "Joined", [ "", :right ] ],
      empty: (params[:search].present? ? "No users match your search criteria." : "No users in the system yet.") do |user| %>
  <%# min-w-0 + truncate: an Apple private-relay signup can land an unbreakable
      40-char email in BOTH name fields, which used to widen the table. %>
  <%= admin_td do %>
    <div class="flex items-center gap-3">
      <%= avatar(user, size: 40) %>
      <div class="min-w-0 max-w-[11rem]">
        <div class="truncate font-medium text-gray-900" title="<%= user.full_name %>">
          <%= user.full_name %>
          <% if user.invitation_sent_at.present? && user.invitation_accepted_at.nil? %>
            <%= render "admin/shared/status_chip", label: "Invited", tone: :attention %>
          <% end %>
        </div>
        <div class="text-xs text-mute">ID: <%= user.id %></div>
      </div>
    </div>
  <% end %>
  <%= admin_td do %>
    <div class="max-w-[13rem] truncate" title="<%= user.email %>"><%= user.email %></div>
  <% end %>
  <%= admin_td do %>
    <% if user.subscription_status == "active" %>
      <%= render "admin/shared/status_chip", label: "Active", tone: :ok %>
      <div class="mt-1 text-xs text-mute"><%= user.subscription_plan %></div>
    <% elsif user.subscription_status == "canceled" %>
      <%= render "admin/shared/status_chip", label: "Canceled", tone: :problem %>
    <% else %>
      <%= render "admin/shared/status_chip", label: "No subscription", tone: :attention %>
    <% end %>
  <% end %>
  <%= admin_td(user.credits, align: :right) %>
  <%= admin_td(user.created_at.strftime("%b %d, %Y"), class: "whitespace-nowrap text-mute") %>
  <%= admin_td(align: :right) do %>
    <%= link_to "View", admin_user_path(user), class: "mr-3 #{admin_link_class}" %>
    <%= link_to "Edit", edit_admin_user_path(user), class: admin_link_class %>
  <% end %>
<% end %>
