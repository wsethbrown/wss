<% content_for :title, "#{@user.full_name} - Admin" %>

<%= render "admin/shared/page_header", title: @user.full_name, lede: "User details", back: [ "Users", admin_users_path ] do %>
  <%= link_to "Edit user", edit_admin_user_path(@user), class: "btn btn-primary" %>
<% end %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <%= render "admin/shared/detail_panel", title: "User information", rows: [
      [ "Email", @user.email ],
      [ "Name", @user.full_name ],
      [ "Joined", @user.created_at.strftime("%B %d, %Y") ],
      [ "Authentication", (@user.provider.present? ? @user.provider.humanize : "Email/Password") ]
    ] %>

    <section class="card p-5 sm:p-6">
      <h2 class="mb-3 text-lg font-semibold text-ink">Recent purchases</h2>
      <% if @recent_purchases.any? %>
        <ul class="divide-y divide-hairline">
          <% @recent_purchases.each do |purchase| %>
            <li class="flex items-center justify-between gap-4 py-3">
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900"><%= purchase.presentation.title %></p>
                <p class="text-xs text-mute"><%= purchase.purchase_type.capitalize %> • <%= purchase.created_at.strftime("%b %d, %Y") %></p>
              </div>
              <% if purchase.purchase_type == "direct" %>
                <span class="text-sm tabular-nums text-gray-900">$<%= purchase.purchase_price || purchase.presentation.price %></span>
              <% else %>
                <span class="text-sm text-mute">1 Credit</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-mute">No purchases yet.</p>
      <% end %>
    </section>

    <section class="card p-5 sm:p-6">
      <h2 class="mb-3 text-lg font-semibold text-ink">Society memberships</h2>
      <% if @society_memberships.any? %>
        <ul class="divide-y divide-hairline">
          <% @society_memberships.each do |membership| %>
            <li class="flex items-center justify-between gap-4 py-3">
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900"><%= membership.society.name %></p>
                <p class="text-xs text-mute"><%= membership.role.capitalize %> • Joined <%= membership.created_at.strftime("%b %d, %Y") %></p>
              </div>
              <%= render "admin/shared/status_chip", label: membership.status.capitalize,
                         tone: (membership.status == "active" ? :ok : :attention) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-mute">Not a member of any societies.</p>
      <% end %>
    </section>
  </div>

  <div class="space-y-6">
    <section class="card p-5 sm:p-6">
      <h2 class="mb-4 text-lg font-semibold text-ink">Profile picture</h2>
      <div class="flex justify-center"><%= avatar(@user, size: 128) %></div>
    </section>

    <% sub_status = @user.has_active_subscription? ? render("admin/shared/status_chip", label: "Active", tone: :ok) : render("admin/shared/status_chip", label: "None", tone: :attention) %>
    <% sub_rows = [ [ "Status", sub_status ] ] %>
    <% if @user.has_active_subscription? %>
      <% sub_rows << [ "Plan", @user.subscription_plan_display ] %>
      <% sub_rows << [ "Renews", @user.subscription_ends_at&.strftime("%B %d, %Y") || "N/A" ] %>
    <% end %>
    <% sub_rows << [ "Credits", (@user.credits || 0).to_s ] %>
    <%= render "admin/shared/detail_panel", title: "Subscription", rows: sub_rows do %>
      <% if @user.has_active_subscription? %>
        <%= render "admin/shared/confirm_button", label: "Cancel subscription", url: cancel_admin_subscription_path(@user),
                   method: :post, variant: :button,
                   confirm: "Are you sure you want to cancel #{@user.full_name}'s subscription?" %>
      <% end %>
    <% end %>

    <%= render "role_card", user: @user %>

    <% if @user.invitation_sent_at.present? && @user.invitation_accepted_at.nil? %>
      <section class="card p-5 sm:p-6">
        <h2 class="mb-2 text-lg font-semibold text-ink">Invitation pending</h2>
        <p class="mb-4 text-sm text-mute">
          Invited <%= time_ago_in_words(@user.invitation_sent_at) %> ago<%= " by #{@user.invited_by.full_name}" if @user.invited_by %>.
          They haven't accepted yet; the link works for 14 days.
        </p>
        <%= button_to "Re-send invitation", resend_invitation_admin_user_path(@user), method: :post, class: "btn btn-secondary w-full" %>
      </section>
    <% end %>
  </div>
</div>
