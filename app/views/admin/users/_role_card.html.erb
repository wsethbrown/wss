<%# The user's admin tier + the promote/demote control. Rendered on both the
    user view and edit pages (outside the main form; nested forms are invalid).
    Server-side guards mirror the UI: full admins only, never your own role. %>
<section class="card p-5 sm:p-6">
  <h2 class="mb-4 text-lg font-semibold text-ink">Role</h2>
  <% case user.admin_role %>
  <% when "full" %>
    <%= render "admin/shared/status_chip", label: "Administrator (full)", tone: :ok %>
  <% when "limited" %>
    <%= render "admin/shared/status_chip", label: "Administrator (no delete)", tone: :ok %>
  <% else %>
    <%= render "admin/shared/status_chip", label: "Regular user", tone: :attention %>
  <% end %>

  <% if current_user.admin_role_full? %>
    <% if user == current_user %>
      <p class="mt-4 text-sm text-mute">You can't change your own role.</p>
    <% else %>
      <%# Stacked, full-width controls: the sidebar card is too narrow for a
          select + button row. %>
      <%= form_with url: update_role_admin_user_path(user), method: :patch, local: true, class: "mt-4 space-y-3" do %>
        <%= select_tag :admin_role,
            options_for_select([ [ "Regular user", "none" ], [ "Administrator (no delete)", "limited" ], [ "Administrator (full)", "full" ] ], user.admin_role),
            class: admin_field_class, "aria-label": "Admin role" %>
        <%= submit_tag "Update role",
            data: { turbo_confirm: "Change this user's admin role?" },
            class: "btn btn-primary w-full cursor-pointer" %>
      <% end %>
      <p class="mt-3 text-sm text-mute">No-delete admins have every admin power except permanently deleting records.</p>
    <% end %>
  <% end %>
</section>
