<% content_for :title, "Edit #{@user.full_name} - Admin" %>

<div class="max-w-4xl">
  <%= render "admin/shared/page_header", title: "Edit user", lede: "Update user information and subscription details",
             back: [ @user.full_name, admin_user_path(@user) ] %>

  <%= form_with model: @user, url: admin_user_path(@user), local: true do |form| %>
    <% if @user.errors.any? %>
      <div class="mb-6 rounded-2xl bg-red-50 p-4" role="alert">
        <h3 class="mb-2 text-sm font-medium text-red-700">There were <%= pluralize(@user.errors.count, "error") %> with your submission:</h3>
        <ul class="list-inside list-disc text-sm text-red-700">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-6">
      <%= render "admin/shared/form_card", title: "Basic information" do %>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          <div>
            <%= form.label :first_name, class: admin_label_class %>
            <%= form.text_field :first_name, class: admin_field_class %>
          </div>
          <div>
            <%= form.label :last_name, class: admin_label_class %>
            <%= form.text_field :last_name, class: admin_field_class %>
          </div>
          <div class="md:col-span-2">
            <%# Email is the sign-in credential: only full admins may change it, and
                never on another admin's record (see Admin::UsersController#update). %>
            <% if email_editable?(@user) %>
              <%= form.label :email, class: admin_label_class %>
              <%= form.email_field :email, class: admin_field_class %>
              <p class="mt-1 text-sm text-mute">Changing the email signs the member out of remembered sessions and cancels any pending sign-in or invitation link.</p>
            <% else %>
              <p class="<%= admin_label_class %>">Email</p>
              <p class="text-gray-900"><%= @user.email %></p>
            <% end %>
          </div>
          <div class="md:col-span-2">
            <%= form.label :bio, class: admin_label_class %>
            <%= form.text_area :bio, rows: 4, class: admin_field_class %>
          </div>
        </div>
      <% end %>

      <%# Credits are deliberately NOT editable here: a direct write would bypass
          the CreditTransaction ledger and desync balance from history. Adjust
          credits from Admin → Credits, which records a ledger entry. %>
      <section class="card p-5 sm:p-7">
        <h2 class="mb-2 text-xl font-semibold text-ink">Credits</h2>
        <p class="text-gray-900">Current balance: <span class="font-semibold tabular-nums"><%= @user.credits %></span></p>
        <%= link_to "Adjust via the credit ledger →", adjust_admin_credit_path(@user), class: "mt-3 inline-flex min-h-11 items-center #{admin_link_class}" %>
      </section>

      <div class="flex flex-wrap items-center gap-3">
        <%= form.submit "Save changes", class: "btn btn-primary cursor-pointer" %>
        <%= link_to "Cancel", admin_user_path(@user), class: "btn btn-secondary" %>
      </div>
    </div>
  <% end %>

  <%# Role + subscription management sit outside the form: they post to their own endpoints. %>
  <div class="mt-8 space-y-6">
    <%= render "role_card", user: @user %>

    <section class="card p-5 sm:p-7">
      <h2 class="mb-4 text-xl font-semibold text-ink">Subscription management</h2>

      <% if @user.stripe_customer_id.present? %>
        <% lookup = stripe_subscription_lookup %>
        <% current_sub = lookup[:subscription] %>
        <% if lookup[:error] %>
          <div class="rounded-2xl bg-red-50 p-4" role="alert">
            <p class="text-sm font-medium text-red-700">Stripe Error</p>
          </div>
        <% else %>
          <% if current_sub %>
            <% if @user.subscription_paused? %>
              <%= render "admin/shared/detail_panel", rows: [
                    [ "Status", render("admin/shared/status_chip", label: "Paused", tone: :attention) ],
                    [ "ID", current_sub.id ],
                    [ "Plan", @user.subscription_plan || "Unknown" ],
                    [ "Paused on", @user.subscription_paused_at.strftime("%B %d, %Y at %I:%M %p") ],
                    [ "Will auto-resume", (@user.subscription_paused_at + 1.month).strftime("%B %d, %Y") ] ] %>
            <% elsif current_sub.status == "trialing" %>
              <%= render "admin/shared/detail_panel", rows: [
                    [ "Status", render("admin/shared/status_chip", label: "Trial", tone: :attention) ],
                    [ "ID", current_sub.id ],
                    [ "Plan", @user.subscription_plan || "Unknown" ],
                    [ "Trial ends", Time.at(current_sub.trial_end).strftime("%B %d, %Y at %I:%M %p") ] ] %>
            <% else %>
              <%= render "admin/shared/detail_panel", rows: [
                    [ "Status", render("admin/shared/status_chip", label: current_sub.status.capitalize, tone: :ok) ],
                    [ "ID", current_sub.id ],
                    [ "Plan", @user.subscription_plan || "Unknown" ],
                    [ "Next billing", Time.at(current_sub.current_period_end).strftime("%B %d, %Y") ] ] %>
            <% end %>

            <div class="mt-5 flex flex-wrap gap-3">
              <% if @user.subscription_can_be_paused? %>
                <%= button_to "Pause subscription", pause_admin_subscription_path(@user), method: :post,
                    data: { turbo_confirm: "This will pause billing for this subscription. Are you sure?" },
                    class: "btn btn-secondary cursor-pointer" %>
              <% elsif @user.subscription_can_be_resumed? %>
                <%= button_to "Resume subscription", resume_admin_subscription_path(@user), method: :post,
                    data: { turbo_confirm: "This will resume billing for this subscription. Are you sure?" },
                    class: "btn btn-primary cursor-pointer" %>
              <% end %>

              <%= render "admin/shared/confirm_button", label: "Cancel Subscription", url: cancel_admin_subscription_path(@user),
                         method: :post, variant: :button,
                         confirm: "This will immediately cancel the subscription. Are you sure?" %>

              <%= button_to "Mark as past due", admin_user_path(@user), method: :patch,
                  params: { user: { subscription_status: 'past_due' } },
                  data: { turbo_confirm: "This will only update the local status. Continue?" },
                  class: "btn btn-secondary cursor-pointer" %>
            </div>
          <% else %>
            <div class="mb-6 rounded-2xl bg-paper p-4">
              <p class="mb-1 text-sm font-medium text-ink">No Active Subscription</p>
              <p class="text-sm text-mute">This user does not have an active Stripe subscription.</p>
            </div>

            <p class="mb-3 text-sm font-medium text-ink">Create New Subscription:</p>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
              <%# Labels come from SubscriptionProducts (same source as /membership); the create action charges by Stripe price id. %>
              <% billed = { "monthly" => "monthly", "quarterly" => "quarterly", "yearly" => "annually" } %>
              <% SubscriptionProducts.all.select { |p| billed.key?(p[:id].to_s) }.each do |product| %>
                <% plan = product[:id].to_s; name = plan.capitalize; price = number_to_currency(product[:price] / 100.0) %>
                <div class="rounded-[18px] border border-hairline p-4">
                  <div class="mb-2 flex items-center justify-between gap-2">
                    <h3 class="font-medium text-ink"><%= name %></h3>
                    <% if plan == "quarterly" %><%= render "admin/shared/status_chip", label: "Popular", tone: :attention %><% end %>
                  </div>
                  <p class="mb-3 font-display text-2xl font-semibold tabular-nums text-ink"><%= price %><span class="text-sm font-normal text-mute">/mo</span></p>
                  <p class="mb-3 -mt-2 text-sm text-mute">billed <%= billed[plan] %></p>
                  <%= button_to "Create #{name}", admin_create_subscription_path, method: :post,
                      params: { user_id: @user.id, plan: plan },
                      data: { turbo_confirm: "Create a #{plan} subscription for #{@user.full_name}?" },
                      class: "btn btn-secondary w-full cursor-pointer" %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="rounded-2xl bg-paper p-4">
          <p class="mb-1 text-sm font-medium text-ink">No Stripe Customer ID</p>
          <p class="text-sm text-mute">This user needs to create a subscription through the normal checkout flow first.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
