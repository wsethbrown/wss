<% content_for :title, "Download Analytics - Admin" %>
<% type_names = {
     "sneak_peek" => "Sneak Peek", "full_presentation" => "Full Presentation", "speaker_notes" => "Speaker Notes",
     "outline" => "Outline", "recommendations" => "Recommendations"
   } %>

<%= render "admin/shared/page_header", title: "Download analytics", lede: "Which decks and files members download." do %>
  <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Date range">
    <% %w[today week month all].each do |range| %>
      <%= link_to range.capitalize, admin_downloads_analytics_path(date_range: range),
          "aria-current": (@date_range == range ? "true" : nil),
          class: "inline-flex min-h-11 items-center rounded-xl border px-3.5 text-sm font-medium transition #{@date_range == range ? 'border-ink bg-ink text-cream' : 'border-hairline bg-white text-ink hover:bg-whiskey-100'}" %>
    <% end %>
  </div>
<% end %>

<%= render "admin/shared/stats", stats: [
  { label: "Total downloads", value: number_with_delimiter(@total_downloads) },
  { label: "Unique users", value: number_with_delimiter(@unique_users) },
  { label: "Avg downloads/user", value: (@unique_users > 0 ? number_with_precision(@total_downloads.to_f / @unique_users, precision: 1) : "0") }
] %>

<div class="mb-6">
  <%= render "admin/analytics/bars", title: "Downloads by type",
             items: type_names.map { |type, name| [ name, @downloads_by_type[type] || 0 ] },
             total: @total_downloads %>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <%= render "admin/shared/table", title: "Most downloaded presentations", rows: @popular_presentations,
        columns: [ "#", "Presentation", [ "Downloads", :right ] ], empty: "No downloads in this range." do |(presentation, count)| %>
    <% index = @popular_presentations.index([ presentation, count ]).to_i %>
    <%= admin_td("#{index + 1}", class: "text-mute") %>
    <%= admin_td do %>
      <%= link_to presentation.title, admin_presentation_downloads_analytics_path(presentation), class: "block max-w-[14rem] truncate #{admin_link_class}" %>
      <p class="text-xs text-mute">by <%= presentation.author.full_name %></p>
    <% end %>
    <%= admin_td(number_with_delimiter(count), align: :right) %>
  <% end %>

  <%= render "admin/shared/table", title: "Recent downloads", rows: @recent_downloads,
        columns: [ "Member", "File", [ "When", :right ] ], empty: "No downloads yet." do |download| %>
    <%= admin_td do %>
      <div class="flex items-center gap-3">
        <%= avatar(download.user, size: 32) %>
        <div class="min-w-0">
          <p class="max-w-[10rem] truncate font-medium text-gray-900"><%= download.user.full_name %></p>
          <p class="max-w-[10rem] truncate text-xs text-mute"><%= download.presentation.title %></p>
        </div>
      </div>
    <% end %>
    <%= admin_td(download.file_type.humanize) %>
    <%= admin_td("#{time_ago_in_words(download.downloaded_at)} ago", align: :right, class: "text-mute") %>
  <% end %>
</div>
