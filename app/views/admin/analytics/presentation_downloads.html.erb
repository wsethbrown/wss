<% content_for :title, "#{@presentation.title} - Download Analytics" %>
<% type_names = {
     "sneak_peek" => "Sneak Peek", "full_presentation" => "Full Presentation", "speaker_notes" => "Speaker Notes",
     "outline" => "Outline", "recommendations" => "Recommendations"
   } %>
<% total = @downloads.count %>

<%= render "admin/shared/page_header", title: "#{@presentation.title} - Download analytics",
           lede: "by #{@presentation.author.full_name}", back: [ "Analytics", admin_downloads_analytics_path ] %>

<%= render "admin/shared/stats", stats: [
  { label: "Total downloads", value: number_with_delimiter(total) },
  { label: "Unique downloaders", value: number_with_delimiter(@unique_downloaders) },
  { label: "Downloads today", value: number_with_delimiter(@downloads.today.count) }
] %>

<div class="mb-6">
  <%= render "admin/analytics/bars", title: "Downloads by file type",
             items: type_names.map { |type, name| [ name, @downloads_by_type[type] || 0 ] },
             total: total %>
</div>

<%= render "admin/shared/table", title: "Recent downloads", rows: @recent_downloads,
      columns: [ "User", "File type", "Downloaded", "IP address" ], empty: "No downloads yet." do |download| %>
  <%= admin_td do %>
    <div class="flex items-center gap-3">
      <%= avatar(download.user, size: 32) %>
      <div class="min-w-0">
        <p class="max-w-[14rem] truncate font-medium text-gray-900"><%= download.user.full_name %></p>
        <p class="max-w-[14rem] truncate text-xs text-mute"><%= download.user.email %></p>
      </div>
    </div>
  <% end %>
  <%= admin_td(download.file_type.humanize) %>
  <%= admin_td(download.downloaded_at.strftime("%b %d, %Y %l:%M %p"), class: "whitespace-nowrap") %>
  <%= admin_td(download.ip_address || "N/A", class: "text-mute") %>
<% end %>
