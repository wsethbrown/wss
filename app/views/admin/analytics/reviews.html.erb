<% content_for :title, "Reviews Analytics" %>

<%= render "admin/shared/page_header", title: "Reviews", lede: "The health of the tasting record at a glance." %>

<%= render "admin/shared/stats", stats: [
  { label: "Total reviews", value: @total_reviews, note: "#{@reviews_this_week} in the last 7 days" },
  { label: "Reviewers", value: @total_reviewers, note: "distinct tasters" },
  { label: "Bottles reviewed", value: @bottles_reviewed, note: "in the catalog" },
  { label: "Average rating", value: (@avg_rating ? "#{@avg_rating} / 5" : "n/a"), note: "across all reviews" }
] %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <%= render "admin/shared/table", title: "Most reviewed bottles", rows: @most_reviewed,
        columns: [ "#", "Bottle", [ "Reviews", :right ] ], empty: "No reviews yet." do |bottle| %>
    <%= admin_td(@most_reviewed.to_a.index(bottle).to_i + 1, class: "text-mute") %>
    <%= admin_td { link_to bottle.display_name, bottle_path(bottle), class: "block max-w-[16rem] truncate #{admin_link_class}" } %>
    <%= admin_td(bottle.reviews_count, align: :right, class: "font-semibold") %>
  <% end %>

  <%= render "admin/shared/table", title: "Top rated bottles", rows: @top_rated,
        columns: [ "#", "Bottle", [ "Rating (reviewers)", :right ] ], empty: "Not enough reviews yet." do |bottle| %>
    <%= admin_td(@top_rated.to_a.index(bottle).to_i + 1, class: "text-mute") %>
    <%= admin_td { link_to bottle.display_name, bottle_path(bottle), class: "block max-w-[16rem] truncate #{admin_link_class}" } %>
    <%= admin_td(align: :right, class: "font-semibold") do %><%= bottle.avg_rating.to_f.round(1) %> <span class="font-normal text-mute">(<%= bottle.reviewers %>)</span><% end %>
  <% end %>

  <%= render "admin/shared/table", title: "Most active reviewers", rows: @active_reviewers,
        columns: [ "#", "Reviewer", [ "Reviews", :right ] ], empty: "No reviewers yet." do |user| %>
    <%= admin_td(@active_reviewers.to_a.index(user).to_i + 1, class: "text-mute") %>
    <%= admin_td(user.full_name.presence || user.email, class: "max-w-[16rem] truncate font-medium") %>
    <%= admin_td(user.reviews_count, align: :right, class: "font-semibold") %>
  <% end %>

  <%= render "admin/shared/table", title: "Recent reviews", rows: @recent_reviews,
        columns: [ "Bottle", "Reviewer", [ "Rating", :right ] ], empty: "No reviews yet." do |review| %>
    <%= admin_td { link_to review.bottle.display_name, review_path(review), class: "block max-w-[14rem] truncate #{admin_link_class}" } %>
    <%= admin_td(class: "text-mute") do %>
      <span class="block max-w-[12rem] truncate"><%= review.user.full_name.presence || review.user.email %></span>
      <span class="text-xs"><%= time_ago_in_words(review.created_at) %> ago</span>
    <% end %>
    <%= admin_td(review.rating, align: :right, class: "font-semibold") %>
  <% end %>
</div>
