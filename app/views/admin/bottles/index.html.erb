<% content_for :title, "Admin - Bottles" %>

<%# .size, not .count, with_score's custom SELECT list can't go inside COUNT() %>
<%= render "admin/shared/page_header", title: "Bottles", lede: "#{@bottles.size} bottles total" %>

<%= render "admin/shared/table", rows: @bottles,
           columns: [ "Bottle", [ "Reviews", :right ], "Label image" ],
           empty: "No bottles yet." do |bottle| %>
  <%= admin_td do %>
    <%= link_to bottle.name, admin_bottle_path(bottle), class: admin_link_class %>
  <% end %>
  <%= admin_td(bottle.reviews.count, align: :right) %>
  <%= admin_td do %>
    <% if bottle.pinned_label_image.attached? %>
      <%= render "admin/shared/status_chip", label: "Pinned", tone: :ok %>
    <% end %>
  <% end %>
<% end %>
