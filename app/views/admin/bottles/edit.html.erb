<% content_for :title, "Edit #{@bottle.name} - Admin" %>

<%= render "admin/shared/page_header", title: "Edit #{@bottle.name}", back: [ @bottle.name, admin_bottle_path(@bottle) ] %>

<div class="max-w-xl">
  <%= form_with model: @bottle, url: admin_bottle_path(@bottle), method: :patch, local: true do |form| %>
    <% if @bottle.errors.any? %>
      <div class="mb-6 rounded-2xl bg-red-50 px-5 py-4 text-sm font-medium text-red-700" role="alert">
        <%= @bottle.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= render "admin/shared/form_card" do %>
      <div>
        <%= form.label :name, "Bottle name", class: admin_label_class %>
        <%= form.text_field :name, class: admin_field_class %>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :distillery, class: admin_label_class %>
          <%= form.text_field :distillery, class: admin_field_class %>
        </div>
        <div>
          <%= form.label :region, class: admin_label_class %>
          <%= form.text_field :region, class: admin_field_class %>
        </div>
        <div>
          <%= form.label :style, class: admin_label_class %>
          <%= form.text_field :style, class: admin_field_class %>
        </div>
        <div>
          <%= form.label :abv, "ABV %", class: admin_label_class %>
          <%= form.number_field :abv, step: 0.1, min: 0, max: 99, class: admin_field_class %>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 border-t border-hairline pt-5">
        <%= form.submit "Save changes", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_bottle_path(@bottle), class: "btn btn-secondary" %>
      </div>
    <% end %>
  <% end %>
</div>
