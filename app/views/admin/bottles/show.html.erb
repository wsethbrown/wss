<% content_for :title, "#{@bottle.name} - Admin" %>

<%= render "admin/shared/page_header", title: @bottle.name, back: [ "Bottles", admin_bottles_path ] do %>
  <%= link_to "View bottle", bottle_path(@bottle), class: "btn btn-secondary min-h-11 py-2.5" %>
  <%= link_to "Edit bottle", edit_admin_bottle_path(@bottle), class: "btn btn-primary min-h-11 py-2.5" %>
<% end %>

<div class="space-y-6">
  <%# Label image %>
  <section class="card p-5 sm:p-6">
    <h2 class="mb-5 text-lg font-semibold text-ink">Label image</h2>

    <% if @bottle.pinned_label_image.attached? %>
      <div class="mb-5">
        <%= image_tag @bottle.pinned_label_image.variant(:thumb), class: "h-48 w-auto rounded-[18px] border border-hairline" %>
      </div>
      <div class="mb-5">
        <%= button_to "Unpin", unpin_image_admin_bottle_path(@bottle), method: :delete, class: "btn btn-secondary min-h-11 py-2.5" %>
      </div>
    <% else %>
      <p class="mb-5 text-mute">No pinned label image. The derived image (or placeholder) is showing.</p>
    <% end %>

    <div class="border-t border-hairline pt-5">
      <h3 class="mb-3 text-base font-semibold text-ink">Pin a new image</h3>
      <%= form_with url: pin_image_admin_bottle_path(@bottle), method: :patch, multipart: true, local: true do |f| %>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
          <%= f.file_field "bottle[pinned_label_image]", accept: "image/jpeg,image/jpg,image/png,image/gif,image/webp",
              class: "block w-full min-w-0 text-sm text-gray-900 file:mr-3 file:min-h-11 file:cursor-pointer file:rounded-2xl file:border file:border-hairline file:bg-white file:px-4 file:text-sm file:font-semibold file:text-ink sm:flex-1" %>
          <%= f.submit "Pin this image", class: "btn btn-primary shrink-0" %>
        </div>
      <% end %>
    </div>
  </section>

  <%# Pending corrections %>
  <% if @pending_edits.any? %>
    <section class="card p-5 sm:p-6">
      <h2 class="mb-5 text-lg font-semibold text-ink">Suggested corrections</h2>
      <% @pending_edits.each do |field, edits| %>
        <div class="mb-6 last:mb-0">
          <h3 class="mb-2 text-base font-semibold capitalize text-ink"><%= field %></h3>
          <div class="divide-y divide-hairline rounded-2xl border border-hairline">
            <% edits.group_by(&:proposed_value).each do |value, value_edits| %>
              <div class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <div class="min-w-0">
                  <p class="break-words font-medium text-ink"><%= value %></p>
                  <p class="mt-1 text-sm text-mute">
                    Proposed by <%= value_edits.map { |e| e.user.full_name }.to_sentence %>
                    (<%= pluralize(value_edits.size, "vote") %>)
                  </p>
                </div>
                <div class="flex shrink-0 flex-wrap gap-2">
                  <%= button_to "Apply", apply_admin_bottle_edit_path(@bottle, value_edits.first), method: :post,
                      class: "btn btn-primary min-h-11 py-2.5" %>
                  <%= button_to "Reject", admin_bottle_edit_path(@bottle, value_edits.first), method: :delete,
                      data: { turbo_confirm: "Reject this proposal?" },
                      class: "btn btn-secondary min-h-11 py-2.5" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# Reviews %>
  <section class="card p-5 sm:p-6">
    <h2 class="mb-2 text-lg font-semibold text-ink">Reviews</h2>

    <% if @reviews.any? %>
      <div class="divide-y divide-hairline">
        <% @reviews.each do |review| %>
          <div class="flex flex-col gap-4 py-5 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <h3 class="text-sm font-semibold text-ink"><%= review.user.full_name %></h3>
              <p class="mt-1 text-sm text-mute tabular-nums">
                <%= number_with_precision(review.rating, precision: 2, strip_insignificant_zeros: true) %> • <%= review.created_at.strftime("%b %d, %Y") %>
              </p>
              <% if review.notes.present? %>
                <p class="mt-2 text-sm text-gray-900"><%= truncate(review.notes, length: 200) %></p>
              <% end %>
              <% if review.images.attached? %>
                <div class="mt-3 flex flex-wrap gap-2">
                  <% review.images.each do |image| %>
                    <figure>
                      <%= image_tag image.variant(:thumb), class: "h-16 w-16 rounded-xl border border-hairline object-cover" %>
                    </figure>
                  <% end %>
                </div>
              <% end %>
            </div>
            <%# Both actions are permanent, so full admins only (the controller enforces it too). %>
            <% if current_user.can_delete? %>
              <div class="flex shrink-0 flex-wrap items-center gap-4">
                <% if review.images.attached? %>
                  <%= render "admin/shared/confirm_button", label: "Remove photos",
                             url: destroy_image_admin_bottle_review_path(@bottle, review),
                             confirm: "Remove every photo on this review? The text stays." %>
                <% end %>
                <%= render "admin/shared/confirm_button", label: "Delete review",
                           url: admin_bottle_review_path(@bottle, review),
                           confirm: "Delete this review?" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-mute">No reviews yet.</p>
    <% end %>
  </section>
</div>
