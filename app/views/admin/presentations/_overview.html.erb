<%# The Overview tab: what the deck is and whether it is ready, on one screen.
    Read-only, apart from the publish block's own forms (it sits outside
    #deck-form for that reason). Locals: presentation, slides, purchases %>
<% if (package_summary = flash[:package_summary]).present? %>
  <%= render "admin/presentations/package_summary", presentation: presentation, summary: package_summary %>
<% end %>

<% cover = slides.first || (presentation.featured_image.attached? ? presentation.featured_image : nil) %>
<% meta = [ presentation.category, presentation.difficulty, presentation.tag_names.presence ].compact %>
<section class="card flex flex-col gap-5 p-5 sm:flex-row sm:items-start sm:p-6">
  <% if cover %>
    <%= image_tag image_variant(cover, :card), alt: presentation.title,
                  class: "aspect-video w-full shrink-0 rounded-[18px] border border-hairline object-cover sm:w-52" %>
  <% end %>
  <div class="min-w-0 space-y-2">
    <h2 class="sr-only">Description</h2>
    <p class="text-gray-900"><%= presentation.description.presence || "No description provided." %></p>
    <% if meta.any? %>
      <p class="text-sm text-mute"><%= meta.join(" · ") %></p>
    <% end %>
  </div>
</section>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start">
  <%= render "admin/presentations/buyer_page_checklist", presentation: presentation, slides: slides %>

  <%= render "admin/presentations/publish_block", presentation: presentation, slides: slides %>

  <section class="card p-5 sm:p-6">
    <h2 class="mb-3 text-lg font-semibold text-ink">The pour list</h2>
    <% pours = presentation.pour_list.to_a %>
    <% if pours.any? %>
      <ul class="divide-y divide-hairline">
        <% pours.each do |pour| %>
          <li class="flex items-baseline justify-between gap-4 py-2.5 text-sm">
            <span class="min-w-0 break-words font-semibold text-ink"><%= pour.title %></span>
            <span class="shrink-0 text-mute tabular-nums"><%= pour.price %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
    <a href="#pane-pours" class="mt-3 inline-flex min-h-11 items-center text-sm <%= admin_link_class %>">Edit the pour list →</a>
  </section>

  <section class="card p-5 sm:p-6">
    <h2 class="mb-3 text-lg font-semibold text-ink">Files</h2>
    <dl class="divide-y divide-hairline">
      <% admin_deck_file_slots(presentation).reject { |s| s[:slot] == :featured_image }.each do |slot| %>
        <% attachments = slot[:multiple] ? presentation.public_send(slot[:slot]).attachments.sort_by(&:id) : [ presentation.public_send(slot[:slot]) ].select(&:attached?) %>
        <% next if attachments.empty? && slot[:slot] != :pdf_file %>
        <div class="flex flex-col gap-1 py-2.5 text-sm sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <dt class="shrink-0 text-mute"><%= slot[:label] %></dt>
          <dd class="min-w-0 break-words font-medium text-gray-900 sm:text-right">
            <% if attachments.empty? %>
              <span class="font-normal text-mute">not uploaded</span>
            <% else %>
              <% attachments.each do |attachment| %>
                <span class="block"><%= attachment.filename %> <span class="font-normal text-mute">(<%= number_to_human_size(attachment.byte_size) %>)</span></span>
              <% end %>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
    <a href="#pane-files" class="mt-3 inline-flex min-h-11 items-center text-sm <%= admin_link_class %>">Open or replace files →</a>
  </section>

  <%= render "admin/presentations/purchase_stats", purchases: purchases %>
</div>
