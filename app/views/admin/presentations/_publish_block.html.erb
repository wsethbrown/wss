<%# Publishing, on the Overview tab. Explicit and gated, never a form
    side-effect: the deck file must be attached and the slide previews
    rendered, and a $0 deck needs "This deck is free" ticked. The header's
    Publish button links here whenever it can't publish in one click.
    Its forms are separate from #deck-form (forms cannot nest).
    Locals: presentation, slides %>
<section id="publish" class="card scroll-mt-56 p-5 sm:p-6">
  <h2 class="mb-4 text-lg font-semibold text-ink">Actions</h2>
  <div class="space-y-3">
    <% if presentation.published? %>
      <% owners = presentation.user_presentations.size %>
      <% owners_line = owners.zero? ? "Nobody owns this deck yet." : "#{pluralize(owners, 'person')} #{owners == 1 ? 'owns' : 'own'} this deck and #{owners == 1 ? 'keeps' : 'keep'} it." %>
      <p class="text-sm text-mute">
        Unpublishing takes the deck out of the library and stops new sales. <%= owners_line %>
      </p>
      <%= button_to "Unpublish (back to draft)", unpublish_admin_presentation_path(presentation), method: :post,
          params: { tab: "overview" },
          form: { data: { turbo_confirm: "Unpublish #{presentation.title}? #{owners_line} It leaves the library and can't be bought." } },
          class: "btn btn-secondary w-full" %>
    <% elsif !presentation.pdf_file.attached? %>
      <div class="rounded-2xl border border-hairline bg-paper px-4 py-3 text-sm text-ink">
        <span class="font-semibold">Draft.</span> Attach the deck file
        (the presentation buyers download) in <a href="#pane-files" class="<%= admin_link_class %>">Files</a> to enable publishing.
      </div>
    <% elsif slides.any? %>
      <%= form_with url: publish_admin_presentation_path(presentation), method: :post, class: "space-y-3" do |f| %>
        <%= hidden_field_tag :tab, "overview", id: nil %>
        <% if presentation.free? %>
          <p class="text-sm text-ink">The price is <span class="font-semibold">$0</span>: published, anyone signed in can add it to their library for nothing.</p>
          <label class="flex min-h-11 items-center gap-3 text-sm font-medium text-ink">
            <%= f.check_box :free_confirmed, { class: "h-5 w-5 rounded border-hairline text-ink focus:ring-ink/30" }, "1", nil %>
            <span>This deck is free</span>
          </label>
        <% else %>
          <p class="text-sm text-ink">Publishes at <span class="font-semibold tabular-nums"><%= number_to_currency(presentation.price) %></span>.</p>
        <% end %>
        <%= f.submit "Publish to the library", class: "btn btn-primary w-full" %>
      <% end %>
    <% elsif presentation.slide_render_pending? %>
      <div class="rounded-2xl border border-hairline bg-paper px-4 py-3 text-sm text-ink">
        <span class="font-semibold">Rendering slide previews&hellip;</span>
        Usually under a minute. Publishing unlocks when they're ready, refresh to check.
      </div>
    <% else %>
      <div class="rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700">
        <span class="font-semibold">No slide previews.</span> The render didn't run
        or failed. Re-render below, then publish.
      </div>
    <% end %>

    <% if presentation.pdf_file.attached? && !presentation.slide_render_pending? %>
      <%= button_to "Re-render slide previews", render_slides_admin_presentation_path(presentation), method: :post,
          params: { tab: "overview" }, class: "btn btn-secondary w-full" %>
    <% end %>

    <% if current_user.can_delete? %>
      <div class="border-t border-hairline pt-3">
        <%= render "admin/shared/confirm_button", label: "Delete", url: admin_presentation_path(presentation),
                   confirm: "Are you sure you want to delete this deck?", variant: :button %>
      </div>
    <% end %>
  </div>
</section>
