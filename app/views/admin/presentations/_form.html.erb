<%# The new-deck form, one column. Every field group is the same partial the
    deck page (edit.html.erb) uses in its tabs, so there is one copy of each.
    After "Create draft" the admin lands on the deck page.
    Locals: presentation, submit_text %>
<%= form_with model: [ :admin, presentation ], local: true, html: { id: "deck-form" } do |form| %>
  <%= render "admin/presentations/errors", presentation: presentation %>

  <div class="mt-6 min-w-0 space-y-6">
    <%# The listing, with "What the customer sees" beside it from lg, as on
        the deck page's Listing tab (a new deck has no cover yet). %>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start"
         data-controller="deck-preview" data-deck-preview-url-value="<%= preview_admin_presentations_path %>"
         data-action="input->deck-preview#schedule change->deck-preview#schedule click->deck-preview#schedule">
      <div class="min-w-0 space-y-6">
        <%= render "admin/presentations/cover_fields", form: form, presentation: presentation %>
        <%= render "admin/presentations/takeaways_fields", form: form, presentation: presentation %>
        <%= render "admin/presentations/story_fields", form: form, presentation: presentation %>
        <%= render "admin/presentations/sections_fields", form: form, presentation: presentation %>
      </div>
      <%= render "admin/presentations/customer_preview", presentation: presentation, cover_image: nil, slides_count: 0 %>
    </div>
    <%= render "admin/presentations/files_fields", form: form, presentation: presentation %>

    <section class="card p-5 sm:p-7">
      <%= form.label :preview_slide_count, "Free preview, slides shown before the buy prompt", class: admin_label_class %>
      <%= form.number_field :preview_slide_count, min: 1, value: presentation.preview_slide_count || 3, class: "#{admin_field_class} !w-24" %>
      <p class="mt-1 text-xs text-mute">Non-buyers see the first N slides on the deck page; the last one fades into a &ldquo;get this deck&rdquo; prompt. Slide 1 is usually your title, so this replaces the old free-sample upload.</p>
    </section>

    <%= render "admin/presentations/pour_list_fields", form: form, presentation: presentation %>

    <div class="flex items-center gap-4 pb-2">
      <%= form.submit submit_text, class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_presentations_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
