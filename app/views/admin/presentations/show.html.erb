<% content_for :title, "#{@presentation.title} - Admin" %>

<%= render "admin/shared/page_header", title: @presentation.title,
           lede: "Created by #{@presentation.author&.full_name} on #{@presentation.created_at.strftime('%B %d, %Y')}",
           back: [ "Presentations", admin_presentations_path ] do %>
  <%= link_to "Edit", edit_admin_presentation_path(@presentation), class: "btn btn-primary min-h-11 py-2.5" %>
  <% if current_user.can_delete? %>
    <%= render "admin/shared/confirm_button", label: "Delete", url: admin_presentation_path(@presentation),
               confirm: "Are you sure you want to delete this presentation?", variant: :button %>
  <% end %>
<% end %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <%# Main column %>
  <div class="min-w-0 space-y-6 lg:col-span-2">
    <section class="card p-5 sm:p-6">
      <h2 class="mb-3 text-lg font-semibold text-ink">Description</h2>
      <p class="text-gray-900"><%= @presentation.description.presence || "No description provided." %></p>
    </section>

    <%# The story, rendered exactly as buyers read it %>
    <section class="card p-5 sm:p-6">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 class="text-lg font-semibold text-ink">The story</h2>
        <span class="text-sm text-mute"><%= pluralize(@presentation.content.to_s.lines.count, 'source line') %> · rendered as on the deck page</span>
      </div>
      <% if @presentation.content.present? %>
        <div class="prose-deck">
          <%= render_markdown(@presentation.content) %>
        </div>
      <% else %>
        <p class="text-sm text-mute">No story yet, add it in the editor.</p>
      <% end %>
    </section>

    <%# Rendered slides (always ordered by id) %>
    <% if @presentation.slide_images.attached? %>
      <section class="card p-5 sm:p-6">
        <h2 class="mb-4 text-lg font-semibold text-ink">Slides (<%= @presentation.slide_images.count %>)</h2>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
          <% @presentation.slide_images.order(:id).each_with_index do |slide, i| %>
            <figure>
              <%= image_tag slide, alt: "Slide #{i + 1}", loading: 'lazy', class: 'w-full rounded-xl border border-hairline' %>
              <figcaption class="mt-1 text-center text-xs text-mute tabular-nums"><%= i + 1 %></figcaption>
            </figure>
          <% end %>
        </div>
      </section>
    <% elsif @presentation.pdf_file.attached? %>
      <section class="card p-5 text-sm text-ink sm:p-6">
        Slide previews are rendering in the background, refresh in a moment.
      </section>
    <% end %>

    <%# Pour list, parsed %>
    <% recs = @presentation.pour_list %>
    <% if recs.any? %>
      <section class="card p-5 sm:p-6">
        <h2 class="mb-4 text-lg font-semibold text-ink">Whiskey recommendations</h2>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead>
              <tr class="border-b border-hairline text-left text-sm font-medium text-mute">
                <th scope="col" class="pb-2 pr-4 font-medium">Bottle</th><th scope="col" class="pb-2 pr-4 font-medium">Region</th>
                <th scope="col" class="pb-2 pr-4 font-medium">Price</th><th scope="col" class="pb-2 pr-4 font-medium">Style</th><th scope="col" class="pb-2 font-medium">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <% recs.each do |r| %>
                <tr>
                  <td class="py-2 pr-4 font-medium text-ink"><%= r[:name] %></td>
                  <td class="py-2 pr-4 text-mute"><%= r[:region] %></td>
                  <td class="py-2 pr-4 text-mute"><%= r[:price] %></td>
                  <td class="py-2 pr-4 text-mute"><%= r[:style] %></td>
                  <td class="py-2 text-mute"><%= r[:notes] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>

    <%# Tasting notes %>
    <% tasting = { 'Nose' => @presentation.nose_notes, 'Palate' => @presentation.palate_notes,
                   'Finish' => @presentation.finish_notes, 'Body' => @presentation.body_notes }.compact_blank %>
    <% if tasting.any? %>
      <section class="card p-5 sm:p-6">
        <h2 class="mb-4 text-lg font-semibold text-ink">Tasting notes</h2>
        <dl class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <% tasting.each do |label, notes| %>
            <div>
              <dt class="text-sm font-medium text-mute"><%= label %></dt>
              <dd class="mt-1 text-gray-900"><%= notes %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% end %>

    <%# Complete file inventory: every slot, uploaded or not %>
    <section class="card p-5 sm:p-6">
      <h2 class="mb-4 text-lg font-semibold text-ink">Files</h2>

      <% file_rows = [
        ['Deck file (buyers download)', @presentation.pdf_file],
        ['Sneak peek',                  @presentation.sneak_peek_file],
        ['Speaker notes',               @presentation.speaker_notes],
        ['Outline',                     @presentation.outline_file],
        ['Recommendations sheet',       @presentation.recommendations_sheet]
      ] %>
      <ul class="divide-y divide-hairline">
        <% file_rows.each do |label, attachment| %>
          <li class="flex flex-col gap-1 py-3 text-sm sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <span class="shrink-0 text-mute"><%= label %></span>
            <% if attachment.attached? %>
              <span class="min-w-0 break-words font-medium text-gray-900 sm:text-right"><%= attachment.filename %> <span class="font-normal text-mute">(<%= number_to_human_size(attachment.byte_size) %>)</span></span>
            <% else %>
              <span class="text-mute">not uploaded</span>
            <% end %>
          </li>
        <% end %>
        <% @presentation.supplemental_materials.each do |m| %>
          <li class="flex flex-col gap-1 py-3 text-sm sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <span class="shrink-0 text-mute">Extra</span>
            <span class="min-w-0 break-words font-medium text-gray-900 sm:text-right"><%= m.filename %> <span class="font-normal text-mute">(<%= number_to_human_size(m.byte_size) %>)</span></span>
          </li>
        <% end %>
      </ul>

      <% if @presentation.featured_image.attached? %>
        <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
          <figure>
            <%= image_tag @presentation.featured_image, class: 'aspect-video w-full rounded-xl border border-hairline object-cover' %>
            <figcaption class="mt-1 text-center text-xs text-mute">Cover</figcaption>
          </figure>
        </div>
      <% end %>
    </section>
  </div>

  <%# Sidebar %>
  <div class="min-w-0 space-y-6">
    <%= render "admin/shared/detail_panel", title: "Details", rows: [
          [ "Category", @presentation.category || "Uncategorized" ],
          [ "Price", "$#{@presentation.price || '0.00'}" ],
          [ "Duration", @presentation.duration_label || "Not specified" ],
          [ "Difficulty", @presentation.difficulty || "Not specified" ],
          [ "Status", render("admin/shared/status_chip",
                             label: (@presentation.published? ? "Published" : "Draft"),
                             tone: (@presentation.published? ? :ok : :attention)) ]
        ] %>

    <%= render "admin/shared/detail_panel", title: "Purchase statistics", rows: [
          [ "Total purchases", @purchases.count ],
          [ "Revenue", "$#{@purchases.where(purchase_type: 'direct').sum(:purchase_price) || 0}" ],
          [ "Credit purchases", @purchases.where(purchase_type: 'credit').count ]
        ] %>

    <section class="card p-5 sm:p-6">
      <h2 class="mb-4 text-lg font-semibold text-ink">Actions</h2>
      <div class="space-y-3">
        <%# Publishing is explicit and gated on the deck file + rendered slide previews. %>
        <% if @presentation.published? %>
          <%= button_to "Unpublish (back to draft)", unpublish_admin_presentation_path(@presentation), method: :post,
              class: "btn btn-secondary w-full" %>
        <% elsif !@presentation.pdf_file.attached? %>
          <div class="rounded-2xl border border-hairline bg-paper px-4 py-3 text-sm text-ink">
            <span class="font-semibold">Draft.</span> Attach the deck file
            (the presentation buyers download) in the editor to enable publishing.
          </div>
        <% elsif @presentation.slides_rendered? %>
          <%= button_to "Publish to the library", publish_admin_presentation_path(@presentation), method: :post,
              class: "btn btn-primary w-full" %>
        <% elsif @presentation.slide_render_pending? %>
          <div class="rounded-2xl border border-hairline bg-paper px-4 py-3 text-sm text-ink">
            <span class="font-semibold">Rendering slide previews&hellip;</span>
            Usually under a minute. Publishing unlocks when they're ready, refresh to check.
          </div>
        <% else %>
          <div class="rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700">
            <span class="font-semibold">No slide previews.</span> The render didn't run
            or failed. Re-render below, then publish.
          </div>
        <% end %>

        <% if @presentation.pdf_file.attached? && !@presentation.slide_render_pending? %>
          <%= button_to "Re-render slide previews", render_slides_admin_presentation_path(@presentation), method: :post,
              class: "btn btn-secondary w-full" %>
        <% end %>
        <%= link_to "View on Site", presentation_path(@presentation), target: "_blank", rel: "noopener",
            class: "btn btn-secondary w-full" %>
        <%= link_to "View Purchases", "#", class: "btn btn-secondary w-full" %>
        <%= link_to "Download Analytics", admin_presentation_downloads_analytics_path(@presentation),
            class: "btn btn-secondary w-full" %>
      </div>
    </section>
  </div>
</div>

<%# Recent purchases %>
<% if @purchases.any? %>
  <div class="mt-6">
    <%= render "admin/shared/table", rows: @purchases.limit(10), title: "Recent purchases",
               columns: [ "User", "Purchase type", [ "Amount", :right ], [ "Date", :right ] ] do |purchase| %>
      <%= admin_td(purchase.user.full_name) %>
      <%= admin_td do %>
        <% if purchase.purchase_type == 'credit' %>
          <%= render "admin/shared/status_chip", label: "Credit", tone: :attention %>
        <% else %>
          <%= render "admin/shared/status_chip", label: "Direct", tone: :ok %>
        <% end %>
      <% end %>
      <%= admin_td(align: :right) do %>
        <% if purchase.purchase_type == 'direct' %>
          $<%= purchase.purchase_price || @presentation.price %>
        <% else %>
          1 Credit
        <% end %>
      <% end %>
      <%= admin_td(purchase.created_at.strftime("%b %d, %Y"), align: :right) %>
    <% end %>
  </div>
<% end %>
