<%# The story: presentation.content (one Markdown string) edited as chapter
    cards by story_chapters_controller, with a raw-Markdown escape hatch.
    Locals: form, presentation %>
<section id="f-story" class="card scroll-mt-56 p-5 sm:p-7" data-controller="story-chapters">
  <h2 class="text-xl font-semibold text-ink">The story</h2>
  <p class="mb-5 mt-1 text-sm text-mute">
    Appears on: the "A taste of the writing" section of the deck page, one chapter at a time.
  </p>

  <%= form.hidden_field :content, data: { story_chapters_target: "hidden" } %>

  <div data-story-chapters-target="chaptersUi">
    <div data-story-chapters-target="container" class="space-y-4"></div>

    <button type="button"
            data-action="click->story-chapters#addChapter"
            class="btn btn-secondary mt-4 min-h-11 py-2.5">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
      Add chapter
    </button>
  </div>

  <div data-story-chapters-target="rawWrapper" class="hidden">
    <textarea data-story-chapters-target="raw" data-action="input->story-chapters#rawChanged"
              rows="18" class="<%= admin_field_class %> font-mono"></textarea>
    <p class="mt-1 text-xs text-mute"><code>## Heading</code> lines become chapters when you switch back.</p>
  </div>

  <div class="mt-3 text-right">
    <button type="button" data-story-chapters-target="toggle"
            data-action="click->story-chapters#toggleRaw"
            class="min-h-11 text-xs font-medium text-mute underline-offset-2 hover:text-ink hover:underline">Edit as raw Markdown</button>
  </div>

  <template data-story-chapters-target="template">
    <div class="chapter-item rounded-2xl border border-hairline bg-paper p-4">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="chapter-label text-sm font-semibold text-ink">Chapter</h3>
        <div class="flex items-center gap-1">
          <button type="button" data-action="click->story-chapters#moveUp"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-xl text-mute transition hover:bg-whiskey-100 hover:text-ink" aria-label="Move up">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"></path></svg>
          </button>
          <button type="button" data-action="click->story-chapters#moveDown"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-xl text-mute transition hover:bg-whiskey-100 hover:text-ink" aria-label="Move down">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg>
          </button>
          <button type="button" data-action="click->story-chapters#removeChapter"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-xl text-red-700 transition hover:bg-red-50" aria-label="Remove chapter">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
      </div>
      <div class="space-y-3">
        <input type="text"
               class="chapter-title <%= admin_field_class %> !text-base font-semibold"
               placeholder="Chapter heading, leave empty for the opening"
               data-action="input->story-chapters#fieldChanged">
        <textarea class="chapter-body <%= admin_field_class %> leading-relaxed"
                  rows="4"
                  placeholder="The chapter, as prose. Markdown works: **bold**, *italics*, lists, > quotes."
                  data-action="input->story-chapters#fieldChanged"></textarea>
      </div>
    </div>
  </template>
</section>
