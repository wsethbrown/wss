<% content_for :title, "New deck - Admin" %>

<%= render "admin/shared/page_header", title: "New deck",
           lede: "Create a new whiskey presentation for the platform.",
           back: [ "Decks", admin_presentations_path ] %>

<%# Import from a deck file: parses the .pptx/.ppt/.pdf into a pre-filled draft.
    The form's action, field name and multipart/turbo settings belong to the
    controller's `import` action; do not rename them. %>
<section class="card mb-6 p-5 sm:p-7">
  <h2 class="text-xl font-semibold text-ink">Start from your deck file</h2>
  <p class="mt-1 max-w-3xl text-sm text-mute">
    Upload the .pptx, .ppt, or .pdf and we'll draft the title, story skeleton, and cover
    image from it, and render every slide for the buyer preview, then you polish and publish.
  </p>
  <%= form_with url: import_admin_presentations_path, method: :post, multipart: true, data: { turbo: false },
        class: "mt-5 flex flex-col gap-3 sm:flex-row sm:items-center" do |f| %>
    <%= f.file_field :deck_file, accept: ".pptx,.ppt,.pdf", required: true,
        class: "block w-full min-w-0 text-sm text-gray-900 file:mr-3 file:min-h-11 file:cursor-pointer file:rounded-2xl file:border file:border-hairline file:bg-white file:px-4 file:text-sm file:font-semibold file:text-ink sm:flex-1" %>
    <%= f.submit "Import draft", class: "btn btn-primary shrink-0" %>
  <% end %>
</section>

<p class="mb-6 text-sm font-medium text-mute">or fill it in from scratch</p>

<%= render "form", presentation: @presentation, submit_text: "Create draft" %>
