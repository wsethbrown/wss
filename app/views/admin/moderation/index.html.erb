<% content_for :title, "Moderation" %>

<%= render "admin/shared/page_header", title: "Moderation",
           lede: "Flagged reviews and proposed bottle corrections, in one queue." %>

<div class="space-y-6">
  <%# Flagged reviews %>
  <section class="card p-5 sm:p-6">
    <h2 class="text-lg font-semibold text-ink">Flagged reviews</h2>
    <p class="mb-2 mt-1 text-sm text-mute">Reported content stays public until you act. Dismiss keeps the review and closes its reports.</p>

    <% if @open_reports.any? %>
      <ul class="divide-y divide-hairline">
        <% @open_reports.each do |review, reports| %>
          <li class="flex flex-col gap-4 py-5 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <p class="text-sm">
                <%= link_to review.bottle.display_name, review_path(review), class: admin_link_class %>
                <span class="text-mute">by <%= review.user.full_name.presence || review.user.email %> &middot; rated <%= review.rating %></span>
              </p>
              <% if review.notes.present? %>
                <p class="mt-1 line-clamp-2 max-w-xl text-sm text-gray-900"><%= review.notes %></p>
              <% end %>
              <p class="mt-1 text-sm text-mute">
                <%= pluralize(reports.size, "report") %> &middot; latest <%= time_ago_in_words(reports.map(&:created_at).max) %> ago
                <%= " · #{pluralize(review.images.size, 'photo')}" if review.images.attached? %>
              </p>
            </div>
            <div class="flex shrink-0 flex-wrap items-center gap-3">
              <%= button_to "Dismiss", dismiss_admin_review_report_path(reports.first), method: :post,
                  class: "btn btn-secondary min-h-11 py-2.5" %>
              <% if current_user.can_delete? %>
                <% if review.images.attached? %>
                  <%= render "admin/shared/confirm_button", label: "Remove photos",
                             url: destroy_image_admin_bottle_review_path(review.bottle, review),
                             confirm: "Remove every photo on this review? The text stays.", variant: :button %>
                <% end %>
                <%= render "admin/shared/confirm_button", label: "Delete review",
                           url: admin_bottle_review_path(review.bottle, review),
                           confirm: "Permanently delete this review and its photos?", variant: :button %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-mute">Nothing flagged. All quiet.</p>
    <% end %>
  </section>

  <%# Pending bottle corrections %>
  <section class="card p-5 sm:p-6">
    <h2 class="text-lg font-semibold text-ink">Proposed bottle corrections</h2>
    <p class="mb-2 mt-1 text-sm text-mute">Member-suggested stat fixes. Apply or reject them on each bottle's admin page.</p>

    <% if @pending_edits.any? %>
      <ul class="divide-y divide-hairline">
        <% @pending_edits.each do |edit| %>
          <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
            <div class="min-w-0 text-sm">
              <%= link_to edit.bottle.display_name, admin_bottle_path(edit.bottle), class: admin_link_class %>
              <span class="text-mute"><%= edit.field %> &rarr; <span class="font-medium text-ink"><%= edit.proposed_value %></span></span>
              <p class="mt-0.5 text-sm text-mute">
                proposed by <%= edit.user&.full_name.presence || edit.user&.email || "unknown" %> &middot; <%= time_ago_in_words(edit.created_at) %> ago
              </p>
            </div>
            <%= link_to "Review on bottle page", admin_bottle_path(edit.bottle), class: "btn btn-secondary min-h-11 shrink-0 py-2.5" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-mute">No pending corrections.</p>
    <% end %>
  </section>
</div>
