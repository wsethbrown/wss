<%# One page for both uploads. With @presentation it replaces that deck in
    place ("Replace with a package"); without it, it creates a new draft
    ("Upload a package"). The form posts a multipart zip as `package`. %>
<% replacing = @presentation.present? %>
<% content_for :title, "#{replacing ? 'Replace with a package' : 'Upload a package'} - Admin" %>

<% if replacing %>
  <%= render "admin/shared/page_header", title: "Replace with a package",
             lede: @presentation.title,
             back: [ @presentation.title, edit_admin_presentation_path(@presentation, anchor: "files") ] %>
<% else %>
  <%= render "admin/shared/page_header", title: "Upload a package",
             lede: "Load a finished deck from its package zip, as a new draft.",
             back: [ "Decks", admin_presentations_path ] %>
<% end %>

<% if @error.present? %>
  <div id="package-error" class="mb-6 rounded-2xl bg-red-50 px-5 py-4 text-sm text-red-700" role="alert">
    <p class="font-semibold">The package wasn't loaded.</p>
    <p class="mt-1"><%= @error %></p>
    <% if @taken_deck %>
      <p class="mt-2">
        <% if replacing %>
          <%= link_to "Open the other deck called #{@taken_deck.title} →",
                      edit_admin_presentation_path(@taken_deck), class: "font-semibold underline underline-offset-4" %>
        <% else %>
          <%= link_to "Replace #{@taken_deck.title} with this package instead →",
                      new_admin_presentation_package_path(@taken_deck), class: "font-semibold underline underline-offset-4" %>
        <% end %>
      </p>
    <% end %>
  </div>
<% end %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="min-w-0 lg:col-span-2">
    <%= render "admin/shared/form_card", title: "The package",
               lede: "A zip of the package folder: deck.json, speaker-notes.md, the .pptx, the two PDFs and the slides folder." do %>
      <%= form_with url: (replacing ? admin_presentation_package_path(@presentation) : admin_deck_packages_path),
                    method: :post, multipart: true, data: { turbo: false }, id: "package-form" do |f| %>
        <div>
          <%= f.label :package, "Package (.zip)", class: admin_label_class %>
          <%= f.file_field :package, accept: ".zip,application/zip", required: true,
              class: "block w-full min-w-0 text-sm text-gray-900 file:mr-3 file:min-h-11 file:cursor-pointer file:rounded-2xl file:border file:border-hairline file:bg-white file:px-4 file:text-sm file:font-semibold file:text-ink" %>
          <p class="mt-2 text-xs text-mute">On a Mac, right-click the package folder in Finder and choose Compress, then upload the .zip it makes.</p>
        </div>
        <div class="mt-5 flex flex-wrap gap-3 border-t border-hairline pt-5">
          <%= f.submit (replacing ? "Replace this deck" : "Upload package"), class: "btn btn-primary" %>
          <%= link_to "Cancel", (replacing ? edit_admin_presentation_path(@presentation, anchor: "files") : admin_presentations_path),
                      class: "btn btn-secondary" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="min-w-0 space-y-6">
    <% if replacing %>
      <section class="card p-5 sm:p-6">
        <h2 class="text-lg font-semibold text-ink">What changes</h2>
        <p class="mt-2 text-sm text-gray-900">
          The package replaces the title, description, category, difficulty, running time, story, slides,
          deck file, speaker notes and outline PDFs, pours and tags.
        </p>
        <h2 class="mt-5 text-lg font-semibold text-ink">What stays</h2>
        <dl class="mt-2 divide-y divide-hairline text-sm">
          <div class="flex justify-between gap-4 py-2"><dt class="text-mute">Price</dt><dd class="font-medium text-gray-900 tabular-nums"><%= number_to_currency(@presentation.price || 0) %></dd></div>
          <div class="flex justify-between gap-4 py-2"><dt class="text-mute">Status</dt><dd class="font-medium text-gray-900"><%= @presentation.published? ? "Published" : "Draft" %></dd></div>
          <div class="flex justify-between gap-4 py-2"><dt class="text-mute">Owners</dt><dd class="font-medium text-gray-900 tabular-nums"><%= @presentation.user_presentations.count %></dd></div>
        </dl>
        <p class="mt-3 text-sm text-mute">
          The featured flag and the author stay too, and every owner keeps the deck.
          <% if @presentation.published? %>Customers see the new version as soon as the upload finishes.<% end %>
        </p>
      </section>
    <% else %>
      <section class="card p-5 sm:p-6">
        <h2 class="text-lg font-semibold text-ink">After the upload</h2>
        <p class="mt-2 text-sm text-gray-900">
          The deck is created as a draft with the package's price. Check it, then publish it from its page.
        </p>
        <p class="mt-3 text-sm text-mute">
          To update a deck that is already in the library, open it and use Replace with a package.
        </p>
      </section>
    <% end %>
  </div>
</div>
