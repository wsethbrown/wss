<% content_for :title, "Adjust Credits - #{@user.full_name}" %>

<div class="max-w-2xl">
  <%= render "admin/shared/page_header", title: "Adjust user credits", lede: "Add or remove credits for #{@user.full_name}",
             back: [ "Credits", admin_credits_path ] %>

  <section class="card mb-6 p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex min-w-0 items-center gap-4">
        <%= avatar(@user, size: 56) %>
        <div class="min-w-0">
          <p class="truncate text-lg font-semibold text-ink"><%= @user.full_name %></p>
          <p class="truncate text-sm text-mute"><%= @user.email %></p>
        </div>
      </div>
      <div class="text-right">
        <p class="text-sm text-mute">Current balance</p>
        <p class="font-display text-4xl font-semibold tabular-nums <%= @user.credits.negative? ? 'text-rsvp-no' : 'text-ink' %>"><%= @user.credits %></p>
      </div>
    </div>
  </section>

  <%# One ledger entry per adjustment (CreditTransaction.record!); nothing here
      writes the balance directly. %>
  <%= form_with url: adjust_admin_credit_path(@user), method: :post, local: true do |form| %>
    <%= render "admin/shared/form_card" do %>
      <div>
        <%= label_tag :adjustment, "Credit adjustment", class: admin_label_class %>
        <%= number_field_tag :adjustment, nil, placeholder: "Enter positive or negative number", class: "#{admin_field_class} mb-3 text-lg" %>
        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 text-sm text-mute">Quick actions:</span>
          <% [ 1, 5, 10, -1, -5, -10 ].each do |n| %>
            <button type="button" onclick="document.getElementById('adjustment').value = <%= n %>" class="btn btn-secondary min-h-11 px-4 py-2 tabular-nums"><%= n.positive? ? "+#{n}" : n %></button>
          <% end %>
        </div>
      </div>

      <div>
        <%= label_tag :reason, "Reason for adjustment", class: admin_label_class %>
        <%= text_area_tag :reason, nil, rows: 4,
            placeholder: "Describe why you're adjusting credits (e.g., customer support, promotion, correction)...",
            class: admin_field_class %>
      </div>

      <div class="rounded-2xl bg-paper p-4">
        <p class="mb-2 text-sm font-medium text-ink">Preview</p>
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-sm text-mute">Current balance</p>
            <p class="text-xl font-semibold tabular-nums text-ink"><%= @user.credits %> credits</p>
          </div>
          <span class="text-mute" aria-hidden="true">→</span>
          <div class="text-right">
            <p class="text-sm text-mute">New balance</p>
            <p class="text-xl font-semibold tabular-nums text-ink" id="new-balance"><%= @user.credits %> credits</p>
          </div>
        </div>
      </div>

      <div id="negative-warning" class="hidden rounded-2xl bg-red-50 p-4" role="status">
        <p class="text-sm text-red-700">This will result in a negative credit balance. Users cannot use credits when balance is negative.</p>
      </div>

      <div class="flex flex-wrap gap-3 border-t border-hairline pt-5">
        <%= form.submit "Apply Adjustment", class: "btn btn-primary cursor-pointer",
            data: { turbo_confirm: "Are you sure you want to adjust credits for this user?" } %>
        <%= link_to "Cancel", admin_credits_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  <% end %>
</div>

<script>
  // Update preview when adjustment value changes
  document.getElementById('adjustment').addEventListener('input', function() {
    const currentBalance = <%= @user.credits %>;
    const adjustment = parseInt(this.value) || 0;
    const newBalance = currentBalance + adjustment;

    document.getElementById('new-balance').textContent = newBalance + ' credits';

    const warningDiv = document.getElementById('negative-warning');
    if (newBalance < 0) {
      warningDiv.classList.remove('hidden');
    } else {
      warningDiv.classList.add('hidden');
    }
  });
  // The quick-action buttons set the value directly, which fires no input event.
  document.querySelectorAll('button[onclick*="adjustment"]').forEach(function(b) {
    b.addEventListener('click', function() {
      document.getElementById('adjustment').dispatchEvent(new Event('input'));
    });
  });
</script>
