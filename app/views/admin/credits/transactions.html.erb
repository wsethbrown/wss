<% content_for :title, "Credit Transactions" %>

<%= render "admin/shared/page_header", title: "Credit ledger",
           lede: "Every grant, spend, expiry, and refund, the source of truth for balances." do %>
  <%= link_to "Back to credits", admin_credits_path, class: "btn btn-secondary" %>
<% end %>

<%= render "admin/shared/table", rows: @transactions, paginate: true,
      columns: [ "When", "Member", "Type", [ "Amount", :right ], "Detail" ],
      empty: "No credit transactions yet." do |txn| %>
  <%= admin_td(txn.created_at.strftime("%b %-d, %Y %l:%M %p"), class: "whitespace-nowrap text-mute") %>
  <%= admin_td do %>
    <%= link_to txn.user.email, admin_user_path(txn.user), class: admin_link_class %>
  <% end %>
  <%= admin_td do %>
    <% tone = case txn.transaction_type
              when "granted" then :ok
              when "refunded" then :ok
              else :attention
              end %>
    <%= render "admin/shared/status_chip", label: txn.transaction_type.to_s.humanize, tone: tone %>
  <% end %>
  <%= admin_td(txn.amount.positive? ? "+#{txn.amount}" : txn.amount, align: :right, class: "font-semibold") %>
  <%= admin_td do %>
    <%= txn.description %>
    <% if txn.presentation %>, <%= link_to txn.presentation.title, admin_presentation_path(txn.presentation), class: admin_link_class %><% end %>
  <% end %>
<% end %>
