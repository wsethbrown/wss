<% content_for :title, "Credits - Admin" %>

<%= render "admin/shared/page_header", title: "Credits", lede: "Manage user credits and view transaction history" do %>
  <%= link_to "Credit ledger", transactions_admin_credits_path, class: "btn btn-secondary" %>
  <%= button_to "Grant Monthly Credits", grant_monthly_admin_credits_path, method: :post,
      data: { turbo_confirm: "Grant 1 credit to all active subscribers?" }, class: "btn btn-primary cursor-pointer" %>
<% end %>

<%= render "admin/shared/stats", stats: [
  { label: "Total credits", value: number_with_delimiter(@total_credits) },
  { label: "Users with credits", value: @users_with_credits },
  { label: "Average credits", value: @average_credits }
] %>

<%# Filters are a GET form and must not sit inside the bulk-add POST form below
    (nested forms are invalid HTML), so they come first. %>
<%= render "admin/shared/filter_bar", url: admin_credits_path, clear: admin_credits_path, submit: "Apply Filters" do |filter_form| %>
  <div class="sm:col-span-2">
    <%= filter_form.label :search, "Search users", class: admin_label_class %>
    <%= filter_form.text_field :search, value: params[:search], placeholder: "Search by name or email...", class: admin_field_class %>
  </div>
  <div>
    <%= filter_form.label :filter, "Filter", class: admin_label_class %>
    <%= filter_form.select :filter,
        options_for_select([ [ "All users", "" ], [ "Has credits", "has_credits" ], [ "No credits", "no_credits" ], [ "Negative balance", "negative" ] ], params[:filter]),
        {}, { class: admin_field_class } %>
  </div>
  <div>
    <%= filter_form.label :sort, "Sort by", class: admin_label_class %>
    <%= filter_form.select :sort,
        options_for_select([ [ "Most credits", "most_credits" ], [ "Least credits", "least_credits" ], [ "Name", "name" ] ], params[:sort]),
        {}, { class: admin_field_class } %>
  </div>
<% end %>

<%= form_with url: bulk_add_admin_credits_path, method: :post, local: true, class: "space-y-6" do |form| %>
  <%= render "admin/shared/form_card", title: "Bulk credit addition", lede: "Select users below to add credits to their accounts" do %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1 basis-48">
        <%= label_tag :credits_to_add, "Credits to add", class: admin_label_class %>
        <%= number_field_tag :credits_to_add, nil, placeholder: "Number of credits", min: 1, class: admin_field_class %>
      </div>
      <% [ 1, 5, 10 ].each do |n| %>
        <button type="button" onclick="document.getElementById('credits_to_add').value = <%= n %>" class="btn btn-secondary min-h-11 py-2.5">+<%= n %></button>
      <% end %>
      <%= form.submit "Add Credits to Selected Users", class: "btn btn-primary min-h-11 cursor-pointer py-2.5" %>
    </div>
  <% end %>

  <%# The first column holds each row's checkbox; its header is the select-all box. %>
  <%= render "admin/shared/table", rows: @users, paginate: true,
        columns: [ check_box_tag("select_all", "1", false, "aria-label": "Select all users",
                     onclick: "document.querySelectorAll('input[name=\"user_ids[]\"]').forEach(cb => cb.checked = this.checked)",
                     class: "h-4 w-4 rounded border-hairline text-ink focus:ring-ink/30"),
                   "User", [ "Current credits", :right ], "Subscription", "Last activity", [ "", :right ] ],
        empty: ((params[:search].present? || params[:filter].present?) ? "No users match your filters." : "No users in the system yet.") do |user| %>
    <%= admin_td do %>
      <%= check_box_tag "user_ids[]", user.id, false, id: "user_ids_#{user.id}", "aria-label": "Select #{user.full_name}",
          class: "h-4 w-4 rounded border-hairline text-ink focus:ring-ink/30" %>
    <% end %>
    <%= admin_td do %>
      <div class="flex items-center gap-3">
        <%= avatar(user, size: 40) %>
        <%# Capped + truncated: an Apple private-relay name/email is one
            unbreakable 40-char string that otherwise stretches the table. %>
        <div class="min-w-0">
          <div class="max-w-[15rem] truncate font-medium text-gray-900" title="<%= user.full_name %>"><%= user.full_name %></div>
          <div class="max-w-[15rem] truncate text-xs text-mute" title="<%= user.email %>"><%= user.email %></div>
        </div>
      </div>
    <% end %>
    <%= admin_td(user.credits, align: :right, class: "text-lg font-semibold #{user.credits.negative? ? 'text-rsvp-no' : 'text-ink'}") %>
    <%= admin_td do %>
      <% if user.subscription_status == "active" %>
        <%= render "admin/shared/status_chip", label: "Active", tone: :ok %>
      <% else %>
        <%= render "admin/shared/status_chip", label: "None", tone: :attention %>
      <% end %>
    <% end %>
    <%= admin_td(user.updated_at.strftime("%b %d, %Y"), class: "whitespace-nowrap text-mute") %>
    <%= admin_td(align: :right) do %>
      <%= link_to "Adjust", adjust_admin_credit_path(user), class: admin_link_class %>
    <% end %>
  <% end %>
<% end %>
