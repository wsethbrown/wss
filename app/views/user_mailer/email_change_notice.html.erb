<%= render "mailers/layout_open" %>
      <h2 style="margin-top:0;">Your email is being changed</h2>
      <p>We're contacting you to notify you that your email is being changed to <strong><%= @new_email %></strong>.</p>
      <p>The change only takes effect once it is confirmed from that address.</p>
      <p class="meta" style="margin-top: 20px;">If you didn't request this change, change your password and contact us.</p>
<%= render "mailers/layout_close" %>
