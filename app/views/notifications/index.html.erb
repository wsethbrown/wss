<%= render "shared/page_header", title: "Notifications" %>

<% rows = @notifications.filter_map { |n| text = notification_text(n); [n, text] if text } %>
<% if rows.empty? %>
  <div class="card max-w-2xl p-8">
    <p class="text-mute">Nothing yet. When someone follows you, likes a tasting, or your societies schedule a night, it lands here.</p>
  </div>
<% else %>
  <div class="card max-w-2xl divide-y divide-hairline">
    <% rows.each do |notification, text| %>
      <% unread = @unread_ids.include?(notification.id) %>
      <div class="flex items-start gap-3 p-4">
        <% if notification.actor %>
          <%= link_to profile_path(notification.actor), class: "shrink-0" do %>
            <%= avatar notification.actor, size: 36 %>
          <% end %>
        <% else %>
          <div class="h-9 w-9 shrink-0 rounded-full bg-whiskey-100"></div>
        <% end %>
        <div class="min-w-0 flex-1">
          <% url = notification_url(notification) %>
          <p class="text-sm text-gray-900">
            <% if url %>
              <%= link_to text, url, class: "hover:underline" %>
            <% else %>
              <%= text %>
            <% end %>
          </p>
          <p class="mt-0.5 text-sm text-mute"><%= time_ago_in_words(notification.created_at) %> ago</p>
          <% if notification.action == "society_invite" && notification.notifiable&.pending? %>
            <div class="mt-3 flex gap-2">
              <%= button_to "Accept", accept_society_invitation_path(notification.notifiable), method: :patch,
                  class: "btn btn-primary min-h-11 cursor-pointer" %>
              <%= button_to "Decline", decline_society_invitation_path(notification.notifiable), method: :patch,
                  class: "btn btn-secondary min-h-11 cursor-pointer" %>
            </div>
          <% end %>
        </div>
        <% if unread %>
          <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-mark" role="img" aria-label="Unread"></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
