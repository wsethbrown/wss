<% content_for :title, "New decks by email - Whiskey Share Society" %>
<%# Opened from the foot of a deck-news email. The GET changes nothing, so a
    mail scanner following the link removes no one; the button POSTs
    (DeckNewsController#remove). The address is not shown. %>
<div class="mx-auto w-full max-w-md py-8">
  <div class="card p-7 text-center sm:p-8">
    <h1 class="font-display text-3xl font-semibold text-ink">Stop emails about new decks</h1>
    <p class="mt-2 text-mute">We will no longer email this address when a new deck is published.</p>
    <%= form_with url: deck_news_unsubscribe_path, method: :post, class: "mt-7", data: { turbo: false } do %>
      <%= hidden_field_tag :token, @token, id: nil %>
      <%= button_tag "Stop these emails", type: "submit", class: "btn btn-primary min-h-12 w-full cursor-pointer" %>
    <% end %>
  </div>
</div>
