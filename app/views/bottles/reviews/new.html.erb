<% content_for :title, "Review #{@bottle.name} - Whiskey Share Society" %>

<div class="max-w-2xl">
  <%= render "shared/page_header", title: "Your tasting", lede: @bottle.display_name,
      back: [@bottle.name, bottle_path(@bottle)] %>
  <%= render "reviews/form", review: @review, url: bottle_reviews_path(@bottle) %>
</div>
