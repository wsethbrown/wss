<%# locals: bottle, the community's aggregated palate as a smooth wave over
    the nine flavor families. Not per-review (that's the wheel): this sums
    every tasting's words. Labels click through to the family tag view.
    Draw-in (the appear controller, data-appear-target="draw"): the first
    time it is seen, each stem grows up from the base to its value (--len is
    its length, --d its delay, gaps shrinking), the line draws left to right
    over them, and the labels fade in last. The markup is the final picture:
    without JS, in print and under reduced motion it is simply drawn. %>
<% profile = bottle.flavor_profile %>
<% if profile.any? %>
  <% families = Review::DESCRIPTOR_LEXICON.keys %>
  <% max = profile.values.max.to_f %>
  <% top = profile.sort_by { |_, n| -n }.first(2).select { |_, n| n.positive? }.map(&:first) %>
  <section class="panel-ink px-6 pb-8 pt-6">
    <div class="text-center">
      <p class="text-sm font-medium text-cream/70">Flavor profile</p>
      <h2 class="mt-1 font-display text-2xl font-semibold capitalize text-cream"><%= top.join(" & ") %></h2>

      <%
        w, base, amp = 720, 116, 80
        xs = families.each_with_index.map { |_, i| 50 + i * ((w - 100) / (families.size - 1.0)) }
        ys = families.map { |f| base - ((profile[f] || 0) / max) * amp - 6 }
        pts = xs.zip(ys)
        path = "M#{pts[0][0].round(1)},#{pts[0][1].round(1)}"
        pts.each_cons(2).with_index do |(a, b), i|
          p0 = pts[[i - 1, 0].max]; p3 = pts[[i + 2, pts.size - 1].min]
          c1x = a[0] + (b[0] - p0[0]) / 6.0; c1y = a[1] + (b[1] - p0[1]) / 6.0
          c2x = b[0] - (p3[0] - a[0]) / 6.0; c2y = b[1] - (p3[1] - a[1]) / 6.0
          path += " C#{c1x.round(1)},#{c1y.round(1)} #{c2x.round(1)},#{c2y.round(1)} #{b[0].round(1)},#{b[1].round(1)}"
        end
      %>
      <% stem_delays = [ 0, 70, 130, 180, 220, 255, 285, 310, 330 ] %>
      <svg viewBox="0 0 <%= w %> 172" class="mt-4 w-full" role="img" aria-label="Flavor profile: strongest in <%= top.join(' and ') %>" data-appear-target="draw">
        <% pts.each_with_index do |(x, y), i| %>
          <%# Drawn from the base up, so the draw-in grows it to its value. %>
          <line x1="<%= x %>" y1="<%= base %>" x2="<%= x %>" y2="<%= y %>" stroke="#2f5546" stroke-width="1.5" class="wave-stem"
                style="--len: <%= (base - y).round(1) %>; --d: <%= stem_delays[[ i, stem_delays.size - 1 ].min] %>ms"></line>
        <% end %>
        <path d="<%= path %>" fill="none" stroke="#f6f4ee" stroke-width="4.5" stroke-linecap="round" pathLength="1" class="wave-line"></path>
        <% families.each_with_index do |family, i| %>
          <% strong = top.include?(family) %>
          <a href="<%= reviews_path(tags: family) %>">
            <text x="<%= xs[i] %>" y="<%= base + (i.even? ? 22 : 42) %>" text-anchor="middle"
                  font-size="12"
                  fill="#f6f4ee"
                  fill-opacity="<%= strong ? 1 : 0.8 %>" font-weight="<%= strong ? 700 : 500 %>" class="wave-label"><%= family.capitalize %></text>
          </a>
        <% end %>
      </svg>
      <p class="mt-2 text-sm text-cream/70">
        Drawn from reviews, tap a family to chase it.
      </p>
    </div>
  </section>
<% end %>
