<% content_for :title, "Add a bottle - Whiskey Share Society" %>

<div class="max-w-2xl">
  <%= render "shared/page_header", title: "Add a bottle", back: ["The tasting record", reviews_path] %>

    <% if @near_matches.any? %>
      <div class="card mb-6 p-5">
        <p class="font-semibold text-ink">Is it one of these?</p>
        <ul class="mt-3 space-y-2">
          <% @near_matches.each do |match| %>
            <li><%= link_to match.display_name, bottle_path(match), class: "font-medium text-ink underline underline-offset-2 hover:decoration-2" %></li>
          <% end %>
        </ul>
        <p class="mt-3 text-sm text-mute">If yours is genuinely different, save again and it'll go through.</p>
      </div>
    <% end %>

    <%= form_with model: @bottle, class: "card space-y-5 p-6" do |form| %>
      <% if @bottle.errors.any? %>
        <div class="rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700">
          <%= @bottle.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <% if @near_matches.any? %><input type="hidden" name="confirmed_duplicate" value="1"><% end %>
      <% if @return_to %><input type="hidden" name="return_to" value="<%= @return_to %>"><% end %>

      <div>
        <%= form.label :name, "Bottle name", class: "mb-2 block text-sm font-medium text-ink" %>
        <%= form.text_field :name, placeholder: "e.g., Eagle Rare 10", class: "w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30" %>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :distillery, class: "mb-2 block text-sm font-medium text-ink" %>
          <%= form.text_field :distillery, placeholder: "e.g., Buffalo Trace", class: "w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30" %>
        </div>
        <div>
          <%= form.label :region, class: "mb-2 block text-sm font-medium text-ink" %>
          <%= form.text_field :region, placeholder: "e.g., Kentucky · Islay", class: "w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30" %>
        </div>
        <div>
          <%= form.label :style, class: "mb-2 block text-sm font-medium text-ink" %>
          <%= form.text_field :style, placeholder: "e.g., Bourbon · Single Malt", class: "w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30" %>
        </div>
        <div>
          <%= form.label :abv, "ABV %", class: "mb-2 block text-sm font-medium text-ink" %>
          <%= form.number_field :abv, step: 0.1, min: 0, max: 99, placeholder: "45.0", class: "w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30" %>
        </div>
      </div>

      <div>
        <%= form.label :label_image, "A photo of the bottle (optional)", class: "mb-2 block text-sm font-medium text-ink" %>
        <%= form.file_field :label_image, accept: "image/jpeg,image/jpg,image/png,image/gif,image/webp", class: "w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= form.submit "Add the bottle", class: "btn btn-primary cursor-pointer" %>
        <%= link_to "Cancel", reviews_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
</div>
