<div class="mx-auto w-full max-w-6xl px-4 pb-16">
  <header class="pb-8 pt-28 sm:pb-10">
    <%= link_to "← The tasting record", reviews_path, class: "mb-4 inline-block text-sm font-medium text-mute hover:text-ink" %>
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex min-w-0 items-center gap-5">
        <%= render "bottles/identity_tile", bottle: @bottle, tone: :light %>
        <div class="min-w-0">
          <h1 class="font-display text-3xl font-semibold text-ink sm:text-5xl">
            <%= @bottle.name %>
          </h1>
          <p class="mt-2 text-[17px] text-mute">
            <%= [@bottle.style, @bottle.region, (@bottle.abv && "#{@bottle.abv.to_f % 1 == 0 ? @bottle.abv.to_i : @bottle.abv}% ABV")].compact_blank.join(" · ") %>
            <% if @bottle.distillery.present? %>
              <%= " · " if [@bottle.style, @bottle.region, @bottle.abv].any?(&:present?) %><%= link_to @bottle.distillery, reviews_path(distillery: @bottle.distillery), class: "font-medium text-ink underline decoration-hairline underline-offset-4 hover:decoration-ink" %>
            <% end %>
          </p>
          <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1">
            <%= render "shared/score", value: @bottle.average_rating %>
            <% if @bottle.average_rating %>
              <span class="text-mute">· <%= pluralize(@bottle.reviewer_count, "reviewer") %></span>
            <% end %>
            <% if (prices = @bottle.price_summary) %>
              <span class="text-mute">&middot;
                <% if prices[:median] %>
                  ~<%= number_to_currency(prices[:median], precision: 0) %>
                <% else %>
                  most paid <%= number_to_currency(prices[:low], precision: 0) %>&ndash;<%= number_to_currency(prices[:high], precision: 0) %>
                <% end %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-3">
        <% if !user_signed_in? %>
          <%= link_to "Sign in to review", sign_in_path_returning, class: "btn btn-primary" %>
        <% elsif @my_review %>
          <%= link_to "Update your review", edit_review_path(@my_review), class: "btn btn-primary" %>
        <% else %>
          <%= link_to "Review this bottle", new_bottle_review_path(@bottle), class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </header>

  <%# Two columns below the header: the room's palate stays put on the left
      while the tastings scroll on the right. %>
  <div class="grid items-start gap-8 lg:grid-cols-2">
    <div class="min-w-0 space-y-6 lg:sticky lg:top-24">
      <% facts = { "Style" => @bottle.style, "Region" => @bottle.region,
                   "Distillery" => @bottle.distillery,
                   "ABV" => (@bottle.abv && "#{@bottle.abv.to_f % 1 == 0 ? @bottle.abv.to_i : @bottle.abv}%") }.compact_blank %>
      <% if facts.any? || @bottle.price_summary %>
        <div class="card p-5">
          <h2 class="text-xl font-semibold text-ink">The bottle</h2>
          <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-3">
            <% facts.each do |label, value| %>
              <div><dt class="text-sm font-medium text-mute"><%= label %></dt><dd class="mt-0.5 text-gray-900"><%= value %></dd></div>
            <% end %>
            <% if (prices = @bottle.price_summary) %>
              <div><dt class="text-sm font-medium text-mute">What people pay</dt>
                <dd class="mt-0.5 text-gray-900">
                  <% if prices[:median] %>~<%= number_to_currency(prices[:median], precision: 0) %><% else %><%= number_to_currency(prices[:low], precision: 0) %>&ndash;<%= number_to_currency(prices[:high], precision: 0) %><% end %>
                </dd></div>
            <% end %>
          </dl>
          <% if user_signed_in? %>
            <%= link_to "Suggest a correction", new_bottle_edit_path(@bottle), class: "mt-3 inline-block text-sm font-semibold text-ink hover:underline" %>
          <% end %>
          <% if (words = @bottle.top_descriptors).any? %>
            <div class="mt-4 flex flex-wrap gap-1.5 border-t border-hairline pt-4">
              <% words.each do |word| %>
                <%= link_to word, reviews_path(tags: word), class: "rounded-lg bg-paper px-2.5 py-1 text-xs font-medium text-ink transition hover:bg-whiskey-100" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= render "bottles/flavor_wave", bottle: @bottle %>
    </div>

    <div class="min-w-0">
      <%# Decks that call for this bottle (Phase 3 deck ties). PUBLISHED only:
          a draft deck is not public, and this is a public page. %>
      <% decks = @bottle.presentations.published.distinct.to_a %>
      <% if decks.any? %>
        <div class="card mb-6 p-5">
          <h2 class="text-xl font-semibold text-ink">Poured in <%= decks.size == 1 ? "this deck" : "these decks" %></h2>
          <ul class="mt-3 divide-y divide-hairline">
            <% decks.each do |deck| %>
              <li class="py-2 first:pt-0 last:pb-0">
                <%= link_to deck.title, presentation_path(deck), class: "font-semibold text-ink hover:underline" %>
                <% if deck.reviewed? %>
                  <span class="ml-1 align-middle"><%= render "shared/score", value: deck.average_review_rating %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <h2 class="mb-4 font-display text-2xl font-semibold text-ink sm:text-3xl">Tastings</h2>

      <% if @reviews.none? && @society_verdicts.none? %>
        <p class="text-mute">No one has reviewed this bottle yet. Be the first pour.</p>
      <% end %>

      <div class="space-y-6">
        <%# The rooms' verdicts lead; individual tastings follow. %>
        <% @society_verdicts.each do |society| %>
          <%= render "bottles/society_verdict_card", society: society, bottle: @bottle, reviews: @verdict_reviews[society.id] || [] %>
        <% end %>
        <%= render partial: "bottles/tasting_card", collection: @reviews, as: :review %>
      </div>
      <div class="mt-8"><%= paginate @reviews if @reviews.respond_to?(:total_pages) %></div>
    </div>
  </div>
</div>
