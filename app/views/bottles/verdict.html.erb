<% content_for :title, "#{@society.name} on #{@bottle.name} - Whiskey Share Society" %>
<%# The drill-in behind a society verdict card: the aggregate as the
    header, every member's tasting card below. %>

<div class="max-w-3xl">
  <header class="pb-8 pt-2 sm:pb-10">
    <%= link_to "← #{@bottle.name}", bottle_path(@bottle), class: "mb-4 inline-block text-sm font-medium text-mute hover:text-ink" %>
    <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">
      <%= link_to @society.name, society_path(@society), class: "hover:underline" %>
      <span class="text-mute">on</span>
      <%= link_to @bottle.name, bottle_path(@bottle), class: "hover:underline" %>
    </h1>
    <div class="mt-5 flex items-center gap-3 text-xl">
      <%= render "bottles/rating", value: @verdict.verdict_avg.to_f %>
      <span class="font-semibold tabular-nums text-ink"><%= number_with_precision(@verdict.verdict_avg, precision: 2, strip_insignificant_zeros: true) %></span>
    </div>
    <p class="mt-2 text-mute"><%= pluralize(@verdict.verdict_reviewers, "taster") %> at their nights</p>
  </header>

  <div class="space-y-6">
    <%= render partial: "bottles/tasting_card", collection: @reviews, as: :review %>
  </div>
</div>
