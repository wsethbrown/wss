<%# One member's tasting of this bottle, used on the bottle page and
    on society verdict pages. locals: review %>
<article class="card min-w-0 p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <span><%= link_to "#{review.user.first_name} #{review.user.last_name}", profile_path(review.user), class: "font-semibold text-ink hover:underline" %> <%= render "shared/century_badge", record: review.user %></span>
    <%= render "bottles/rating", value: review.rating.to_f %>
  </div>
  <%= render "reviews/event_card", review: review %>

  <% if review.notes.present? %><p class="mt-3 line-clamp-4 text-gray-700"><%= review.notes %></p><% end %>
  <% tasting = { "Nose" => review.nose, "Palate" => review.palate, "Finish" => review.finish, "Body" => review.body_notes }.compact_blank %>
  <% if tasting.any? %>
    <dl class="mt-4 grid grid-cols-1 gap-x-6 gap-y-3 border-t border-hairline pt-4 sm:grid-cols-2">
      <% tasting.each do |label, text| %>
        <div><dt class="text-sm font-semibold text-ink"><%= label %></dt><dd class="mt-1 text-sm text-gray-700"><%= text %></dd></div>
      <% end %>
    </dl>
  <% end %>
  <% if (tags = review.descriptor_tags).any? %>
    <div class="mt-3 flex flex-wrap gap-1.5">
      <% tags.each_key do |word| %>
        <%= link_to word, reviews_path(tags: word), class: "rounded-lg bg-paper px-2.5 py-1 text-xs font-medium text-ink transition hover:bg-whiskey-100" %>
      <% end %>
    </div>
  <% end %>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
    <span class="flex items-center gap-4">
      <%= render "review_votes/button", review: review %>
      <p class="text-sm text-mute"><%= review.created_at.strftime("%B %-d, %Y") %></p>
    </span>
    <span class="flex items-center gap-4">
      <% if review.user == current_user %>
        <%= link_to "Edit", edit_review_path(review), class: "text-sm font-semibold text-ink hover:underline" %>
      <% end %>
      <%= link_to "Read the full tasting →", review_path(review), class: "text-sm font-semibold text-ink hover:underline" %>
    </span>
  </div>
</article>
