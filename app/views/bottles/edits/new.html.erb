<% content_for :title, "Suggest a correction - #{@bottle.name}" %>

<div class="max-w-2xl">
  <%= render "shared/page_header", title: "Suggest a correction",
      lede: "Change only what's wrong, fields you leave as-is are ignored. Once enough members agree on a fix, it applies automatically.",
      back: [@bottle.name, bottle_path(@bottle)] %>

    <%= form_with url: bottle_edits_path(@bottle), method: :post, class: "card space-y-5 p-6" do %>
      <div>
        <label for="bottle_edit_name" class="mb-2 block text-sm font-medium text-ink">Bottle name</label>
        <input type="text" name="bottle_edit[name]" id="bottle_edit_name" value="<%= @bottle.name %>"
          class="w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30">
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="bottle_edit_distillery" class="mb-2 block text-sm font-medium text-ink">Distillery</label>
          <input type="text" name="bottle_edit[distillery]" id="bottle_edit_distillery" value="<%= @bottle.distillery %>"
            class="w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30">
        </div>
        <div>
          <label for="bottle_edit_region" class="mb-2 block text-sm font-medium text-ink">Region</label>
          <input type="text" name="bottle_edit[region]" id="bottle_edit_region" value="<%= @bottle.region %>"
            class="w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30">
        </div>
        <div>
          <label for="bottle_edit_style" class="mb-2 block text-sm font-medium text-ink">Style</label>
          <input type="text" name="bottle_edit[style]" id="bottle_edit_style" value="<%= @bottle.style %>"
            class="w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30">
        </div>
        <div>
          <label for="bottle_edit_abv" class="mb-2 block text-sm font-medium text-ink">ABV %</label>
          <input type="number" step="0.1" min="0" max="99" name="bottle_edit[abv]" id="bottle_edit_abv" value="<%= @bottle.abv %>"
            class="w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30">
        </div>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button type="submit" class="btn btn-primary cursor-pointer">Submit correction</button>
        <%= link_to "Cancel", bottle_path(@bottle), class: "btn btn-secondary" %>
      </div>
    <% end %>
</div>
