<%# A society's collective take on this bottle, shaped like any tasting
    card, but the author is the room: aggregate score plus the most common
    tasting words across the members' reviews. Clicking through opens the
    verdict page with every individual card.
    locals: society (with verdict_avg/verdict_reviewers), bottle, reviews %>
<article class="card min-w-0 border-ink/40 p-6">
  <p class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-ink">
    Society verdict
  </p>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <span><%= link_to society.name, society_path(society), class: "font-semibold text-ink hover:underline" %> <%= render "shared/century_badge", record: society %></span>
    <span class="flex items-center gap-2 whitespace-nowrap">
      <span class="font-semibold tabular-nums text-ink"><%= number_with_precision(society.verdict_avg, precision: 2, strip_insignificant_zeros: true) %></span>
      <%= render "bottles/rating", value: society.verdict_avg.to_f %>
    </span>
  </div>

  <% sections = Review.common_descriptors(reviews) %>
  <% wheel = Review.blended_wheel(reviews) %>
  <% if sections.any? || wheel.any? %>
    <div class="mt-4 grid items-start gap-6 border-t border-hairline pt-4 <%= 'sm:grid-cols-[1fr_11rem]' if sections.any? && wheel.any? %>">
      <% if sections.any? %>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-3">
          <% sections.each do |label, words| %>
            <div><dt class="text-sm font-semibold text-ink"><%= label %></dt><dd class="mt-1 text-sm text-gray-700"><%= words.join(", ").capitalize %></dd></div>
          <% end %>
        </dl>
      <% end %>
      <% if wheel.any? %>
        <%= render "reviews/palate_wheel", profile: wheel %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm text-mute"><%= pluralize(society.verdict_reviewers, "taster") %> at their nights</p>
    <%= link_to "Read the tastings →", verdict_bottle_path(bottle, society_id: society.id), class: "text-sm font-semibold text-ink hover:underline" %>
  </div>
</article>
