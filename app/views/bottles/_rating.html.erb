<%# locals: value (Float, arbitrary precision, or nil)
    Five stars drawn as inline SVG in the deep orange mark (half steps as a half-filled
    star); the value itself is the sr-only text, so assistive tech reads
    "4.25 out of 5" rather than shapes. %>
<% if value %>
  <% snapped = [[(value * 2).round / 2.0, 0.5].max, 5.0].min %>
  <% star = "12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" %>
  <% left = "12,2 8.91,8.26 2,9.27 7,14.14 5.82,21.02 12,17.77" %>
  <span class="inline-flex items-center whitespace-nowrap align-[-0.125em] text-mark-deep">
    <% 5.times do |i| %>
      <% kind = if i < snapped.floor then "full" elsif i < snapped then "half" else "empty" end %>
      <svg class="h-[1em] w-[1em]" viewBox="0 0 24 24" aria-hidden="true" data-star="<%= kind %>">
        <polygon points="<%= star %>" fill="<%= kind == 'full' ? 'currentColor' : '#dedccf' %>"></polygon>
        <% if kind == "half" %><polygon points="<%= left %>" fill="currentColor"></polygon><% end %>
      </svg>
    <% end %>
    <span class="sr-only"><%= value %> out of 5</span>
  </span>
<% else %>
  <span class="text-sm text-mute">No tastings yet</span>
<% end %>
