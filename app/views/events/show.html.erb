<% content_for :title, "#{@event.title} - Whiskey Share Society" %>

<%# Full-bleed in the layout (events#show), so this page sets its own width
    and clears the floating nav itself. Paper ground, header on paper, then
    cards (docs/redesign/DESIGN_SYSTEM.md). %>
<div class="mx-auto max-w-6xl px-4 pb-16 pt-28 sm:px-6">
  <%# Header. The society is named once up here, in the breadcrumb, so a night
      reads as part of its society without repeating it beside the title. %>
  <header class="pb-8 sm:pb-10">
    <nav class="mb-4 flex min-w-0 items-center gap-2 text-sm" aria-label="Breadcrumb">
      <%= link_to @event.society.name, society_path(@event.society),
          class: "truncate font-medium text-mute transition hover:text-ink" %>
      <svg class="h-4 w-4 shrink-0 text-whiskey-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
      </svg>
      <span class="truncate text-mute" aria-current="page"><%= @event.title %></span>
    </nav>

    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0 max-w-2xl">
        <p class="mb-3 flex items-center gap-2 text-sm font-medium text-mute">
          <% if @event.ongoing? %>
            <span class="inline-block h-2 w-2 rounded-full bg-mark-deep motion-safe:animate-pulse" aria-hidden="true"></span>
            Happening now
          <% elsif @event.upcoming? %>
            Upcoming · in <%= distance_of_time_in_words(Time.current, @event.start_time) %>
          <% else %>
            Completed · <%= time_ago_in_words(@event.start_time) %> ago
          <% end %>
        </p>
        <h1 class="font-display text-4xl font-semibold text-ink sm:text-5xl [overflow-wrap:anywhere]">
          <%= @event.title %>
        </h1>

        <%# One wrapping row: the date stays on one line. %>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-mute">
          <span class="inline-flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"></path>
            </svg>
            <span>
              <%= @event.start_time.strftime("%a, %B %-d, %Y") %>
              <span aria-hidden="true">·</span>
              <span class="tabular-nums" data-event-zone-note><%= @event.start_time.strftime("%-I:%M %p") %> – <%= @event.end_time.strftime("%-I:%M %p") %> <%= @event.start_time.zone %><% if (event_zone_time = @event.event_zone_label_for(Time.zone)) %> <span class="text-mute">· <%= event_zone_time %> at the event</span><% end %></span>
            </span>
          </span>

          <% if @event.location.present? %>
            <span class="inline-flex min-w-0 items-center gap-2">
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span class="[overflow-wrap:anywhere]"><%= @event.location %></span>
            </span>
          <% end %>

          <span class="inline-flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"></path>
            </svg>
            <span>
              Organised by <%= link_to @event.organizer.full_name, profile_path(@event.organizer),
                  class: "font-semibold text-ink transition hover:text-whiskey-500" %>
            </span>
          </span>
        </div>
      </div>

      <%# RSVP. The reason a member opens this page, so it gets the card beside
          the title, with the going/maybe/no counts right under the control.
          Edit is an organiser's tool and sits quietly at the bottom. %>
      <div class="card w-full p-5 sm:p-6 lg:w-[380px] lg:shrink-0">
        <% if user_signed_in? %>
          <% if @event.upcoming? && !@event.rsvp_closed? %>
            <% user_rsvp = @event.event_rsvps.find_by(user: current_user) %>
            <%= render "rsvp_buttons", event: @event, user_rsvp: user_rsvp %>
          <% elsif @event.upcoming? %>
            <% user_rsvp = @event.event_rsvps.find_by(user: current_user) %>
            <p class="text-sm text-mute">
              <% if user_rsvp %>
                You said <span class="font-semibold text-ink"><%= user_rsvp.status %></span>.
              <% end %>
              RSVPs closed 24 hours before the night.
            </p>
          <% else %>
            <p class="text-sm text-mute">This night has passed.</p>
          <% end %>
        <% else %>
          <%= link_to "Sign in to RSVP", new_user_session_path, class: "btn-primary w-full" %>
        <% end %>

        <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-hairline pt-4 text-sm text-mute">
          <%= render "header_rsvp_count", event: @event %>
          <%= render "stats", event: @event %>
        </p>

        <% if user_signed_in? && policy(@event).update? %>
          <%= link_to edit_society_event_path(@event.society, @event),
              class: "mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ink transition hover:text-whiskey-500" do %>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"></path>
            </svg>
            Edit this event
          <% end %>
        <% end %>
      </div>
    </div>
  </header>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="min-w-0 space-y-6 lg:col-span-2">
      <section class="card p-6 sm:p-7" aria-labelledby="event-details-heading">
        <h2 id="event-details-heading" class="text-xl font-semibold text-ink">Event details</h2>
        <% if @event.description.present? %>
          <div class="mt-3 text-[17px] leading-relaxed text-gray-900 [overflow-wrap:anywhere] [&_p+p]:mt-4">
            <%= simple_format(@event.description) %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-mute">No description provided for this event.</p>
        <% end %>
      </section>

      <% if @event.pours_revealed? && (verdict = verdict_rows(@pours, @pour_reviews)).any? %>
        <%= render "verdict", rows: verdict %>
      <% end %>

      <%= render "pours" %>

      <%= render "comments", event: @event %>
    </div>

    <aside class="min-w-0 space-y-6" aria-label="About this night">
      <%= render "attendees", event: @event %>

      <%# The deck (optional): shown to everyone; set by managers + host. %>
      <% if @event.presentation || (user_signed_in? && policy(@event).manage_deck?) %>
        <section class="card p-6">
          <h2 class="text-xl font-semibold text-ink">The deck</h2>
          <div class="mt-3 space-y-4">
            <% if @event.presentation %>
              <%= link_to presentation_path(@event.presentation), class: "group block" do %>
                <p class="text-lg font-semibold leading-snug text-ink group-hover:text-whiskey-500"><%= @event.presentation.title %></p>
                <p class="mt-1 text-sm font-semibold text-ink">See the deck <span aria-hidden="true">→</span></p>
              <% end %>
            <% else %>
              <p class="text-sm text-mute">No deck attached. Plenty of nights run without one.</p>
            <% end %>
            <% if user_signed_in? && policy(@event).manage_deck? %>
              <% if deck_options_for(@event).any? %>
                <%= form_with url: assign_deck_society_event_path(@event.society, @event), method: :patch, local: true, class: "space-y-2" do %>
                  <%= render "events/autocomplete_field",
                      name: "presentation_id",
                      url: deck_options_society_event_path(@event.society, @event),
                      placeholder: "Search deck titles…",
                      current_label: @event.presentation&.title,
                      hint: "Leave empty to run this night without a deck." %>
                  <button type="submit" class="btn-secondary w-full cursor-pointer">
                    Set deck
                  </button>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <%# Host: shown to everyone once assigned; managed by update? holders. %>
      <% if @event.host || @event.host_name.present? || policy(@event).update? %>
        <section class="card p-6">
          <h2 class="text-xl font-semibold text-ink">Host</h2>
          <div class="mt-3 space-y-4">
            <% if @event.host %>
              <%= link_to profile_path(@event.host), class: "flex min-h-11 items-center gap-3 text-sm font-medium text-ink transition hover:text-whiskey-500" do %>
                <%= avatar(@event.host, size: 32) %>
                <span class="min-w-0 truncate"><%= @event.host.full_name %></span>
              <% end %>
            <% elsif @event.host_name.present? %>
              <p class="text-sm font-medium text-ink"><%= @event.host_name %>
                <span class="ml-1 text-xs font-normal text-mute">guest presenter</span></p>
            <% else %>
              <p class="text-sm text-mute">No host assigned yet.</p>
            <% end %>
            <% if policy(@event).update? %>
              <%= form_with url: assign_host_society_event_path(@event.society, @event), method: :patch, local: true, class: "space-y-2" do %>
                <%= render "events/autocomplete_field",
                    name: "host_id",
                    url: host_options_society_event_path(@event.society, @event),
                    placeholder: "Search member names…",
                    current_label: @event.host_display_name,
                    free_text_name: "host_name",
                    hint: "Pick a member, or type any name for a guest presenter. Leave empty to remove the host." %>
                <button type="submit" class="btn-secondary w-full cursor-pointer">
                  Set host
                </button>
              <% end %>
              <p class="text-xs text-mute">The host sees this event's RSVP replies.</p>
            <% end %>
          </div>
        </section>
      <% end %>

      <%# RSVP replies: the host and event managers only. %>
      <% if policy(@event).view_rsvps? && @event.event_rsvps.any? %>
        <section class="card p-6">
          <h2 class="text-xl font-semibold text-ink">RSVP replies</h2>
          <p class="mt-1 text-xs text-mute">Only the host and event managers see this.</p>
          <ul class="mt-3 divide-y divide-hairline">
            <% @event.event_rsvps.includes(:user).order(updated_at: :desc).each do |rsvp| %>
              <li class="flex items-start justify-between gap-3 py-3">
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-ink"><%= rsvp.user.full_name %></p>
                  <% if rsvp.note.present? %>
                    <p class="mt-0.5 text-sm italic text-mute [overflow-wrap:anywhere]">&ldquo;<%= rsvp.note %>&rdquo;</p>
                  <% end %>
                </div>
                <% tone = { "yes" => "text-rsvp-yes", "maybe" => "text-rsvp-maybe", "no" => "text-rsvp-no" }[rsvp.status] %>
                <span class="inline-flex shrink-0 items-center rounded-xl border border-hairline bg-white px-2.5 py-0.5 text-xs font-semibold <%= tone %>"><%= rsvp.status.capitalize %></span>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="card p-6">
        <h2 class="text-xl font-semibold text-ink">Society</h2>
        <%= link_to @event.society, class: "mt-3 flex items-center gap-4 text-ink transition hover:text-whiskey-500" do %>
          <span class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-[14px] bg-char">
            <%= render 'shared/society_icon', society: @event.society, size: 'default' %>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold"><%= @event.society.name %></span>
            <span class="block text-xs tabular-nums text-mute"><%= @event.society.member_count %> members</span>
          </span>
        <% end %>
      </section>
    </aside>
  </div>
</div>
