<% content_for :title, "Create New Event - Whiskey Share Society" %>

<div class="mx-auto max-w-3xl">
    <% lede = if @event.society
                safe_join([ "Planning an event for ", content_tag(:strong, @event.society.name, class: "font-semibold text-ink"), "? Let's get the details sorted." ])
              else
                safe_join([ "Create an engaging ", content_tag(:strong, "whiskey event", class: "font-semibold text-ink"), " for your community." ])
              end %>
    <%= render "shared/page_header", title: "Create new event", lede: lede,
               back: (@event.society ? [ @event.society.name, society_path(@event.society) ] : nil) %>

    <!-- Form Card -->
    <div class="card p-6 sm:p-10">
      <%= render "form", event: @event, society: @society, submit_label: "Create event", creating: true,
                 cancel_path: (@event.society ? society_path(@event.society) : societies_path) %>
    </div>
  </div>
