<%# locals: event, alert (optional) — Table talk, the night's flat comment
    thread. Members/organizer/global admin may post (EventPolicy#comment?)
    while Event#comments_open? (until a week after the night ends). %>
<section id="table-talk" class="card p-6 sm:p-7">
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <h2 class="text-xl font-semibold text-ink">Table talk</h2>
    <% unless event.comments_open? %>
      <span class="text-sm text-mute">Comments close a week after the night.</span>
    <% end %>
  </div>
  <div class="mt-3">
    <% comments = event.event_comments.ordered.includes(:user) %>
    <% if comments.any? %>
      <div class="divide-y divide-hairline">
        <% comments.each do |comment| %>
          <div class="py-3 first:pt-0">
            <div class="flex items-baseline justify-between gap-3">
              <p class="min-w-0 truncate text-sm font-semibold text-ink"><%= comment.user.full_name %></p>
              <div class="flex shrink-0 items-baseline gap-3">
                <span class="text-xs text-mute"><%= l(comment.created_at, format: :short) %></span>
                <% if user_signed_in? && policy(comment).destroy? %>
                  <%= button_to "Delete", event_comment_path(event, comment), method: :delete,
                      class: "cursor-pointer text-xs font-semibold text-mute hover:text-red-700" %>
                <% end %>
              </div>
            </div>
            <p class="mt-1 whitespace-pre-line text-sm text-gray-900 [overflow-wrap:anywhere]"><%= comment_body_with_mentions(comment) %></p>
          </div>
        <% end %>
      </div>
    <% elsif event.comments_open? %>
      <p class="text-sm text-mute">Nothing on the record yet.</p>
    <% else %>
      <p class="text-sm text-mute">The night passed without a word.</p>
    <% end %>

    <% if local_assigns[:alert].present? %>
      <p class="mt-4 rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700"><%= alert %></p>
    <% end %>

    <% if user_signed_in? && policy(event).comment? && event.comments_open? %>
      <%= form_with url: event_comments_path(event), method: :post, class: "mt-5 space-y-3" do %>
        <%# Typing @ suggests members of this society. Picking one only writes
            the handle into the text: the comment stays plain text and the
            server resolves it later, so an ignored suggestion is harmless. %>
        <div class="relative" data-controller="mention-autocomplete"
             data-mention-autocomplete-url-value="<%= mention_options_society_event_path(event.society, event) %>"
             data-action="click@document->mention-autocomplete#clickOutside">
          <textarea name="event_comment[body]" rows="2" required maxlength="2000"
                    placeholder="Say something about this night… type @ to tag a member"
                    data-mention-autocomplete-target="input"
                    data-action="input->mention-autocomplete#type click->mention-autocomplete#type keydown->mention-autocomplete#keydown"
                    class="w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-ink/30"></textarea>
          <div data-mention-autocomplete-target="results"
               class="absolute inset-x-0 top-full z-20 mt-1 hidden max-h-56 overflow-y-auto rounded-2xl border border-hairline bg-white shadow-lg"></div>
        </div>
        <%= submit_tag "Post", class: "btn-secondary cursor-pointer" %>
      <% end %>
    <% end %>
  </div>
</section>
