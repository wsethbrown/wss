<% content_for :title, "You're invited to #{@society.name} - Whiskey Share Society" %>
<%# Cleaner headline for the link preview: og:site_name already says WSS. %>
<% content_for :og_title, "You're invited to #{@society.name}" %>
<%# The signed-out invite peek. The link is the invite, so the society gets
    to introduce itself, private ones included, but no member identities
    appear here. Signing up or in consumes the session token and joins. %>

<%# Rich link preview: a branded card with the chapter's name and logo instead
    of a bare domain chip. Same veiling rule as the page itself — the invite
    token authorises showing the name, private chapters included, and the card
    endpoint is gated by that same token. The ?v= stamp busts a scraper's cache
    when the name or logo changes. %>
<% content_for :og_description, @society.description.presence ||
     "You've been invited to join #{@society.name} on Whiskey Share Society." %>
<%# The .png extension matters for iMessage: Apple's LinkPresentation is
    picky about an og:image URL with no file extension and a query string, and
    silently drops the whole preview to a bare-domain chip. The route already
    accepts the format; the action serves the same PNG either way. %>
<% content_for :og_image, society_invite_card_url(@society.invite_token, format: :png,
     v: SocietiesController.invite_card_cache_key(@society).split("/").last) %>
<% content_for :og_image_width, Og::SocietyCard::W %>
<% content_for :og_image_height, Og::SocietyCard::H %>
<% content_for :og_image_type, "image/png" %>
<%# The layout treats this page as full-bleed, so it brings its own width and clears the nav. %>
<div class="mx-auto max-w-3xl px-4 pb-16 pt-28">
  <% if @society.banner_image.attached? %>
    <div class="mb-8 aspect-[3/1] overflow-hidden rounded-[18px] border border-hairline bg-char">
      <%= image_tag image_variant(@society.banner_image, :hero), alt: "", class: "h-full w-full object-cover",
          style: "object-position: #{@society.banner_position || 'center center'};" %>
    </div>
  <% end %>

  <%= render "shared/page_header", title: @society.name,
      lede: @society.description.presence %>
  <p class="-mt-4 mb-8 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-mute sm:-mt-6">
    <span>You're invited</span>
    <% if @society.location.present? %><span><%= @society.location %></span><% end %>
    <% if @society.public? %>
      <span class="tabular-nums"><%= pluralize(@society.member_count, 'member') %></span>
      <span>Founded by <%= @society.creator.full_name %>, <%= @society.created_at.strftime("%B %Y") %></span>
    <% else %>
      <span>A private society</span>
    <% end %>
  </p>

  <div class="space-y-8">
    <% if @society.about.present? %>
      <section class="card overflow-hidden">
        <div class="border-b border-hairline px-6 py-4"><h2 class="text-xl font-semibold text-ink">About this society</h2></div>
        <div class="p-6 leading-relaxed text-gray-900"><%= simple_format(@society.about) %></div>
      </section>
    <% end %>

    <% if @top_board.any? %>
      <section class="card overflow-hidden">
        <div class="border-b border-hairline px-6 py-4">
          <h2 class="text-xl font-semibold text-ink">From the review board</h2>
          <p class="mt-1 text-sm text-mute">What this society has been pouring, rated at their tastings.</p>
        </div>
        <div class="divide-y divide-hairline">
          <% @top_board.each do |bottle| %>
            <div class="flex items-center justify-between gap-4 px-6 py-4">
              <div class="min-w-0">
                <p class="truncate font-semibold text-ink"><%= bottle.name %></p>
                <p class="text-xs text-mute"><%= [bottle.distillery, bottle.style].compact_blank.join(" · ") %></p>
              </div>
              <div class="shrink-0 text-right">
                <span class="text-mark"><%= render "bottles/rating", value: bottle.board_avg.to_f %></span>
                <p class="mt-0.5 text-xs text-mute"><%= pluralize(bottle.board_reviewers, "reviewer") %></p>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="panel-ink p-8">
      <h2 class="text-2xl font-semibold">Pull up a chair</h2>
      <p class="mt-3 max-w-md text-cream/75">
        Create an account or sign in and you'll join <%= @society.name %> automatically.
      </p>
      <%= link_to "Continue", auth_path, class: "btn mt-6 bg-white px-10 text-ink hover:bg-whiskey-100" %>
      <p class="mt-4 text-xs text-cream/65">One click with Google or Apple, or a magic link to your email. No password needed.</p>
    </section>
  </div>
</div>
