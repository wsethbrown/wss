<%# Societies index. Full-bleed in the application layout (societies#index is in
    its full_bleed list), so this page sets its own width and clears the nav
    itself via the page header's clear_nav. Rows come from societies/_index_row,
    which is used only here. Every count is computed from the database
    (members/events preloaded by SocietiesController#index). %>
<% input_class = "w-full rounded-2xl border border-hairline bg-white py-3 pl-12 pr-4 text-gray-900 placeholder-gray-500 focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/30" %>

<div class="mx-auto w-full max-w-6xl px-4 pb-20">
  <% if user_signed_in? %>
    <%# Creating a society is a membership benefit (SocietyPolicy#create?).
        Free accounts join societies but can't start one. %>
    <% can_create_society = policy(Society).create? %>

    <%= render "shared/page_header",
          title: "Your whiskey societies",
          lede: "Manage your communities and discover new ones",
          clear_nav: true,
          actions: (can_create_society ? link_to("Create a society", new_society_path, class: "btn btn-primary") : nil) %>

    <%# Your societies %>
    <section class="mb-14" aria-labelledby="your-societies-heading">
      <h2 id="your-societies-heading" class="mb-5 font-display text-2xl font-semibold text-ink sm:text-3xl">Your societies</h2>

      <% if @user_societies.any? %>
        <div class="card overflow-hidden">
          <ul class="divide-y divide-hairline">
            <% @user_societies.each do |society| %>
              <li>
                <%= render "societies/index_row", society: society,
                      label: (society.creator == current_user ? "Creator" : "Member") %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="text-xl font-semibold text-ink">Start your whiskey journey</h3>
            <% if can_create_society %>
              <p class="mt-1 text-mute">You haven't joined any societies yet, discover one below, or start your own.</p>
            <% else %>
              <p class="mt-1 text-mute">You haven't joined any societies yet, discover one below. Starting your own society is a membership benefit.</p>
            <% end %>
          </div>
          <% unless can_create_society %>
            <%= link_to "Become a member", account_path(anchor: "subscription"), class: "btn btn-secondary shrink-0" %>
          <% end %>
        </div>
      <% end %>
    </section>

    <%# Discover %>
    <section aria-labelledby="discover-heading">
      <h2 id="discover-heading" class="mb-5 font-display text-2xl font-semibold text-ink sm:text-3xl">Discover societies</h2>

      <%# Search: name + location text. The old ZIP-radius search was decorative,
          no coordinates or geocoding existed; it even requested browser
          geolocation to feed a plain ILIKE that matched nothing. %>
      <%= form_with url: societies_path, method: :get, local: true, class: "mb-6 flex flex-col gap-3 md:flex-row md:items-center" do |form| %>
        <div class="relative flex-1">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-mute" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <%= form.label :search, "Search by name", class: "sr-only" %>
          <%= form.search_field :search, value: params[:search], placeholder: "Search by name...", class: input_class %>
        </div>
        <div class="relative md:w-64">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-mute" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <%= form.label :location, "City or state", class: "sr-only" %>
          <%= form.text_field :location, value: params[:location], placeholder: "City or state...", class: input_class %>
        </div>
        <div class="flex items-center gap-4">
          <%= form.submit "Search", class: "btn btn-secondary cursor-pointer min-h-12 px-7" %>
          <% if params[:search].present? || params[:location].present? %>
            <%= link_to "Clear", societies_path, class: "text-sm font-semibold text-ink hover:underline" %>
          <% end %>
        </div>
      <% end %>

      <% if @societies.any? %>
        <div class="card overflow-hidden">
          <ul class="divide-y divide-hairline">
            <% @societies.each do |society| %>
              <li>
                <%= render "societies/index_row", society: society,
                      label: (society.is_private ? "Private" : "Public") %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="card p-6">
          <h3 class="text-xl font-semibold text-ink">No societies found</h3>
          <% if params[:search].present? || params[:location].present? %>
            <p class="mt-1 text-mute">Try adjusting your search criteria to find more societies.</p>
            <%= link_to "Show all societies →", societies_path, class: "mt-4 inline-block font-semibold text-ink hover:underline" %>
          <% else %>
            <p class="mt-1 text-mute">There are no societies to discover right now.</p>
          <% end %>
        </div>
      <% end %>
    </section>

  <% else %>
    <%= render "shared/page_header",
          title: "Find <em>your society</em>".html_safe,
          lede: "From public meetups to private tastings, discover your perfect whiskey society.",
          clear_nav: true %>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-start">
      <%# What a society is. Sentences reused from the homepage ("Gather your
          society") and /membership; see the D2 hand-back for sources. %>
      <section class="panel-ink p-7 sm:p-8 md:col-span-5" aria-labelledby="what-heading">
        <h2 id="what-heading" class="font-display text-2xl font-semibold text-cream sm:text-3xl [&_em]:font-reading [&_em]:font-normal">Gather <em>your society</em></h2>
        <p class="mt-4 text-[17px] leading-relaxed text-cream/80">
          Start a private society for your friends or join a public one near you. Schedule the night, share the link, and RSVPs take care of themselves.
        </p>
        <p class="mt-4 text-sm text-cream/70">Joining a society is free &middot; Membership required to run a society</p>
        <%= link_to "Join the community", new_user_registration_path,
              class: "mt-7 inline-flex min-h-11 items-center justify-center gap-2 rounded-2xl bg-cream px-5 py-3 text-sm font-semibold text-ink transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cream focus-visible:ring-offset-2 focus-visible:ring-offset-char" %>
      </section>

      <section class="md:col-span-7" aria-labelledby="public-heading">
        <h2 id="public-heading" class="sr-only">Featured public societies</h2>
        <% if @societies.any? %>
          <div class="card overflow-hidden">
            <ul class="divide-y divide-hairline">
              <% @societies.limit(6).each do |society| %>
                <li>
                  <%= render "societies/index_row", society: society, row_class: "society-card" %>
                </li>
              <% end %>
            </ul>
          </div>
          <%= link_to "Join to see all societies →", new_user_registration_path,
                class: "mt-5 inline-block font-semibold text-ink hover:underline" %>
        <% else %>
          <div class="card p-6">
            <h3 class="text-xl font-semibold text-ink">No public societies yet</h3>
            <p class="mt-1 text-mute">Be the first to create a public whiskey society!</p>
          </div>
        <% end %>
      </section>
    </div>
  <% end %>
</div>
