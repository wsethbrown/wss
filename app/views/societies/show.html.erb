<% content_for :title, "#{@society.name} - Whiskey Share Society" %>
<%# Private societies stay veiled everywhere, link previews included. %>
<% if @society.public? %>
  <% content_for :og_description, truncate(@society.description.to_s.squish, length: 200) if @society.description.present? %>
  <% if @society.banner_image.attached? %>
    <% content_for :og_image, request.base_url + rails_blob_path(@society.banner_image) %>
  <% end %>
<% end %>

<%# The layout treats this page as full-bleed (no wrapper), so the page brings its
    own width and clears the floating nav itself. %>
<%
  my_membership = user_signed_in? ? current_user.society_memberships.find_by(society: @society) : nil
  can_manage = user_signed_in? && policy(@society).manage_members?
  role_by_user = @society.society_memberships.where(user_id: @recent_members.map(&:id)).index_by(&:user_id)
  # Same rule as SocietyMembershipsController#may_manage_target?: a society admin can only be
  # demoted or removed by the founder or a global admin. Officers never see those controls.
  can_manage_admins = user_signed_in? && (current_user.id == @society.creator_id || current_user.admin?)
  card_head = "border-b border-hairline px-6 py-4"
  row_link = "flex items-start gap-4 px-6 py-4 transition hover:bg-paper"
%>
<div class="mx-auto max-w-6xl px-4 pb-16 pt-28">
  <% if @society.banner_image.attached? %>
    <div class="mb-8 aspect-[3/1] overflow-hidden rounded-[18px] border border-hairline bg-char">
      <%= image_tag @society.banner_image, alt: "",
          class: "h-full w-full object-cover",
          style: "object-position: #{@society.banner_position || 'center center'};" %>
    </div>
  <% end %>

  <%
    title = safe_join([ @society.name, " ", render("shared/century_badge", record: @society) ])
    actions = capture do
  %>
    <% if user_signed_in? %>
      <% if my_membership %>
        <span class="chip" title="Your role in this society"><%= my_membership.admin? ? 'Society admin' : (my_membership.officer? ? 'Officer' : 'Member') %></span>
        <% if policy(@society).manage_members? %>
          <%= link_to "Activity", activity_society_path(@society), class: "btn btn-secondary" %>
        <% end %>
        <% if policy(@society).edit? %>
          <%= link_to "Edit society", edit_society_path(@society), class: "btn btn-secondary" %>
        <% end %>
      <% elsif policy(@society).join? %>
        <%= button_to "Join this society", join_society_path(@society), method: :post, class: "btn btn-primary cursor-pointer" %>
      <% elsif @society.private? %>
        <span class="chip">Invite only</span>
      <% end %>
    <% else %>
      <%= link_to "Sign in to join", auth_path, class: "btn btn-primary" %>
    <% end %>
    <%= render "favorites/button", favoritable: @society %>
  <% end %>
  <%= render "shared/page_header", title: title, lede: @society.description.presence, actions: actions %>

  <p class="-mt-4 mb-8 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-mute sm:-mt-6">
    <span><%= @society.private? ? 'Private society' : 'Public society' %><%= " · #{@society.location}" if @society.location.present? %></span>
    <span class="tabular-nums"><%= pluralize(@society.member_count, 'member') %></span>
    <span class="tabular-nums"><%= pluralize(@society.events.count, 'event') %></span>
    <span>Founded by <%= link_to @society.creator.full_name, profile_path(@society.creator), class: "font-semibold text-ink hover:underline" %>,
      <%= @society.created_at.strftime("%B %Y") %></span>
  </p>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="space-y-8 lg:col-span-2">
      <!-- Upcoming events -->
      <section class="card overflow-hidden">
        <div class="<%= card_head %> flex items-center justify-between gap-3">
          <h2 class="text-xl font-semibold text-ink">Upcoming events</h2>
          <% if my_membership&.admin? || my_membership&.officer? %>
            <%= link_to "Create new event", new_society_event_path(@society), class: "btn btn-primary" %>
          <% end %>
        </div>
        <% if @upcoming_events.any? %>
          <div class="divide-y divide-hairline">
            <% @upcoming_events.each do |event| %>
              <%= link_to society_event_path(@society, event), class: row_link do %>
                <div class="min-w-0 flex-1">
                  <h3 class="font-semibold text-ink"><%= event.title %></h3>
                  <% if event.description.present? %>
                    <p class="mt-1 text-sm text-mute"><%= truncate(event.description, length: 100) %></p>
                  <% end %>
                  <p class="mt-1 text-sm text-mute">
                    <span class="tabular-nums"><%= event.start_time.strftime("%B %d, %Y at %I:%M %p") %></span>
                    <% if event.location.present? %> · <%= event.location %><% end %>
                  </p>
                </div>
                <span class="mt-0.5 font-bold text-ink" aria-hidden="true">→</span>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="px-6 py-8">
            <h3 class="font-semibold text-ink">No upcoming events</h3>
            <p class="mt-1 text-mute">Check back later for new events.</p>
          </div>
        <% end %>
      </section>

      <!-- Past events -->
      <% if @past_events.any? %>
        <section class="card overflow-hidden">
          <div class="<%= card_head %>"><h2 class="text-xl font-semibold text-ink">Past events</h2></div>
          <div class="divide-y divide-hairline">
            <% @past_events.each do |event| %>
              <%= link_to society_event_path(@society, event), class: row_link do %>
                <div class="min-w-0 flex-1">
                  <h3 class="font-semibold text-ink"><%= event.title %></h3>
                  <% if event.description.present? %>
                    <p class="mt-1 text-sm text-mute"><%= truncate(event.description, length: 100) %></p>
                  <% end %>
                  <p class="mt-1 text-sm text-mute">
                    <span class="tabular-nums"><%= event.start_time.strftime("%B %d, %Y at %I:%M %p") %></span>
                    <% if event.location.present? %> · <%= event.location %><% end %>
                  </p>
                </div>
                <span class="mt-0.5 font-bold text-ink" aria-hidden="true">→</span>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @review_board.any? %>
        <!-- The review board -->
        <section class="card overflow-hidden">
          <div class="<%= card_head %>">
            <h2 class="text-xl font-semibold text-ink">The review board</h2>
            <p class="mt-1 text-sm text-mute">Every bottle poured at our events, ranked by the room.</p>
          </div>
          <div class="divide-y divide-hairline">
            <% @review_board.each do |bottle| %>
              <div class="px-6 py-4">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <%= link_to bottle.display_name, bottle_path(bottle), class: "font-semibold text-ink hover:underline" %>
                  <span class="flex items-center gap-2 whitespace-nowrap text-sm text-mute">
                    <span class="font-semibold tabular-nums text-ink"><%= number_with_precision(bottle.board_avg, precision: 2, strip_insignificant_zeros: true) %></span>
                    <span class="text-mark"><%= render "bottles/rating", value: bottle.board_avg.to_f %></span>
                    <%= pluralize(bottle.board_reviewers, "reviewer") %>
                  </span>
                </div>
                <% member_reviews = @board_reviews[bottle.id] || [] %>
                <% if member_reviews.any? %>
                  <details class="mt-2">
                    <summary class="cursor-pointer text-sm font-semibold text-ink">Member reviews</summary>
                    <div class="inset mt-2 divide-y divide-hairline">
                      <% member_reviews.each do |review| %>
                        <div class="py-3">
                          <div class="flex flex-wrap items-baseline justify-between gap-2">
                            <span class="text-sm font-semibold text-ink"><%= review.user.first_name %> <%= review.user.last_name %> <%= render "shared/century_badge", record: review.user %></span>
                            <span class="text-mark"><%= render "bottles/rating", value: review.rating.to_f %></span>
                          </div>
                          <% if review.notes.present? %><p class="mt-1 text-sm text-mute"><%= review.notes %></p><% end %>
                        </div>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <!-- About -->
      <section class="card overflow-hidden">
        <div class="<%= card_head %>"><h2 class="text-xl font-semibold text-ink">About this society</h2></div>
        <div class="p-6">
          <%# The long-form story; older societies without one fall back to
              the short blurb so the section never goes blank. %>
          <% if @society.about.present? %>
            <div class="leading-relaxed text-gray-900"><%= simple_format(@society.about) %></div>
          <% elsif @society.description.present? %>
            <p class="leading-relaxed text-gray-900"><%= @society.description %></p>
          <% else %>
            <p class="text-mute">No description provided.</p>
          <% end %>
        </div>
      </section>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <%# Next tasting, the page's one solid object. %>
      <% next_event = @society.upcoming_events.first %>
      <section class="panel-ink p-6">
        <h2 class="text-xl font-semibold">Next tasting</h2>
        <% if next_event %>
          <p class="mt-3 text-lg font-semibold leading-snug"><%= next_event.title %></p>
          <p class="mt-2 text-sm text-cream/75">
            <%= next_event.start_time.strftime("%A, %B %-d at %-l:%M %p") %>
            <% if next_event.location.present? %>
              <span class="mt-0.5 block"><%= next_event.location %></span>
            <% end %>
          </p>
          <%= link_to 'View & RSVP', society_event_path(@society, next_event),
              class: 'btn mt-5 w-full bg-white text-ink hover:bg-whiskey-100' %>
        <% else %>
          <p class="mt-3 text-sm text-cream/75">Nothing on the calendar yet.</p>
          <% if user_signed_in? && @society.can_manage?(current_user) %>
            <%= link_to 'Schedule a tasting', new_society_event_path(@society),
                class: 'btn mt-4 w-full bg-white text-ink hover:bg-whiskey-100' %>
          <% end %>
        <% end %>
      </section>

      <!-- Members -->
      <section class="card overflow-hidden">
        <div class="<%= card_head %>"><h2 class="text-xl font-semibold text-ink">Members</h2></div>
        <div class="p-6">
          <% if @recent_members.any? %>
            <div class="space-y-3">
              <% @recent_members.each do |member| %>
                <% row_membership = role_by_user[member.id] %>
                <div>
                  <%= link_to profile_path(member), class: "-m-2 flex items-center gap-3 rounded-2xl p-2 transition hover:bg-paper" do %>
                    <%= avatar(member, size: 36) %>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-sm font-semibold text-ink"><%= member.full_name %></p>
                      <% if row_membership %>
                        <p class="text-xs capitalize text-mute"><%= row_membership.role %></p>
                      <% end %>
                    </div>
                  <% end %>
                  <%# Manager controls: promote/demote and remove (never the founder, and never a
                      society admin unless the viewer is the founder or a global admin). %>
                  <% if can_manage && row_membership && member.id != @society.creator_id && (!row_membership.admin? || can_manage_admins) %>
                    <div class="mt-3 flex items-center gap-4 pl-12 text-xs" data-role="member-controls">
                      <% if row_membership.role == 'member' %>
                        <%= button_to 'Make officer', society_membership_path(row_membership, role: 'officer'), method: :patch,
                            class: 'cursor-pointer font-semibold text-ink hover:underline' %>
                      <% elsif row_membership.role == 'officer' %>
                        <%= button_to 'Remove officer role', society_membership_path(row_membership, role: 'member'), method: :patch,
                            class: 'cursor-pointer font-semibold text-ink hover:underline' %>
                      <% end %>
                      <%= button_to 'Remove', society_membership_path(row_membership), method: :delete,
                          data: { turbo_confirm: "Remove #{member.full_name} from #{@society.name}?" },
                          class: 'cursor-pointer font-semibold text-red-700 hover:underline' %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% if @society.member_count > @recent_members.count %>
              <p class="mt-4 border-t border-hairline pt-4 text-center text-sm text-mute tabular-nums">
                And <%= @society.member_count - @recent_members.count %> more members
              </p>
            <% end %>
          <% else %>
            <p class="text-sm text-mute">No members yet.</p>
          <% end %>
        </div>
      </section>

      <%# Invite link, managers share it; works for private societies too. %>
      <% if can_manage %>
        <section class="card overflow-hidden">
          <div class="<%= card_head %>"><h2 class="text-xl font-semibold text-ink">Invite members</h2></div>
          <div class="p-6">
            <%# Invite an existing account by email; they respond from their bell. %>
            <%= form_with url: society_invitations_path, method: :post, local: true, class: "space-y-3" do %>
              <input type="hidden" name="society_id" value="<%= @society.id %>">
              <label for="society-invite-email" class="sr-only">Email address</label>
              <input type="email" name="email" id="society-invite-email" required placeholder="member@example.com"
                     class="w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-ink/30">
              <button type="submit" class="btn btn-secondary w-full cursor-pointer">Send invitation</button>
            <% end %>
            <p class="mt-2 text-sm text-mute">They get a notification and an email, and you'll hear their answer.</p>
            <% pending = @society.society_invitations.pending.includes(:user).order(created_at: :desc) %>
            <% if pending.any? %>
              <div class="mt-4 border-t border-hairline pt-3">
                <p class="mb-2 text-sm font-medium text-ink">Awaiting reply</p>
                <div class="inset divide-y divide-hairline">
                  <% pending.each do |invitation| %>
                    <p class="py-2 text-sm text-ink"><%= invitation.user.full_name %>
                      <span class="text-xs text-mute">· invited <%= time_ago_in_words(invitation.created_at) %> ago</span></p>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="mt-5 border-t border-hairline pt-4">
              <p class="text-sm text-mute">Or share the link, anyone with it can join<%= ', it is the invite for this private society' if @society.private? %>.</p>
              <div class="relative" data-controller="clipboard">
                <div data-clipboard-target="toast"
                     class="absolute -top-8 left-1/2 hidden -translate-x-1/2 whitespace-nowrap rounded-xl bg-char px-3 py-1 text-xs font-medium text-cream shadow-lg">
                  Copied to clipboard
                </div>
                <input type="text" readonly value="<%= society_invite_url(@society.invite_token!) %>"
                       data-clipboard-target="source" data-action="click->clipboard#copy"
                       title="Click to copy" aria-label="Invite link"
                       class="mt-3 w-full cursor-pointer rounded-2xl border border-hairline bg-paper px-4 py-3 text-xs text-ink" />
              </div>
              <%= button_to 'Generate new link (revokes old)', regenerate_invite_society_path(@society), method: :post,
                  class: 'mt-3 cursor-pointer text-xs font-semibold text-ink hover:underline' %>
            </div>
          </div>
        </section>
      <% end %>

      <!-- Leave society (members only; admins cannot leave) -->
      <% if my_membership && !my_membership.admin? %>
        <section class="card p-6">
          <%= button_to "Leave society", leave_society_path(@society),
              method: :delete,
              form: { data: { turbo_confirm: "Are you sure you want to leave this society? This action cannot be undone." } },
              class: "btn w-full cursor-pointer border border-red-200 bg-red-50 text-red-700 hover:bg-red-100" %>
        </section>
      <% end %>
    </div>
  </div>
</div>
