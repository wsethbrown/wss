<%= render "shared/page_header", title: "Welcome to the society#{", #{@user.first_name}" if @user.first_name.present?}",
    lede: "Your account is set up under #{@user.email} and you're signed in now." %>

<div class="max-w-2xl">
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="card p-6">
      <h2 class="mb-2 text-lg font-semibold text-ink">Magic link</h2>
      <p class="text-sm leading-relaxed text-mute">
        Enter your email on the sign-in page and we send a one-click link. No password to remember.
      </p>
    </div>
    <div class="card p-6">
      <h2 class="mb-2 text-lg font-semibold text-ink">Google</h2>
      <p class="text-sm leading-relaxed text-mute">
        Use Continue with Google on the sign-in page with this same address.
      </p>
    </div>
  </div>

  <div class="mt-8">
    <% if @continue_path %>
      <%= link_to "Continue", @continue_path, class: "btn btn-primary px-8 py-3" %>
    <% else %>
      <%= link_to "Go to your dashboard", dashboard_path, class: "btn btn-primary px-8 py-3" %>
    <% end %>
  </div>
</div>
