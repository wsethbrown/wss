<%= render "shared/page_header", title: "Plans that grow <em>with you</em>".html_safe, back: ["Subscription", account_path(anchor: "subscription")] %>

<%# Current plan reminder %>
<div class="card mb-8 p-5">
  <% if current_user.cancel_at_period_end? %>
    <p class="text-sm text-gray-900">
      Your <strong><%= @current_plan.capitalize %></strong> plan is set to cancel on <%= current_user.subscription_ends_at.strftime('%B %d, %Y') %>.
      Reactivate your subscription by selecting a plan below.
    </p>
  <% else %>
    <p class="text-sm text-gray-900">
      You're currently on the <strong><%= @current_plan.capitalize %></strong> plan. Choose a different plan below to upgrade or downgrade.
    </p>
  <% end %>
</div>

<%# Plan cards: the whole card submits its hidden form. %>
<div class="mb-8 grid gap-5 md:grid-cols-2">
  <% @stripe_products.reject { |p| p[:id] == @current_plan }.each do |product| %>
    <% popular = product[:popular] %>
    <div class="flex h-full cursor-pointer flex-col p-7 <%= popular ? 'panel-ink' : 'card-hover' %>" onclick="document.getElementById('plan-form-<%= product[:id] %>').submit()">
      <div class="flex-grow">
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-display text-2xl font-semibold <%= popular ? 'text-cream' : 'text-ink' %>"><%= product[:name] %></h3>
          <% if popular %>
            <span class="inline-flex min-h-8 items-center rounded-xl border border-oak-edge bg-oak px-3 text-sm font-medium text-cream">Most popular</span>
          <% end %>
        </div>

        <div class="mt-4 flex flex-wrap items-baseline gap-x-2">
          <span class="font-display text-4xl font-semibold tabular-nums <%= popular ? 'text-cream' : 'text-ink' %>">$<%= sprintf('%.2f', product[:price] / 100.0) %></span>
          <span class="<%= popular ? 'text-cream/70' : 'text-mute' %>">/month</span>
          <% if product[:id] != 'monthly' %>
            <span class="text-sm <%= popular ? 'text-cream/70' : 'text-mute' %>">billed <%= product[:id] %></span>
          <% end %>
        </div>

        <% if product[:savings] %>
          <div class="mt-3 inline-flex min-h-8 items-center rounded-xl px-3 text-sm font-semibold <%= popular ? 'bg-oak text-cream' : 'bg-whiskey-100 text-ink' %>">Save <%= product[:savings] %></div>
        <% end %>

        <ul class="mt-5 space-y-2.5">
          <% product[:features].each do |feature| %>
            <li class="flex items-start gap-3 <%= popular ? 'text-cream/90' : 'text-gray-900' %>">
              <svg class="mt-1 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
              </svg>
              <span><%= feature %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="mt-8">
        <button type="button" class="btn w-full cursor-pointer <%= popular ? 'bg-cream text-ink hover:bg-white' : 'btn-primary' %>">
          Update to <%= product[:name].split(' ').first %>
        </button>
      </div>
    </div>

    <%# Hidden form for this plan %>
    <%= form_with url: subscriptions_change_plan_path, method: :post, local: true, id: "plan-form-#{product[:id]}", class: "hidden" do |f| %>
      <%= f.hidden_field :plan, value: product[:id] %>
    <% end %>
  <% end %>
</div>

<%# Info section %>
<div class="card p-6">
  <h2 class="text-xl font-semibold text-ink">Good to know</h2>
  <ul class="mt-3 divide-y divide-hairline text-sm text-mute">
    <li class="py-2.5">Plan changes take effect immediately</li>
    <li class="py-2.5">You'll be credited for any unused time when upgrading</li>
    <li class="py-2.5">Downgrading will apply at the end of your current billing period</li>
    <li class="py-2.5">All plans include 1 credit per month for presentation purchases</li>
  </ul>
</div>

<%# Cancel link %>
<% unless current_user.cancel_at_period_end? %>
  <div class="mt-8">
    <p class="mb-1 text-sm text-mute">Want to cancel instead?</p>
    <%= button_to "Cancel subscription", subscriptions_cancel_path,
        method: :post,
        class: "inline-flex min-h-11 items-center text-sm font-semibold text-red-700 underline cursor-pointer",
        form: { data: { turbo_confirm: "Are you sure you want to cancel your subscription? You'll retain access until your current billing period ends." } } %>
  </div>
<% end %>
