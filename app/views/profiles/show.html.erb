<div>
  <div>
    <!-- Header -->
    <header class="pb-8 pt-2 sm:pb-10">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex min-w-0 items-center gap-5">
          <%= avatar(@user, size: 96) %>
          <div class="min-w-0">
            <h1 class="font-display text-3xl font-semibold text-ink sm:text-5xl"><%= @user.full_name %> <%= render "shared/century_badge", record: @user %></h1>
            <p class="mt-2 text-[17px] text-mute">Member since <%= @user.created_at.strftime('%B %Y') %></p>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="chip"><%= pluralize(@visible_societies.count, "society") %></span>
              <span class="chip"><%= @user.event_rsvps.where(status: 'confirmed').count %> events attended</span>
              <span class="chip"><%= pluralize(@user.followers_count, "follower") %></span>
            </div>
          </div>
        </div>
        <% unless @user == current_user %>
          <div class="shrink-0"><%= render "favorites/button", favoritable: @user %></div>
        <% end %>
      </div>
    </header>

    <div class="grid grid-cols-1 gap-6 pb-16 lg:grid-cols-3">
      <!-- Main Content -->
      <div class="min-w-0 space-y-6 lg:col-span-2">
        <!-- About Me Section -->
        <% if @user.bio.present? %>
          <div class="card p-6">
            <h2 class="mb-4 text-xl font-semibold text-ink">About me</h2>
            <p class="whitespace-pre-wrap leading-relaxed text-gray-900"><%= @user.bio %></p>
          </div>
        <% end %>

        <!-- Tastings Section -->
        <% if @tastings.any? %>
          <div class="card p-6">
            <h2 class="mb-4 text-xl font-semibold text-ink">Tastings</h2>
            <div class="divide-y divide-hairline">
              <% @tastings.each do |review| %>
                <div class="py-3 first:pt-0 last:pb-0">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <%= link_to review.bottle.display_name, bottle_path(review.bottle), class: "font-semibold text-ink hover:underline" %>
                    <span class="flex items-center gap-2 text-sm text-mute">
                      <%= link_to "view", review_path(review), class: "font-semibold text-ink hover:underline" %>
                      <%= render "bottles/rating", value: review.rating.to_f %>
                      <%= review.created_at.strftime("%b %Y") %>
                    </span>
                  </div>
                  <%= render "reviews/event_card", review: review %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Societies Section -->
        <div class="card p-6">
          <h2 class="mb-4 text-xl font-semibold text-ink">Societies</h2>
          <% user_societies = @visible_societies %>
          <% if user_societies.any? %>
            <div class="inset divide-y divide-hairline">
              <% user_societies.each do |society| %>
                <% membership = @user.society_memberships.find_by(society: society) %>
                <div class="flex items-center justify-between gap-3 py-3">
                  <div class="min-w-0">
                    <h3 class="truncate font-semibold text-ink"><%= society.name %></h3>
                    <p class="truncate text-sm text-mute"><%= truncate(society.description, length: 50) %></p>
                  </div>
                  <% if membership&.admin? %>
                    <span class="chip shrink-0">Creator</span>
                  <% elsif membership&.officer? %>
                    <span class="chip shrink-0">Officer</span>
                  <% else %>
                    <span class="chip shrink-0">Member</span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-mute">Not a member of any societies yet.</p>
          <% end %>
        </div>

        <% if @user == current_user && @favorites.any? %>
          <div class="card p-6">
            <h2 class="mb-4 text-xl font-semibold text-ink">Favorites</h2>
            <div class="divide-y divide-hairline">
              <% @favorites.each do |favorite| %>
                <% record = favorite.favoritable %>
                <div class="flex items-center justify-between py-3 first:pt-0 last:pb-0">
                  <% if record.is_a?(User) %>
                    <%= link_to record.full_name, profile_path(record), class: "font-semibold text-ink hover:underline" %>
                  <% else %>
                    <%= link_to record.name, society_path(record), class: "font-semibold text-ink hover:underline" %>
                  <% end %>
                  <%= button_to "Remove", favorite_path(favorite), method: :delete,
                      class: "min-h-11 cursor-pointer text-sm font-semibold text-mute hover:text-red-700" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Sidebar -->
      <div class="min-w-0 space-y-6">
        <!-- Whiskey Shelf -->
        <% if @shelf_items.any? %>
          <div id="whiskey-shelf" class="card p-6">
            <h2 class="mb-2 text-xl font-semibold text-ink">Whiskey shelf</h2>
            <div class="divide-y divide-hairline">
              <% @shelf_items.each do |item| %>
                <div class="flex items-baseline justify-between gap-3 py-2.5">
                  <% if item.bottle %>
                    <%= link_to item.bottle.name, bottle_path(item.bottle),
                        class: "text-sm font-semibold text-ink underline decoration-hairline underline-offset-4 hover:decoration-ink" %>
                    <% score = @shelf_scores[item.bottle_id] %>
                    <% if score&.avg_rating %>
                      <span class="shrink-0 whitespace-nowrap text-sm text-mute">
                        <%= score.avg_rating.to_f.round(1) %> <span class="text-mark">&#9733;</span>
                        &middot; <%= pluralize(score.reviewers, "tasting") %>
                      </span>
                    <% end %>
                  <% else %>
                    <span class="text-sm text-gray-900"><%= item.custom_name %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Tags Section -->
        <% if @user.tags.any? %>
          <div class="card p-6">
            <h2 class="mb-4 text-xl font-semibold text-ink">Interests & expertise</h2>
            <div class="space-y-4">
              <% @user.tags.group_by(&:category).each do |category, tags| %>
                <div>
                  <h3 class="mb-2 text-sm font-medium capitalize text-mute"><%= category.humanize %></h3>
                  <div class="flex flex-wrap gap-2">
                    <% tags.each do |tag| %>
                      <span class="chip min-h-0 py-1 text-xs">
                        <%= tag.name %>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>