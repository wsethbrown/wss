<!DOCTYPE html>
<html lang="en">
  <head>
    <title>WSS Admin<%= ", #{content_for(:title)}" if content_for?(:title) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700&display=swap" rel="stylesheet">

    <%# The old layout linked `:app`, which doesn't exist, admin rendered unstyled. %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# The back office of the same product: paper ground, white hairline cards,
      a bottle-green sidebar. Pattern partials for every admin page live in
      app/views/admin/shared (see the comment at the top of each). %>
  <body class="bg-paper font-sans text-gray-900 antialiased">
    <a href="#admin-main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-xl focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink">Skip to content</a>

    <%# Phone and tablet: a sticky green top bar; the section links open from a
        menu (a native details element, so it works without JavaScript). %>
    <header class="sticky top-0 z-40 bg-char text-cream lg:hidden">
      <details class="group">
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 px-4 [&::-webkit-details-marker]:hidden">
          <span class="flex min-w-0 items-center gap-3">
            <%= image_tag "wss-logo-inverted.png", alt: "", class: "h-8 w-auto" %>
            <span class="truncate font-display text-base font-semibold">WSS Admin<% if (section = admin_current_section) %><span class="ml-1.5 font-normal text-cream/70">· <%= section %></span><% end %></span>
          </span>
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-oak">
            <span class="sr-only">Menu</span>
            <svg class="h-5 w-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="hidden h-5 w-5 group-open:block" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </span>
        </summary>
        <div class="max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-t border-oak-edge px-3 pb-4 pt-4">
          <%= render "admin/shared/nav" %>
          <div class="mt-4 space-y-0.5 border-t border-oak-edge pt-3">
            <%= render "admin/shared/account_links" %>
          </div>
        </div>
      </details>
    </header>

    <%# Desktop: fixed sidebar, out of flow. main clears it with lg:ml-60 only;
        never flex-1 on main (it would take full width and overflow by 240px). %>
    <aside class="fixed inset-y-0 left-0 z-40 hidden w-60 flex-col bg-char text-cream lg:flex">
      <%= link_to admin_root_path, class: "flex items-center gap-3 border-b border-oak-edge px-5 py-4" do %>
        <%= image_tag "wss-logo-inverted.png", alt: "", class: "h-9 w-auto" %>
        <span>
          <span class="block font-display text-lg font-semibold leading-tight text-cream">WSS Admin</span>
          <span class="block text-xs text-cream/60">Back of house</span>
        </span>
      <% end %>

      <div class="flex-1 overflow-y-auto px-3 py-5">
        <%= render "admin/shared/nav" %>
      </div>

      <div class="space-y-0.5 border-t border-oak-edge p-3">
        <%= render "admin/shared/account_links" %>
      </div>
    </aside>

    <main id="admin-main" class="min-w-0 px-4 py-6 sm:px-6 lg:ml-60 lg:px-10 lg:py-10">
      <div class="mx-auto max-w-7xl">
        <%= render "shared/admin_breadcrumbs" %>

        <% if notice %>
          <div class="mb-6 flex items-start justify-between gap-4 rounded-2xl bg-whiskey-100 px-5 py-4" data-controller="flash" role="status">
            <p class="text-sm font-medium text-ink"><%= notice %></p>
            <button type="button" data-action="click->flash#dismiss" class="-m-2 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-ink/70 hover:text-ink" aria-label="Dismiss">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        <% end %>

        <% if alert %>
          <div class="mb-6 flex items-start justify-between gap-4 rounded-2xl bg-red-50 px-5 py-4" data-controller="flash" role="alert">
            <p class="text-sm font-medium text-red-700"><%= alert %></p>
            <button type="button" data-action="click->flash#dismiss" class="-m-2 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-red-700/70 hover:text-red-700" aria-label="Dismiss">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
