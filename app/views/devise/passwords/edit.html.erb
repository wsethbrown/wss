<div class="min-h-screen bg-paper flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <!-- Header -->
    <div class="text-center">
      <h2 class="text-3xl font-semibold text-ink font-display mb-2">Set New Password</h2>
      <p class="text-mute">Enter your new password to complete the reset</p>
    </div>

    <!-- Form -->
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), 
        html: { method: :put, class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <!-- New Password Field -->
      <div>
        <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-900 mb-1.5" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
            class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 placeholder:text-mute focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/30",
            placeholder: "Enter your new password" %>
        <% if @minimum_password_length %>
          <p class="mt-1 text-xs text-mute">Minimum <%= @minimum_password_length %> characters</p>
        <% end %>
      </div>

      <!-- Confirm Password Field -->
      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-900 mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 placeholder:text-mute focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/30",
            placeholder: "Confirm your new password" %>
      </div>

      <!-- Submit Button -->
      <div>
        <%= f.submit "Update password",
            class: "btn btn-primary w-full min-h-12 cursor-pointer" %>
      </div>
    <% end %>

    <!-- Back to Sign In Link -->
    <div class="text-center">
      <p class="text-sm text-mute">
        Remember your password?
        <%= link_to "Back to sign in", auth_path,
            class: "font-medium text-ink hover:underline" %>
      </p>
    </div>
  </div>
</div>
