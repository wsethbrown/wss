<div class="min-h-screen bg-paper flex items-center justify-center pt-24 pb-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="card p-7 sm:p-8 space-y-8">
    <!-- Header -->
    <div class="text-center">
      <h2 class="text-3xl font-semibold text-ink font-display mb-2">Welcome back</h2>
      <p class="text-mute">Sign in to your Whiskey Share Society account</p>
    </div>

    <!-- OAuth Buttons -->
    <div class="space-y-4">
      <!-- Google Sign In -->
      <%= link_to user_google_oauth2_omniauth_authorize_path, method: :post,
          class: "btn btn-secondary w-full min-h-12" do %>
        <svg class="w-5 h-5 mr-3" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span class="font-medium">Continue with Google</span>
      <% end %>

      <!-- Apple Sign In - Temporarily disabled due to private key configuration -->
      <%# Apple OAuth disabled until private key format is resolved %>
      <%#= link_to user_apple_omniauth_authorize_path, method: :post,
          class: "btn w-full min-h-12 bg-ink text-white hover:bg-whiskey-700" do %>
        <%# <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        <span class="font-medium">Continue with Apple</span> %>
      <%# end %>
    </div>

    <!-- Divider -->
    <div class="relative">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-hairline"></div>
      </div>
      <div class="relative flex justify-center text-sm">
        <span class="px-2 bg-white text-mute">or</span>
      </div>
    </div>

    <!-- Sign In Form -->
    <%= form_for(resource, as: resource_name, url: session_path(resource_name),
        html: { class: "space-y-6" }) do |f| %>

      <!-- Email Field -->
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-900 mb-1.5" %>
        <%= f.email_field :email, autocomplete: "email",
            class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 placeholder:text-mute focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/30",
            placeholder: "Enter your email" %>
      </div>

      <!-- Password Field -->
      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-900 mb-1.5" %>
        <%= f.password_field :password, autocomplete: "current-password",
            class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 placeholder:text-mute focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/30",
            placeholder: "Enter your password" %>
      </div>

      <!-- Remember Me -->
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "h-4 w-4 text-ink focus:ring-ink border-hairline rounded" %>
          <%= f.label :remember_me, class: "ml-2 block text-sm text-gray-900" %>
        </div>

        <%= link_to "Forgot password?", new_password_path(resource_name),
            class: "text-sm font-medium text-ink hover:underline" %>
      </div>

      <!-- Submit Button -->
      <div>
        <%= f.submit "Sign in",
            class: "btn btn-primary w-full min-h-12 cursor-pointer" %>
      </div>
    <% end %>

    <!-- Magic Link Option -->
    <div class="text-center">
      <p class="text-sm text-mute">
        Don't have a password?
        <%= link_to "Sign in with magic link", new_password_path(resource_name),
            class: "font-medium text-ink hover:underline" %>
      </p>
    </div>

    <!-- Sign Up Link -->
    <div class="text-center">
      <p class="text-sm text-mute">
        Don't have an account?
        <%= link_to "Sign up", new_registration_path(resource_name),
            class: "font-medium text-ink hover:underline" %>
      </p>
    </div>
    </div>
  </div>
</div>
