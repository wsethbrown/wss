<%= render "shared/page_header", title: "Edit #{resource_name.to_s.humanize.downcase}", back: ["Back", account_path] %>

<div class="card max-w-xl p-7 sm:p-8">
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%# The email changes only through the account page (B8), so it is shown, not edited. %>
    <div>
      <p class="mb-1.5 block text-sm font-medium text-gray-900">Email</p>
      <p class="rounded-2xl border border-hairline bg-paper px-4 py-3 text-base text-gray-900"><%= resource.email %></p>
      <p class="mt-1.5 text-sm text-mute">To change your email address, use the Email address section of your <%= link_to "account page", account_path(anchor: "account-details"), class: "font-medium text-ink underline" %>.</p>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="text-sm text-mute">Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
    <% end %>

    <div>
      <%= f.label :password, class: "mb-1.5 block text-sm font-medium text-gray-900" %>
      <span class="text-sm text-mute">(leave blank if you don't want to change it)</span>
      <%= f.password_field :password, autocomplete: "new-password", class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/30 mt-1.5" %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-sm text-mute"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "mb-1.5 block text-sm font-medium text-gray-900" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/30" %>
    </div>

    <div>
      <%= f.label :current_password, class: "mb-1.5 block text-sm font-medium text-gray-900" %>
      <span class="text-sm text-mute">(we need your current password to confirm your changes)</span>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "block w-full rounded-2xl border border-hairline bg-white px-4 py-3 text-base text-gray-900 focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/30 mt-1.5" %>
    </div>

    <div>
      <%= f.submit "Update", class: "btn btn-primary cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-8 border-t border-hairline pt-6">
    <h3 class="text-xl font-semibold text-ink">Cancel my account</h3>

    <div class="mt-2 text-mute">To delete your account, please <%= link_to "contact us", contact_path, class: "font-semibold text-ink underline" %>.</div>
  </div>
</div>
