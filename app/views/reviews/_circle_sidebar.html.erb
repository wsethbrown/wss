<%# Locals: circle_reviews, in_circle (does the owner follow anyone?).
    Who exactly is followed lives on Account → Followed, not here. %>
<div class="card p-6">
  <h2 class="mb-4 text-xl font-semibold text-ink">Circle</h2>
  <% if circle_reviews.any? %>
    <div class="space-y-3"><%= render partial: "reviews/circle_row", collection: circle_reviews, as: :review %></div>
    <%= link_to "See all →", reviews_path(feed: "circle"), class: "mt-4 block text-sm font-semibold text-ink hover:underline" %>
  <% elsif in_circle %>
    <p class="text-sm text-mute">No pours from your circle yet, their next tastings will land here.</p>
    <%= link_to "Manage who you follow", account_path(anchor: "followed"), class: "mt-2 inline-block text-sm font-semibold text-ink hover:underline" %>
  <% else %>
    <p class="text-sm text-mute">Favorite a society or a fellow taster to see their pours here.</p>
    <%= link_to "Browse societies", societies_path, class: "mt-2 inline-block text-sm font-semibold text-ink hover:underline" %>
  <% end %>
</div>
