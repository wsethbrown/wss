<%# One tasting night: the society as the author, the event as the story,
    the pours with the room's scores as the substance. Society and event
    are separate links (the card is a div, not one big anchor).
    locals: event, pours (hash of bottle => that night's reviews) %>
<article class="card min-w-0 p-6">
  <p class="text-sm font-medium text-mute">
    <%= link_to event.society.name, society_path(event.society), class: "hover:text-ink" %>
    <%= render "shared/century_badge", record: event.society %>
  </p>
  <div class="mt-1 flex items-start justify-between gap-3">
    <%= link_to event.title, society_event_path(event.society, event), class: "min-w-0 text-lg font-semibold text-ink [overflow-wrap:anywhere] hover:underline" %>
    <span class="flex-none text-sm text-mute"><%= event.start_time.strftime("%B %-d, %Y") %></span>
  </div>

  <div class="inset mt-4 divide-y divide-hairline">
    <% pours.sort_by { |_bottle, reviews| -reviews.sum(&:rating) / reviews.size } .each do |bottle, reviews| %>
      <% mean = (reviews.sum(&:rating) / reviews.size).to_f.round(2) %>
      <div class="flex items-start justify-between gap-3 py-2.5">
        <%= link_to bottle.display_name, bottle_path(bottle), class: "min-w-0 font-semibold text-ink [overflow-wrap:anywhere] hover:underline" %>
        <span class="flex flex-none items-center gap-2 text-sm text-mute">
          <%= render "shared/score", value: mean %>
          <%= pluralize(reviews.map(&:user_id).uniq.size, "taster") %>
        </span>
      </div>
    <% end %>
  </div>

  <%= link_to "See the night →", society_event_path(event.society, event), class: "mt-4 inline-block text-sm font-semibold text-ink hover:underline" %>
</article>
