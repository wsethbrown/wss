<%= link_to review_path(review), class: "card-hover group flex min-w-0 flex-col p-6", data: { appear_target: "item" } do %>
  <div class="flex items-start justify-between gap-3">
    <span class="min-w-0 text-lg font-semibold text-ink [overflow-wrap:anywhere]"><%= review.bottle.display_name %></span>
    <span class="flex-none"><%= render "shared/score", value: review.rating.to_f %></span>
  </div>
  <% if review.notes.present? %>
    <p class="mt-3 line-clamp-4 text-gray-700"><%= review.notes %></p>
  <% elsif (peek = { "Nose" => review.nose, "Palate" => review.palate, "Finish" => review.finish }.compact_blank).any? %>
    <p class="mt-3 line-clamp-4 text-gray-700"><%= peek.map { |l, t| "#{l}: #{t}" }.join(" · ") %></p>
  <% end %>
  <%= render "reviews/event_line", review: review %>
  <div class="mt-auto flex flex-wrap items-center justify-between gap-x-3 pt-4">
    <span class="text-sm text-mute">
      <% if review.respond_to?(:recent_votes_count) %><svg class="mr-0.5 inline h-4 w-4 align-text-bottom" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 11v9m0-9l3.4-6.8A1.8 1.8 0 0 1 12 3.4c1 .3 1.5 1.2 1.3 2.2L12.6 9H18a2 2 0 0 1 2 2c0 .3 0 .5-.1.8l-1.8 6a2 2 0 0 1-1.9 1.4H9.5c-.5 0-1-.1-1.4-.3L7 18.4M7 11H4v9h3"></path></svg><%= review.recent_votes_count %> this month · <% end %><%= review.user.first_name %> <%= render "shared/century_badge", record: review.user %> · <%= time_ago_in_words(review.created_at) %> ago
    </span>
    <span class="text-sm font-semibold text-ink">Read the tasting <span class="arrow">→</span></span>
  </div>
<% end %>
