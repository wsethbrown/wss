<%# locals: review
    Where this tasting happened. Public society → a clickable event card
    (title, date, society, pour count), linking out to the event page.
    Private society → the SAME card shape (title + date) but UNLINKED, with
    no society name/link anywhere, the society line reads "A private
    society" instead. Solo → nothing. The rule is society.public?, NOT a
    per-viewer policy, private context is veiled for everyone, members and
    authors included (owner directive, 2026-07-07). %>
<% if review.event %>
  <% event = review.event %>
  <% if event.society.public? %>
    <%= link_to society_event_path(event.society, event),
        class: "mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-[18px] bg-paper px-4 py-2.5 text-sm transition hover:bg-whiskey-100" do %>
      <span class="font-semibold text-ink"><%= event.title %></span>
      <span class="text-mute"><%= event.start_time.strftime("%B %-d, %Y") %></span>
      <span class="text-mute"><%= event.society.name %></span>
      <span class="text-mute"><%= pluralize(event.event_bottles.size, "pour") %></span>
      <% if event.presentation %>
        <%# The deck is public catalog info, so it shows for private societies
            too — the veil hides WHO gathered, not which deck was run. %>
        <span class="text-ink">Ran <%= event.presentation.title %></span>
      <% end %>
    <% end %>
  <% else %>
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-[18px] bg-paper px-4 py-2.5 text-sm">
      <span class="font-semibold text-ink"><%= event.title %></span>
      <span class="text-mute"><%= event.start_time.strftime("%B %-d, %Y") %></span>
      <span class="text-mute">A private society</span>
      <% if event.presentation %>
        <span class="text-ink">Ran <%= event.presentation.title %></span>
      <% end %>
    </div>
  <% end %>
<% end %>
