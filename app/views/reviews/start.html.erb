<% content_for :title, "Add a review - Whiskey Share Society" %>

<div class="max-w-2xl">
  <%= render "shared/page_header", title: "What did you taste?",
      lede: "Find the bottle and go straight to your review, or add it to the record if we don't have it yet.",
      back: ["The tasting record", reviews_path] %>

  <div class="card p-6">
    <div class="relative" data-controller="bottle-search" data-bottle-search-url-value="<%= search_bottles_path %>">
      <input type="search" placeholder="Start typing a bottle or distillery…" autocomplete="off" autofocus
             aria-label="Search for a bottle"
             data-bottle-search-target="input" data-action="input->bottle-search#query"
             class="w-full rounded-2xl border border-hairline bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-ink/30">
      <div data-bottle-search-target="results"
           class="absolute inset-x-0 top-full z-20 mt-1 hidden overflow-hidden rounded-2xl border border-hairline bg-white shadow-lg"></div>
    </div>

    <p class="mt-5 text-sm text-mute">
      Picking a bottle opens your review. Ratings run half a star to five;
      the tasting fields, nose, palate, finish, body, are optional.
    </p>
  </div>
</div>
