<%# Plan cards, founding offer and free-vs-member comparison, used by /membership.
    Needs @stripe_products. The popular plan is the page's one .panel-ink.
    DOM contract pinned by test/integration/home_subscription_cards_test.rb:
    #plan-cards, one h3 per plan, a "/mo" span, a "Get started" action per plan. %>
<section id="pricing" class="scroll-mt-28">
  <h2 class="font-display text-2xl font-semibold text-ink sm:text-3xl">Choose your pour.</h2>
  <p class="mt-3 max-w-2xl text-[17px] text-mute">
    One membership, three ways to pay it. Every plan unlocks the same
    thing, a deck credit every month and a society of your own.
    Stay longer, pay less.
  </p>

  <div id="plan-cards" class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
    <% @stripe_products.each do |product| %>
      <% popular = product[:popular] %>
      <div class="flex flex-col p-7 <%= popular ? 'panel-ink' : 'card' %>">
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-display text-xl font-semibold <%= popular ? 'text-cream' : 'text-ink' %>"><%= product[:name].gsub(' Membership', '') %></h3>
          <% if popular %>
            <span class="inline-flex min-h-8 items-center rounded-xl border border-oak-edge bg-oak px-3 text-sm font-medium text-cream">Best value</span>
          <% end %>
        </div>
        <p class="mt-1 text-sm <%= popular ? 'text-cream/70' : 'text-mute' %>"><%=
          case product[:id]
          when 'monthly' then 'Pay as you go, cancel anytime'
          when 'quarterly' then 'Billed every three months'
          when 'yearly' then 'Billed once a year'
          else 'For committed members'
          end
        %></p>

        <div class="mt-6">
          <div class="flex items-end">
            <span class="font-display text-5xl font-semibold tabular-nums <%= popular ? 'text-cream' : 'text-ink' %>">$<%= sprintf('%.2f', product[:price] / 100.0) %></span>
            <span class="ml-1 pb-1.5 text-lg <%= popular ? 'text-cream/60' : 'text-mute' %>">/mo</span>
          </div>
          <%# Every card carries the billing line so the middles stay parallel. %>
          <div class="mt-1 text-sm <%= popular ? 'text-cream/70' : 'text-mute' %>">
            billed <%= { 'monthly' => 'monthly', 'quarterly' => 'quarterly', 'yearly' => 'annually' }.fetch(product[:id], 'monthly') %>
          </div>
          <% if product[:savings] %>
            <div class="mt-3 inline-flex min-h-8 items-center rounded-xl px-3 text-sm font-semibold <%= popular ? 'bg-oak text-cream' : 'bg-whiskey-100 text-ink' %>">Save <%= product[:savings] %></div>
          <% end %>
        </div>

        <%# mt-auto pins every card's CTA to the same baseline. %>
        <div class="mt-auto pt-8">
          <% if user_signed_in? && current_user.subscription_active? %>
            <%# Members don't need three checkout buttons. Mark their plan;
                changes happen from the account page. %>
            <% if current_user.subscription_plan == product[:id] %>
              <div class="w-full rounded-2xl border px-5 py-3 text-center text-sm font-semibold <%= popular ? 'border-oak-edge bg-oak text-cream' : 'border-hairline bg-paper text-ink' %>">
                Your current plan
              </div>
            <% else %>
              <%= link_to 'Manage in your account', account_path(anchor: 'subscription'),
                  class: "btn w-full #{popular ? 'bg-cream text-ink hover:bg-white' : 'btn-secondary'}" %>
            <% end %>
          <% elsif user_signed_in? %>
            <%= form_with url: subscriptions_checkout_path, method: :post, local: true, data: { turbo: false } do |f| %>
              <%= f.hidden_field :price_id, value: product[:id] %>
              <%= f.submit "Get started", class: "btn w-full cursor-pointer #{popular ? 'bg-cream text-ink hover:bg-white' : 'btn-primary'}" %>
            <% end %>
          <% else %>
            <%= link_to 'Get started', auth_path,
                class: "btn w-full #{popular ? 'bg-cream text-ink hover:bg-white' : 'btn-primary'}" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Founding Members: shown only while slots remain, and only to accounts
      that can still take the offer. Separate from #plan-cards on purpose;
      that DOM contract is pinned by tests. %>
  <% founding_slots = User.founding_slots_remaining %>
  <% if founding_slots.positive? && (!user_signed_in? || current_user.founding_eligible?) %>
    <% founding = SubscriptionProducts.founding %>
    <div id="founding-offer" class="card mt-8 p-7 sm:p-9">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h3 class="font-display text-2xl font-semibold text-ink">Founding members: the first fifty</h3>
          <p class="mt-2 max-w-2xl text-mute">
            Fifty founding spots, then these offers are gone. Keep your founding rate for as long as
            your membership stays active.
          </p>
        </div>
        <p class="shrink-0 text-sm font-semibold tabular-nums text-ink"><%= founding_slots %> of <%= User::FOUNDING_MEMBER_CAP %> founding spots left</p>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <% founding.each do |offer| %>
          <div class="flex flex-col rounded-[18px] bg-paper p-6">
            <h4 class="font-display text-lg font-semibold text-ink"><%= offer[:name] %></h4>
            <p class="mt-1 font-display text-3xl font-semibold tabular-nums text-ink">
              $<%= number_with_precision(offer[:price] / 100.0, precision: 2) %><span class="text-base font-normal text-mute">/mo</span>
            </p>
            <p class="mt-3 text-sm leading-relaxed text-mute">
              <% if offer[:id] == "founding_society" %>
                Create and run your own society: events, RSVPs, invites, members. No monthly deck credit; buy any deck outright whenever you like.
              <% else %>
                The full membership at $5 off, the same rate as the yearly plan, billed monthly. One deck credit every month.
              <% end %>
            </p>
            <div class="mt-auto pt-5">
              <% if user_signed_in? %>
                <%= form_with url: subscriptions_checkout_path, method: :post, local: true, data: { turbo: false } do |f| %>
                  <%= f.hidden_field :price_id, value: offer[:id] %>
                  <%= f.submit "Claim a founding spot", class: "btn btn-primary w-full cursor-pointer" %>
                <% end %>
              <% else %>
                <%= link_to "Sign in to claim a spot", auth_path, class: "btn btn-primary w-full" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Free vs paid, side by side: the review section and joining societies
      are free (that's the everyday reason to have an account); membership
      adds deck credits and the ability to run your own society. %>
  <div class="mt-8 grid gap-5 md:grid-cols-2">
    <div class="card p-7">
      <p class="text-sm font-medium text-mute">Free with any account</p>
      <h3 class="mt-1 font-display text-xl font-semibold text-ink">No membership needed</h3>
      <ul class="mt-4 divide-y divide-hairline">
        <% Membership::FREE.each do |item| %>
          <li class="flex items-start gap-3 py-3 text-gray-900">
            <svg class="mt-1 h-4 w-4 shrink-0 text-mute" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span><%= item %></span>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="card p-7">
      <p class="text-sm font-medium text-mute">Membership adds</p>
      <h3 class="mt-1 font-display text-xl font-semibold text-ink">Everything above, plus</h3>
      <ul class="mt-4 divide-y divide-hairline">
        <% Membership::BENEFITS.each do |benefit| %>
          <li class="flex items-start gap-3 py-3 text-gray-900">
            <svg class="mt-1 h-4 w-4 shrink-0 text-ink" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span><%= benefit %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <p class="mt-8 text-sm text-mute">
    Credits unlock any deck while your membership is active. Decks bought outright are yours for good.
  </p>
</section>
