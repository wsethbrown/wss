<%# "Tell me when a new deck is published": the email sign-up for a visitor
    who is not ready to buy (DeckNewsController#create, double opt-in through
    MailingList::SignupService). One white card, label above the input, and a
    SECONDARY button: the pages it sits on already have their primary action.
    Locals:
      source (String, required) which page the form is on: "library" or "deck"
    Rendered on presentations/index and, for visitors who do not own the deck,
    presentations/show. Render it at most once per page (fixed ids). A
    signed-in visitor's address is prefilled. Never call this a subscription
    in copy: that word means paid membership here. %>
<section id="deck-news" class="card p-5 sm:p-6" aria-labelledby="deck-news-heading">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
    <div class="min-w-0">
      <h2 id="deck-news-heading" class="text-xl font-semibold text-ink">Hear about new decks</h2>
      <p class="mt-1 text-mute">Leave your email and we will write when a new deck is published.</p>
    </div>
    <%= form_with url: deck_news_path, method: :post, id: "deck-news-form", class: "w-full min-w-0 lg:max-w-md" do %>
      <%= hidden_field_tag :source, source, id: nil %>
      <label for="deck-news-email" class="text-sm font-medium text-ink">Email address</label>
      <div class="mt-1.5 flex flex-col gap-3 sm:flex-row">
        <%= email_field_tag :email, (current_user&.email if user_signed_in?), id: "deck-news-email", required: true,
              autocomplete: "email", maxlength: 254,
              class: "min-h-12 w-full min-w-0 flex-1 rounded-2xl border border-hairline bg-white px-4 py-3 text-gray-900 focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/30" %>
        <%= button_tag "Tell me", type: "submit", class: "btn btn-secondary min-h-12 shrink-0 cursor-pointer" %>
      </div>
      <% if (widget = turnstile_widget) %>
        <div class="mt-3"><%= widget %></div>
      <% end %>
    <% end %>
  </div>
</section>
