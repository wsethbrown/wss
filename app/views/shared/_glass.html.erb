<%# The glass: a flat, line-drawn tasting glass taken from the logo, with an
    orange level. It is the site's numeral for a pour and its gauge for a real
    quantity (a score out of 5, an RSVP). The one drawing in the app: do not
    redraw it elsewhere (owner-approved spec, G1).

    locals:
      level:   0..1, how full. Below 0.02 the glass is drawn empty.
      size:    rendered height in px (default 32, never below 28); width is 3/4.
      tone:    :ink on paper and white cards (default), :cream on green.
      numeral: optional text set in the bowl (the order a pour was served).
               Only drawn at size 64 or larger; below that it is ignored, so
               callers pass it only for large glasses and keep the order in text.
      label:   optional sr-only text equivalent. Leave it out only when the
               same information sits beside the glass as visible text.
      css:     optional extra classes on the svg.

    The svg itself is always aria-hidden. Flat on purpose: no shading. The one
    motion is the level rising once on appearance (CSS, off under reduced motion). %>
<%
  level   = local_assigns.fetch(:level, 0).to_f.clamp(0.0, 1.0)
  size    = [ local_assigns.fetch(:size, 32).to_i, 28 ].max
  cream   = local_assigns.fetch(:tone, :ink).to_sym == :cream
  numeral = size >= 64 ? local_assigns[:numeral] : nil
  label   = local_assigns[:label]
  line    = cream ? "#f6f4ee" : "#16332a"
  @_glass_prefix ||= "gl#{SecureRandom.hex(3)}"
  @_glass_seq = @_glass_seq.to_i + 1
  clip = "#{@_glass_prefix}-#{@_glass_seq}"
  bowl = "M18.5 5 C19.5 9.5 19.7 12.5 19.2 16 C17.8 25 12 33 12 45 C12 54.5 19.5 61 30 61 C40.5 61 48 54.5 48 45 C48 33 42.2 25 40.8 16 C40.3 12.5 40.5 9.5 41.5 5 Z"
  if level >= 0.02
    y = 58.5 - level * 34
    f = ->(d) { (y + d).round(2) }
    surface = "M8 #{f.(1.2)} C18 #{f.(-2.2)} 26 #{f.(3.2)} 36 #{f.(0.6)} C42 #{f.(-1)} 48 #{f.(-1.6)} 52 #{f.(-0.6)}"
    body_d  = "#{surface} L52 70 L8 70 Z"
    crest_d = "#{surface} L52 #{f.(2.6)} C46 #{f.(2.2)} 42 #{f.(3.2)} 36 #{f.(4.4)} C26 #{f.(6.6)} 18 #{f.(1.6)} 8 #{f.(4.6)} Z"
  end
%><svg viewBox="0 0 60 80" width="<%= (size * 0.75).round(1) %>" height="<%= size %>" aria-hidden="true" focusable="false" class="<%= local_assigns[:css] %>" data-glass="<%= level.round(2) %>"><% if body_d %><defs><clipPath id="<%= clip %>"><path d="<%= bowl %>"/></clipPath></defs><g clip-path="url(#<%= clip %>)"><path d="<%= body_d %>" fill="<%= cream ? '#ff6d00' : '#e65c00' %>"/><path d="<%= crest_d %>" fill="<%= cream ? '#ff8a33' : '#f47a26' %>"/></g><% end %><path d="<%= bowl %>" fill="none" stroke="<%= line %>" stroke-width="3" stroke-linejoin="round"/><path d="M25.5 61.5 C25.8 65 22.5 66.2 21 69.2 C20.2 71 21.2 72.5 23.2 72.5 L36.8 72.5 C38.8 72.5 39.8 71 39 69.2 C37.5 66.2 34.2 65 34.5 61.5 Z" fill="<%= line %>" stroke="<%= line %>" stroke-width="2.4" stroke-linejoin="round"/><% if numeral.present? %><text x="30" y="50" text-anchor="middle" font-family="Instrument Sans, system-ui, sans-serif" font-weight="700" font-size="15" fill="<%= level > 0.45 ? '#fff' : line %>"><%= numeral %></text><% end %></svg><% if label.present? %><span class="sr-only"><%= label %></span><% end %>
