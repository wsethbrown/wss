<%# A society's picture, else its initials. Rendered inside a sized bg-char box.
    locals: society, size ('large' | 'small' | default) %>
<% text_size = case local_assigns[:size]
               when 'large' then 'text-3xl'
               when 'small' then 'text-[10px]'
               else 'text-base'
               end
   initials = society.name.to_s.split.reject { |w| w =~ /\A(the|of|and|&)\z/i }.first(2).map { |w| w[0] }.join.upcase.presence || "S" %>
<% picture = nil %>
<% if society.profile_picture.attached? && society.profile_picture.blob.present? %>
  <% begin %>
    <% content_type = society.profile_picture.blob.content_type&.downcase %>
    <% picture = if content_type&.include?("heic") || content_type&.include?("heif")
                   society.profile_picture.variant(resize_to_limit: [200, 200], format: :jpeg)
                 else
                   society.profile_picture
                 end %>
    <%= image_tag picture, alt: "", class: "w-full h-full object-cover rounded-xl" %>
  <% rescue => e %>
    <% Rails.logger.error("[society_icon] picture failed for society #{society.id}: #{e.class}: #{e.message}") %>
    <% picture = nil %>
  <% end %>
<% end %>
<% unless picture %>
  <span class="flex h-full w-full items-center justify-center font-display font-semibold text-cream <%= text_size %>" aria-hidden="true"><%= initials %></span>
<% end %>
